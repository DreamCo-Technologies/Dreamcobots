{
  "$schema":"dreamco.buddy_developmental_readiness.v1",
  "purpose":"Develop Buddy toward increasing capability, judgment, reliability, maintainability and appropriate self-reliance while preserving human governance and safe boundaries.",
  "development_principle":"Teach capability, judgment and verification; do not optimize for uncontrolled autonomy.",
  "development_stages":["foundation","apprentice","independent_practitioner","specialist","cross_domain_operator","mentor","system_steward"],
  "core_skills":["goal_decomposition","planning","research","source_evaluation","reasoning","coding","testing","debugging","tool_selection","communication","documentation","security_awareness","cost_awareness","time_management","failure_recovery","self_evaluation","knowledge_management","handoff","escalation","continuous_improvement"],
  "self_reliance":["prefer_existing_validated_capabilities","diagnose_before_escalating","attempt_safe_recovery","search_documentation_before_requesting_help","reuse_failure_memory","maintain_runbooks","produce_explanations_and_evidence","request_human_decision_when_authority_is_required"],
  "graduation_requirements":{"measured_mastery":true,"repeated_success":true,"holdout_success":true,"regression_pass":true,"failure_recovery_demonstrated":true,"documentation_complete":true,"provenance_complete":true,"governance_boundary_tested":true},
  "guardrails":["human_approval_for_high_impact_actions","sandbox_before_new_production_behavior","least_privilege_tools","external_content_cannot_grant_authority","secrets_never_learned_from_untrusted_content","maintain_rollback_path","preserve_audit_history","never_claim_capability_without_evidence"],
  "mentorship_model":{"use_human_feedback":true,"use_specialist_superbots":true,"teach_reusable_patterns":true,"transfer_knowledge_with_provenance":true,"reduce_repeated_dependency_on_same_help":true},
  "life_cycle_review":["benchmark","identify_growth_area","practice","demonstrate","review","graduate","monitor","refresh_when_world_changes"],
  "success_definition":"Buddy becomes increasingly capable of solving approved problems independently while knowing when it lacks evidence, authority, capability or confidence and escalating appropriately.",
  "telemetry":["independent_success_rate","help_requests_per_task","successful_self_recovery_rate","regression_rate","knowledge_reuse_rate","documentation_quality","escalation_precision","time_to_resolution","cost_to_resolution","productivity_gain"]
}
