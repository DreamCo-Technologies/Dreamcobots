{
  "schema": "dreamco.buddy_music_career_program.v1",
  "version": "1.0.0",
  "extends": ["website/music-creator.html", "website/creator-platforms.html", "config/buddy-personality-acting-program.json"],
  "mission": "Help a beginner or professional go from raw voice, freestyle, lyric, melody, beat idea, or visual identity to original tracks, albums, videos, release packages, performance practice, and career workflows.",
  "input_modes": [
    "live microphone recording", "uploaded vocal recording", "uploaded singing", "uploaded rap freestyle", "spoken lyric idea", "typed lyrics", "vibe description", "melody idea", "beat reference owned_or_licensed", "user image", "user video", "original synthetic artist avatar"
  ],
  "producer_workflows": [
    "listen to performance and estimate tempo/phrasing/key range when an audio-analysis adapter is connected",
    "suggest multiple original beat directions that fit the performance",
    "build an original beat around cadence, pocket, energy, and arrangement needs",
    "fit an existing owned/licensed vocal to a newly created original beat",
    "coach timing, breath, pitch, delivery, doubles, harmonies, ad-libs, and punch-ins",
    "vibe-code original lyrics from a concept",
    "preserve user-written lyrics exactly unless the user asks for rewriting",
    "suggest hooks, verses, bridges, intros, outros, pre-choruses, chants, call-and-response, and alternate versions",
    "build radio edit, explicit, clean, instrumental, performance, acoustic, remix, and social-short variants",
    "mix and master planning with stems, loudness targets, dynamics, stereo image, vocal placement, and playback checks",
    "build single, EP, mixtape, album, soundtrack, or full CD-length project plans",
    "generate track sequencing, interludes, transitions, recurring motifs, cover-art direction, credits, and rollout"
  ],
  "lyric_dimensions": [
    "storytelling", "punchlines", "wordplay", "internal rhyme", "multisyllabic rhyme", "end rhyme", "slant rhyme", "alliteration", "assonance", "consonance", "metaphor", "simile", "double entendre", "imagery", "narrative arc", "character voice", "melodic phrasing", "syncopation", "cadence", "flow switching", "call-and-response", "repetition", "hook density", "chantability", "freestyle feel", "battle style", "confessional style", "motivational style", "romantic style", "comedic style", "social commentary", "party style", "club style", "street narrative", "poetic style", "spoken word", "gospel-influenced writing", "country storytelling", "pop topline writing", "R&B melodic writing", "rock lyric writing", "dance vocal writing", "cinematic writing", "children/education writing"
  ],
  "audio_analysis_targets": [
    "tempo estimate", "beat-grid fit", "cadence density", "phrase length", "breath spacing", "pitch range", "key candidates", "melodic contour", "rhythmic pocket", "energy", "dynamic range", "delivery consistency", "timing drift", "hook candidate moments", "ad-lib spaces", "harmony opportunities", "noise/clipping warnings"
  ],
  "trend_benchmark": {
    "purpose": "Use current chart/radio market trends as a benchmark for competitiveness without reproducing songs, lyrics, melodies, recordings, or artist identity.",
    "refreshable": true,
    "allowed_metrics": [
      "tempo distribution", "song duration distribution", "intro length", "time to first hook", "section count", "hook recurrence", "energy curve", "danceability proxies", "acoustic/electronic balance", "vocal/instrumental balance", "loudness range", "genre mix", "feature/collaboration frequency", "release cadence", "short-form clip readiness", "clean-version availability", "visual-content frequency"
    ],
    "forbidden": [
      "copying chart lyrics", "copying melodies", "reconstructing a copyrighted master", "imitating a living artist's voice without rights", "presenting chart similarity as guaranteed commercial success"
    ],
    "output": ["trend scorecard", "originality score", "market-fit score", "weaknesses", "differentiation opportunities", "recommended experiments"]
  },
  "artist_identity": {
    "modes": ["user voice and image", "user voice only", "user image with original voice", "fully original synthetic artist", "band/group", "anonymous/visual brand"],
    "user_voice_requires_consent": true,
    "user_image_requires_consent": true,
    "licensed_performer_supported": true,
    "unlicensed_real_person_clone": false,
    "synthetic_identity_provenance_supported": true
  },
  "music_video": {
    "supports": ["performance video", "narrative video", "animated video", "lyric video", "visualizer", "vertical short", "live-session video", "dance/choreography video", "cinematic concept", "AI-assisted original avatar video"],
    "pipeline": ["treatment", "lookbook", "storyboard", "shot list", "performance plan", "wardrobe", "locations", "lighting", "camera", "edit map", "VFX", "color", "captions", "thumbnail", "short clips", "release plan"]
  },
  "career_system": {
    "stages": ["artist identity", "song creation", "catalog building", "visual brand", "distribution prep", "content calendar", "performance practice", "fan/community plan", "collaboration plan", "press kit", "booking kit", "sponsor kit", "analytics review", "next-release learning"],
    "release_types": ["single", "two-pack", "EP", "mixtape", "album", "CD-length project", "deluxe", "soundtrack", "live project", "compilation"]
  }
}
