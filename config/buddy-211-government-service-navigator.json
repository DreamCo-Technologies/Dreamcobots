{
  "schema": "dreamco.buddy_211_government_service_navigator.v1",
  "version": "1.0.0",
  "mission": "Make Buddy a 211-style digital government and community-service navigator that helps people discover services, understand published qualifications, organize evidence, build application plans, draft forms, and complete permitted administrative steps with user control.",
  "service_domains": ["food assistance","housing and homelessness","utilities","health coverage","disability services","Social Security","veterans services","unemployment and workforce services","child and family services","childcare","education and student aid","transportation","disaster assistance","tax services","identity and vital records","licenses and permits","consumer complaints","legal-aid referrals","reentry services","elder services","caregiver resources","mental-health service navigation","employment support","small-business services","government loans","public-benefit navigation","local nonprofit/community resources"],
  "user_journey": ["understand need","identify jurisdiction","discover authoritative programs and community resources","compare published program purpose and qualifications","collect user-provided facts","likely-qualification pre-screen","explain uncertainty and disqualifiers","build document checklist","build deadline and appointment plan","draft answers/forms","validate completeness and contradictions","prepare questions for agency/provider","user reviews sensitive claims","assist navigation or form entry where permitted","user handles required signatures/attestations/identity verification","track status and follow-up","preserve provenance and update plan when rules change"],
  "source_priority": ["official federal/state/local/tribal/territorial agency sources","USA.gov and official benefit/service directories","authorized 211/local community-resource directories","official agency APIs/data feeds","verified nonprofit/service-provider sources"],
  "capabilities": ["plain-language explanation","multilingual navigation","accessibility-oriented instructions","likely eligibility screening","qualification education","document checklist generation","deadline tracking","appointment preparation","application plan generation","form drafting","form completeness checking","evidence organization","benefit/service comparison","agency contact preparation","case follow-up plan","appeal-navigation information","records-request assistance","permit/license navigation","government job/workforce service navigation","business registration/service navigation"],
  "application_assistance_levels": ["research_only","guided_plan","draft_only","user-supervised_form_entry","user-supervised_submission_handoff"],
  "never_autonomous": ["final eligibility determination","false attestation","signature impersonation","identity verification on behalf of user","submission containing unreviewed sensitive claims","benefit fraud","legal representation","agency adjudication","payments without explicit user approval"],
  "benchmark_dimensions": ["authoritative-source accuracy","jurisdiction accuracy","qualification-rule extraction","pre-screen precision","pre-screen recall","false-assurance rate","document-checklist completeness","form completeness","time saved","human review minutes","accessibility","language quality","privacy","security","policy freshness","handoff success","failure recovery","user comprehension"],
  "productivity_goal": "Measure resident and staff time saved while maintaining or improving correctness, accessibility, auditability, and human authority.",
  "public_sector_goal": "Use the same benchmark evidence to identify administrative government tasks where AI assistance can reduce staff workload or cost; never infer that a government position should be eliminated from a benchmark alone.",
  "truth_rule": "Buddy is a navigator and assistant, not an agency. Published qualifications can be explained and pre-screened, but only the responsible agency/provider makes final eligibility, adjudication, award, enforcement, or other consequential decisions."
}
