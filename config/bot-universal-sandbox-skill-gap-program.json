{
  "schema": "dreamco.bot_universal_sandbox_skill_gap.v2",
  "version": "2.0.0",
  "mission": "Keep every canonical DreamCo bot in an active sandbox mastery campaign with explicit coverage for every declared capability, discoverable tool and callable function, plus efficiency training, model/tool routing benchmarks, competitor/open-source benchmarks, and measurable gap-closing plans.",
  "applies_to": "all canonical bots in App_bots/*.json",
  "default_execution_mode": "sandbox",
  "live_external_actions_default": false,
  "inherits": [
    "config/buddy-bootcamp-program.json",
    "config/division-strengthening-placement-program.json",
    "config/buddy-guardrails-benchmark-program.json",
    "config/shared-fleet-improvement-inheritance.json",
    "config/intelligent-task-router.json",
    "config/model-mastery-benchmark-program.json",
    "config/benchmark-mastery-distillation-policy.json"
  ],
  "required_per_bot": [
    "identity and division contract",
    "every declared capability mapped to sandbox tests",
    "runtime tool inventory or explicit no-tool declaration",
    "runtime callable-function inventory or explicit no-function declaration",
    "normal workflow tests",
    "hard/edge-case tests",
    "failure and recovery tests",
    "permissions and side-effect tests",
    "security/privacy/rights tests",
    "latency/resource/cost efficiency tests",
    "user-effort tests",
    "model/tool routing fit tests",
    "skill ladder",
    "competitor/open-source benchmark plan",
    "gap-closing plan",
    "graduation evidence"
  ],
  "capability_test_dimensions": [
    "happy_path",
    "invalid_input",
    "missing_input",
    "boundary_input",
    "ambiguous_request",
    "wrong_tool_or_route",
    "timeout_or_dependency_failure",
    "permission_denied",
    "safe_cancellation",
    "output_schema_or_quality",
    "model_route_quality",
    "efficiency",
    "regression"
  ],
  "tool_test_dimensions": [
    "tool_discovery",
    "argument_schema",
    "valid_call",
    "invalid_argument",
    "missing_permission",
    "timeout",
    "rate_limit",
    "partial_failure",
    "idempotency_when_relevant",
    "side_effect_boundary",
    "audit_receipt",
    "fallback_or_handoff"
  ],
  "function_test_dimensions": [
    "callable_exists",
    "input_contract",
    "output_contract",
    "deterministic_fixture_when_possible",
    "error_contract",
    "boundary_values",
    "concurrency_when_relevant",
    "performance_budget",
    "regression_fixture",
    "version_compatibility"
  ],
  "efficiency_dimensions": [
    "latency_p50",
    "latency_p95",
    "latency_p99",
    "task_completion_time",
    "user_steps",
    "tool_calls",
    "model_calls",
    "tokens_or_compute",
    "network_bytes",
    "memory",
    "cpu",
    "storage",
    "external_cost",
    "cache_reuse",
    "retry_overhead",
    "parallelism_efficiency"
  ],
  "skill_ladder": [
    "recruit: understands mission, inputs, outputs and guardrails",
    "fundamentals: passes core deterministic capability fixtures",
    "specialist: passes domain-specific hard cases",
    "operator: coordinates tools/functions/state/retries safely",
    "competitor: runs same-fixture comparisons and identifies gaps",
    "elite: closes important gaps while improving efficiency and user effort",
    "instructor: turns lessons into reusable shared tests/skills",
    "graduated: reproducible evidence meets release gates"
  ],
  "sandbox_states": [
    "planned",
    "fixture_ready",
    "running",
    "passing",
    "gap_found",
    "repairing",
    "blocked_dependency",
    "blocked_permission",
    "blocked_cost",
    "blocked_provider",
    "regressed",
    "mastered_current_revision"
  ],
  "gap_plan_required_fields": [
    "gap_id",
    "bot_slug",
    "division",
    "capability_or_metric",
    "baseline",
    "target",
    "competitor_or_reference",
    "evidence",
    "root_cause_hypothesis",
    "candidate_improvements",
    "shared_infrastructure_candidate",
    "owner",
    "priority",
    "effort",
    "risk",
    "test_to_close_gap",
    "status"
  ],
  "gap_priority_formula": [
    "release-blocking safety/permission failures first",
    "shared infrastructure failures affecting many bots",
    "large user-value gaps",
    "high-frequency capability gaps",
    "large competitor/open-source gaps",
    "high fleet-reuse improvements",
    "high time/cost/user-step savings",
    "low-risk quick wins",
    "then long-horizon research gaps"
  ],
  "builder_handoff": {
    "parallel": true,
    "maximum_parallel_lanes": 32,
    "same_canonical_owner_serialized": true,
    "one_gap_worker_per_open_gap": true,
    "shared_fix_first": true,
    "rules": [
      "do not patch 100 bots when one shared fix can solve the gap",
      "builder candidates must cite failing benchmark evidence",
      "run focused test before broad fleet retest",
      "preserve before/after metrics",
      "regressions become permanent fixtures",
      "do not weaken tests to declare a gap closed",
      "do not spend on live provider benchmarks until local/static evidence and shortlisting are complete",
      "close a gap worker only after its acceptance fixture passes"
    ]
  },
  "activation_policy": {
    "every_bot_has_active_sandbox_record": true,
    "only_gap_workers_execute_continuously": true,
    "passing_bots_retest_on_relevant_change": true,
    "mastered_bots_sleep_between_regression_triggers": true,
    "all_live_side_effects_disabled_in_sandbox": true,
    "paid_model_calls_disabled_by_default": true
  },
  "actions_integration": {
    "primary_suite": "All Bot Sandbox Campaign",
    "control_center": "DreamCo Control Center -> test-fleet",
    "generator": "python3 tools/build_bot_sandbox_curriculum.py",
    "campaign_runner": "python3 tools/run_all_bot_sandbox_campaign.py",
    "coverage_test": "python3 -m unittest tests.test_bot_sandbox_curriculum tests.test_all_bot_sandbox_campaign"
  },
  "truth_rule": "Every canonical bot must always have an active sandbox status record. Capability/tool/function tests count as passing only when executable local, mock, sandbox, staging, or approved runtime evidence exists. Generated planning alone never counts as a pass."
}
