{
  "schema": "dreamco.bot_universal_sandbox_skill_gap.v1",
  "version": "1.0.0",
  "mission": "Put every canonical DreamCo bot through Buddy Bootcamp with explicit coverage for every declared capability, discoverable tool and callable function, plus efficiency training, skill-building drills, competitor/open-source benchmarks, and measurable gap-closing plans.",
  "applies_to": "all canonical bots in App_bots/*.json",
  "inherits": [
    "config/buddy-bootcamp-program.json",
    "config/division-strengthening-placement-program.json",
    "config/buddy-guardrails-benchmark-program.json",
    "config/shared-fleet-improvement-inheritance.json"
  ],
  "required_per_bot": [
    "identity and division contract",
    "every declared capability mapped to sandbox tests",
    "runtime tool inventory or explicit no-tool declaration",
    "runtime callable-function inventory or explicit no-function declaration",
    "normal workflow tests",
    "hard/edge-case tests",
    "failure and recovery tests",
    "permissions and side-effect tests",
    "security/privacy/rights tests",
    "latency/resource/cost efficiency tests",
    "user-effort tests",
    "skill ladder",
    "competitor/open-source benchmark plan",
    "gap-closing plan",
    "graduation evidence"
  ],
  "capability_test_dimensions": [
    "happy_path",
    "invalid_input",
    "missing_input",
    "boundary_input",
    "ambiguous_request",
    "wrong_tool_or_route",
    "timeout_or_dependency_failure",
    "permission_denied",
    "safe_cancellation",
    "output_schema_or_quality",
    "efficiency",
    "regression"
  ],
  "tool_test_dimensions": [
    "tool_discovery",
    "argument_schema",
    "valid_call",
    "invalid_argument",
    "missing_permission",
    "timeout",
    "rate_limit",
    "partial_failure",
    "idempotency_when_relevant",
    "side_effect_boundary",
    "audit_receipt",
    "fallback_or_handoff"
  ],
  "function_test_dimensions": [
    "callable_exists",
    "input_contract",
    "output_contract",
    "deterministic_fixture_when_possible",
    "error_contract",
    "boundary_values",
    "concurrency_when_relevant",
    "performance_budget",
    "regression_fixture",
    "version_compatibility"
  ],
  "efficiency_dimensions": [
    "latency_p50",
    "latency_p95",
    "latency_p99",
    "task_completion_time",
    "user_steps",
    "tool_calls",
    "model_calls",
    "tokens_or_compute",
    "network_bytes",
    "memory",
    "cpu",
    "storage",
    "external_cost",
    "cache_reuse",
    "retry_overhead",
    "parallelism_efficiency"
  ],
  "skill_ladder": [
    "recruit: understands mission, inputs, outputs and guardrails",
    "fundamentals: passes core deterministic capability fixtures",
    "specialist: passes domain-specific hard cases",
    "operator: coordinates tools/functions/state/retries safely",
    "competitor: runs same-fixture comparisons and identifies gaps",
    "elite: closes important gaps while improving efficiency and user effort",
    "instructor: turns lessons into reusable shared tests/skills",
    "graduated: reproducible evidence meets release gates"
  ],
  "gap_plan_required_fields": [
    "gap_id",
    "bot_slug",
    "division",
    "capability_or_metric",
    "baseline",
    "target",
    "competitor_or_reference",
    "evidence",
    "root_cause_hypothesis",
    "candidate_improvements",
    "shared_infrastructure_candidate",
    "owner",
    "priority",
    "effort",
    "risk",
    "test_to_close_gap",
    "status"
  ],
  "gap_priority_formula": [
    "release_blocking safety/permission failures first",
    "large user-value gaps",
    "high-frequency capability gaps",
    "large competitor/open-source gaps",
    "high fleet-reuse improvements",
    "high time/cost/user-step savings",
    "low-risk quick wins",
    "then long-horizon research gaps"
  ],
  "builder_handoff": {
    "parallel": true,
    "maximum_parallel_lanes": 20,
    "same_canonical_owner_serialized": true,
    "rules": [
      "do not patch 100 bots when one shared fix can solve the gap",
      "builder candidates must cite failing benchmark evidence",
      "run focused test before broad fleet retest",
      "preserve before/after metrics",
      "regressions become permanent fixtures",
      "do not weaken tests to declare a gap closed"
    ]
  },
  "actions_integration": {
    "primary_suite": "Buddy Actions Test Lab -> fleet",
    "control_center": "DreamCo Control Center -> test-fleet",
    "generator": "python3 tools/build_bot_sandbox_curriculum.py",
    "coverage_test": "python3 -m unittest tests.test_bot_sandbox_curriculum"
  },
  "truth_rule": "A generated curriculum proves coverage planning, not runtime execution. Capability/tool/function tests count as passed only when the appropriate local, mock, sandbox, staging, or approved runtime runner records evidence."
}
