    "use config/data-package-maximal-testing-program.json",
    "use config/buddy-bootcamp-program.json",
    "do not release unresolved rights/provenance failures",
    "do not release unresolved secret/private-data exposure",
    "do not mix held-out evaluation answers into training data",
    "do not claim usefulness without held-out evaluation",
    "do not claim universal model improvement from one tested model",
    "publish limitations and regressions",
    "version every package and preserve reproducibility evidence"
