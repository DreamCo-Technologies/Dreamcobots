  "rights_rules": [
    "public accessibility does not imply redistribution rights",
    "record exact source and license/provenance",
    "separate training permission, commercial use and redistribution permission",
    "copyrighted books/movies/courses/scripts/manuals without redistribution rights remain reference/curriculum manifests rather than copied package content",
    "user-owned/licensed data can be used only within the rights the user holds",
    "synthetic data must record generation method and upstream restrictions",
    "open-source code/data packages must preserve applicable license and attribution requirements"
  ],
  "catalog_scale_strategy": {
    "formula": "subject x specialty x task x difficulty x model type x modality x industry x language x evaluation standard",
    "example": "250 subjects x 100 tasks x 5 difficulty levels = 125,000 potential configurations before adding languages, industries, modalities and model types.",
    "rule": "Do not materialize every theoretical combination. Generate/package combinations based on demand, compatibility, rights, benchmark value and maintenance cost."
  },
