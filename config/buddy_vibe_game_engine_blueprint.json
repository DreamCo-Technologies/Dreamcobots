{
  "schema":"dreamco.buddy.vibe_game_engine.v1",
  "mission":"Build an open, benchmark-driven, natural-language game creation engine that turns ideas into playable, testable, learnable simulations while progressively reducing dependence on external models.",
  "principles":["prompt_to_game","capability_first","free_first","local_first_when_possible","human_approval_for_destructive_actions","evidence_driven","original_implementation","benchmark_everything","recover_from_failure","exportable_artifacts"],
  "pipeline":["idea","intent_parser","game_design_spec","world_model","mechanics_graph","asset_plan","code_plan","scene_generation","implementation","automated_tests","playtest_simulation","benchmark","bug_repair","regression","optimization","package","publish_or_export"],
  "vibe_coding":{"inputs":["natural_language","voice","reference_images","design_docs","existing_code","learning_objectives"],"outputs":["game_spec","scenes","gameplay_code","UI","assets_manifest","tests","benchmark_suite","build_artifacts"],"editable_everywhere":true,"explain_changes":true,"keep_change_history":true},
  "game_formats":["2d","3d","text","browser","mobile","desktop","simulation","strategy","role_playing","puzzle","management","educational","sandbox","multiplayer_ready"],
  "learning_game_engine":{"any_subject":true,"subject_to_simulation":["define_learning_goal","map_knowledge","map_skills","create_world","create_tasks","create_feedback","create_failure_states","create_progression","benchmark_learning_outcomes","adapt_difficulty"],"examples":["mathematics","history","biology","chemistry","economics","real_estate","programming","business","engineering","languages","music","art"]},
  "benchmark_integration":{"required":true,"dimensions":["playability","correctness","performance","accessibility","learning_gain","task_completion","reasoning_quality","bug_rate","recovery","originality","user_experience"],"score_range":"0-100"},
  "model_policy":{"default":"free_or_local","paid_models":"explicit_user_request_only","external_models_are_teachers_not_permanent_dependencies":true,"promote_internal_capability_when_verified":true},
  "sandbox":{"default":"isolated","network":"off_by_default","credentials":"never_expose","production_deploy":"approval_required","failure_isolation":true,"reproducible_runs":true},
  "repository_learning":{"authorized_only":true,"learn_patterns":true,"generate_original_implementations":true,"copy_protected_code":false},
  "mastery_loop":["build","test","benchmark","find_gap","study_candidate_solutions","rebuild_original","retest","regress","increase_difficulty"],
  "north_star":"A user should be able to describe almost any game or educational simulation in ordinary language and have Buddy transform the idea into a structured, benchmarked, editable, playable system."
}
