  "adaptation": "Use prerequisite graphs and observed errors to select the next best lesson, exercise, resource, and assessment. Revisit weak prerequisites before advancing.",
  "evidence": "Track source provenance, lesson attempts, assessment results, mistakes, remediation, and mastery history. Do not claim a subject is mastered without current evidence.",
  "college_scope": "College-level breadth and depth are curriculum targets, not a claim of accredited degree completion. External academic credentials remain separate.",
  "truth_rule": "This manifest defines the curriculum architecture. It does not contain or license every textbook, lecture, paper, or course; permitted source acquisition must follow applicable rights and provider terms.",
  "source_coverage": {
    "hugging_face": "Use the live Hugging Face Hub task/tag taxonomy for models, datasets and Spaces as a changing discovery layer; do not treat the seed list as exhaustive.",
    "freecodecamp": "Consume the versioned FreeCodeCamp path and refreshed official curriculum/video inventory as the primary coding pathway; map every authorized source guide to relevant divisions.",
    "open_curricula": "Compare with reputable university open courses, official vendor academies, open textbooks, standards bodies and maintained repositories.",
    "source_policy": "Every learning item retains source version, license, rights permissions, attribution, last verification and division mappings."
  },
  "progression_policy": {
    "parallel_start": "All 55 divisions may begin diagnostics, foundations, source discovery and rights-cleared learning paths in parallel.",
    "advanced_gate": "The coding mastery gate controls advanced production software engineering and high-risk execution privileges, not basic exposure or unrelated academic foundations.",
    "professional_practice": "Regulated, licensed, financial, medical, legal, public-benefit and government actions require separate competence, credential, authorization and human approval gates."
  },
  "teaching_standard": {
    "teacher": "ChatGPT acts as instructor, explainer, reviewer and question setter; Buddy must solve independently and provide evidence.",
    "sequence": [
