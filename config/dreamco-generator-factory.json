{
  "schema": "dreamco.generator_factory.v1",
  "version": "1.0.0",
  "mission": "Give every DreamCo bot access to a shared factory of reusable generators so the fleet can create code, tests, knowledge, resources, data, business assets, benchmarks, repairs and workflows without duplicating generator implementations per bot.",
  "generator_types": [
    {"id":"code_generator","category":"engineering","produces":["source file","module","function","class","service skeleton"]},
    {"id":"api_generator","category":"engineering","produces":["API contract","client adapter","server route","mock fixture"]},
    {"id":"test_generator","category":"quality","produces":["unit tests","integration tests","edge cases","regression fixtures"]},
    {"id":"sandbox_generator","category":"quality","produces":["sandbox plan","mock data","failure scenarios","approval boundaries"]},
    {"id":"benchmark_generator","category":"quality","produces":["same-fixture benchmark","baseline","target","scorecard"]},
    {"id":"bug_knowledge_generator","category":"repair","produces":["failure signature","root-cause notes","known fix","regression recipe"]},
    {"id":"repair_plan_generator","category":"repair","produces":["diagnosis","candidate fixes","risk","verification plan"]},
    {"id":"migration_generator","category":"engineering","produces":["upgrade plan","compatibility checks","rollback plan"]},
    {"id":"documentation_generator","category":"knowledge","produces":["README","how-to","reference","troubleshooting guide"]},
    {"id":"knowledge_pack_generator","category":"knowledge","produces":["topic map","facts","procedures","evaluation questions"]},
    {"id":"resource_pack_generator","category":"resources","produces":["categorized resource list","provenance","eligibility","next steps"]},
    {"id":"data_pack_generator","category":"data","produces":["dataset manifest","schema","training split plan","license metadata"]},
    {"id":"data_quality_generator","category":"data","produces":["validation rules","dedupe tests","privacy checks","quality report"]},
    {"id":"model_eval_generator","category":"ai","produces":["model test suite","routing profile","quality/cost comparison"]},
    {"id":"skill_generator","category":"training","produces":["skill card","drills","graduation tests","practice ladder"]},
    {"id":"curriculum_generator","category":"training","produces":["lesson sequence","practice tasks","assessments","career milestones"]},
    {"id":"workflow_generator","category":"automation","produces":["steps","states","retries","approvals","rollback"]},
    {"id":"agent_generator","category":"automation","produces":["role","tools","memory contract","handoff rules","tests"]},
    {"id":"bot_generator","category":"fleet","produces":["bot definition","division placement","capabilities","sandbox curriculum"]},
    {"id":"division_generator","category":"fleet","produces":["division charter","shared infrastructure","benchmarks","collaborators"]},
    {"id":"issue_generator","category":"operations","produces":["issue title","problem statement","acceptance tests","builder handoff"]},
    {"id":"project_plan_generator","category":"operations","produces":["workstreams","owners","milestones","dependencies","risks"]},
    {"id":"research_generator","category":"research","produces":["research plan","sources needed","comparison matrix","evidence gaps"]},
    {"id":"competitor_generator","category":"research","produces":["competitor list","capability matrix","gap plan","differentiators"]},
    {"id":"simulation_generator","category":"research","produces":["scenario","synthetic environment","success/failure states","metrics"]},
    {"id":"business_generator","category":"business","produces":["problem","offer","pricing","unit economics","operating plan"]},
    {"id":"sales_generator","category":"business","produces":["lead criteria","discovery questions","proposal","objection handling","follow-up"]},
    {"id":"content_generator","category":"creative","produces":["article","script","podcast plan","video plan","social variants"]},
    {"id":"ui_generator","category":"product","produces":["screen spec","components","states","accessibility checks"]},
    {"id":"release_generator","category":"delivery","produces":["release notes","artifact manifest","checksums","rollback notes","deployment checklist"]}
  ],
  "shared_rules": [
    "Generators are reusable services; bots configure them instead of cloning them.",
    "Every generated artifact records generator id, input summary, source/provenance when relevant, version and validation status.",
    "Generators producing executable code or automation must also produce tests or a test plan.",
    "Generators producing data/knowledge/resources must record rights/license/provenance and freshness metadata when relevant.",
    "Generators producing business claims distinguish estimates from verified outcomes.",
    "Generated artifacts remain drafts until their required validation passes."
  ],
  "fleet_access": "all canonical bots may request any generator when relevant to their mission and permissions",
  "truth_rule": "The factory defines generator capabilities and manifests. Individual generators become operational only when an executable implementation and validation evidence exist."
}
