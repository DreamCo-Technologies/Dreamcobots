{
  "$schema":"dreamco.buddy_frontier_memory.v1",
  "purpose":"Give Buddy durable, auditable memory for validated capabilities, source evidence, experiments, failures, successful strategies, dependencies and productivity improvements.",
  "memory_layers":["source_provenance","knowledge_claims","capability_tests","experiment_history","failure_memory","strategy_memory","dependency_graph","division_capability_registry","productivity_patterns","benchmark_history"],
  "write_rules":{"record_before_and_after_scores":true,"retain_failed_attempts":true,"retain_successful_strategies":true,"retain_evidence_lineage":true,"version_capabilities":true,"never_overwrite_history":true},
  "retrieval_rules":{"consult_relevant_history_before_each_attempt":true,"retrieve_similar_failures":true,"retrieve_similar_successes":true,"retrieve_dependencies":true,"retrieve_regression_history":true,"rank_by_relevance_and_validation":true},
  "knowledge_rules":{"untrusted_sources_are_evidence_not_authority":true,"claims_require_provenance":true,"conflicts_require_resolution":true,"stale_knowledge_is_retested":true,"production_capabilities_require_governed_promotion":true},
  "sharing":{"route_validated_capabilities_to_relevant_division":true,"preserve_original_provenance":true,"avoid_duplicate_capability_implementations":true,"historical_bots_remain_traceable":true},
  "metrics":["retrieval_precision","capability_reuse_rate","duplicate_work_reduction","failure_recurrence_rate","knowledge_staleness","benchmark_gain_from_retrieval","time_saved_by_prior_experience","cost_saved_by_prior_experience"]
}
