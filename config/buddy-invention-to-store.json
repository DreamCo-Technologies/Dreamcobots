{
  "schema": "dreamco.buddy_invention_to_store.v1",
  "identity": "Buddy Idea-to-Store Navigator",
  "mission": "Help a user move an idea through evidence, IP decisions, engineering, prototyping, compliance, manufacturing, funding, and market launch with explicit approvals and professional handoffs.",
  "jurisdiction_rule": "Resource guidance must be selected for the user's country and product category. United States resources are defaults here, with WIPO and EPO references for international research; this is not legal advice.",
  "confidentiality_warning": "Public disclosure can affect intellectual-property options. Keep unpublished invention details private and consult a qualified patent professional before public release when protection may matter.",
  "stages": [
    {"id":"problem_evidence","label":"Problem and customer evidence","outputs":["problem statement","target user","current alternatives","interview plan","measurable success condition"],"resource_ids":["sba-local-assistance","score","sbdc"]},
    {"id":"private_invention_record","label":"Private invention record","outputs":["dated description","inventor and contributor record","drawings","experiments","source and license log","confidentiality decision"],"resource_ids":["uspto-ip-identifier","uspto-patent-basics"]},
    {"id":"prior_art","label":"Prior-art and market research","outputs":["search terms","classification search","closest references","difference table","unresolved novelty questions"],"resource_ids":["uspto-patent-search","uspto-public-search","wipo-patentscope","epo-espacenet"]},
    {"id":"ip_decision","label":"Patent, trademark, copyright, or trade-secret decision","outputs":["IP type worksheet","ownership questions","filing and disclosure deadlines","professional-review questions"],"resource_ids":["uspto-ip-identifier","uspto-patent-basics","uspto-trademark-basics","copyright-basics","copyright-registration"]},
    {"id":"professional_help","label":"Qualified help and filing assistance","outputs":["questions for counsel","assistance eligibility","consultation checklist","owner-approved contact handoff"],"resource_ids":["uspto-iac","uspto-pro-se","uspto-pro-bono","uspto-practitioner-search","copyright-contact"]},
    {"id":"requirements","label":"Product requirements and risk","outputs":["functional requirements","constraints","hazards","privacy and security requirements","acceptance tests","budget and schedule assumptions"],"resource_ids":["nist","cpsc-business-guidance"]},
    {"id":"engineering","label":"Engineering and design","outputs":["system architecture","CAD or schematics","software and firmware plan","bill of materials","design-review record"],"resource_ids":["freecad","kicad","blender","github","arduino","raspberry-pi"]},
    {"id":"prototype","label":"Prototype and makerspace build","outputs":["prototype level","build instructions","tools and PPE","parts list","test fixture","failure log"],"resource_ids":["fab-foundation","nist-mep-centers","manufacturing-usa"]},
    {"id":"verification","label":"Verification, safety, and usability","outputs":["test matrix","measurement results","failure cases","design changes","repeat-run evidence"],"resource_ids":["nist","astm","iso","cpsc-regulatory-robot"]},
    {"id":"regulatory","label":"Product-specific compliance routing","outputs":["jurisdiction","product classification","applicable regulator list","standards and certification questions","compliance evidence plan"],"resource_ids":["cpsc-business-guidance","fcc-equipment-authorization","fda-device-advice","ul-solutions"]},
    {"id":"sourcing","label":"Parts and manufacturer sourcing","outputs":["make-or-buy decision","supplier requirements","RFQ","supplier comparison","lead-time and supply-risk record"],"resource_ids":["nist-mep-centers","manufacturing-usa","thomasnet","sam-gov"]},
    {"id":"costing","label":"Cost, pricing, and unit economics","outputs":["BOM cost","tooling and NRE","labor","landed cost","warranty reserve","target margin","sensitivity analysis"],"resource_ids":["sba-business-guide","score","sbdc"]},
    {"id":"funding","label":"Funding and commercialization support","outputs":["funding-fit matrix","eligibility","application calendar","evidence packet","no-guarantee disclosure"],"resource_ids":["sbir","grants-gov","sba-funding","manufacturing-usa"]},
    {"id":"brand_packaging","label":"Brand, packaging, and product identity","outputs":["name candidates","trademark search questions","copyrightable assets list","packaging requirements","barcode plan"],"resource_ids":["uspto-trademark-search","uspto-trademark-basics","copyright-registration","gs1-us"]},
    {"id":"pilot","label":"Pilot, quality, and customer validation","outputs":["pilot batch","inspection plan","customer feedback","defect and return data","go-no-go review"],"resource_ids":["nist-mep-centers","score","sbdc"]},
    {"id":"production_store","label":"Production and store readiness","outputs":["approved supplier","signed quality agreement","production checks","inventory plan","channel requirements","support and recall plan"],"resource_ids":["nist-mep-centers","cpsc-recalls","gs1-us","sba-business-guide"]}
