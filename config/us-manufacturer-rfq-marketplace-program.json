{
  "schema": "dreamco.us_manufacturer_rfq_marketplace.v1",
  "version": "1.0.0",
  "owner_divisions": ["DreamTrade","DreamProduction","DreamMarket","DreamSalesPro","DreamPayments"],
  "mission": "Create a simple Alibaba-style RFQ and manufacturer marketplace focused on U.S. manufacturers: buyers post what they need, verified manufacturers respond with quotes/capacity/lead times, Buddy compares bids and helps both sides move from discovery to contract, production, QA, payment and fulfillment.",
  "roles": ["buyer","manufacturer","supplier","distributor","quality_inspector","logistics_provider","DreamCo_admin"],
  "manufacturer_profile": ["company identity","locations","capabilities","processes","materials","machines/equipment","certifications","industries served","minimum order","capacity","lead times","sample policy","quality systems","insurance","shipping regions","references","photos/documents with permission","verification status"],
  "rfq_fields": ["title","description","drawings/specifications","quantity","target price optional","materials","tolerances","certifications","packaging","delivery location","desired lead time","prototype/sample requirement","NDA requirement","IP/confidentiality","quality requirements","inspection plan","shipping/incoterms","deadline","buyer contact permissions"],
  "quote_fields": ["manufacturer","unit price","tooling/NRE","MOQ","sample price","lead time","capacity","payment terms","shipping estimate","certifications","quality plan","exceptions","valid_until","attachments","verification evidence"],
  "matching_score": ["capability fit","quality/certification fit","capacity","lead time","price/landed cost","location","reliability evidence","communication","risk","buyer preferences"],
  "contract_flow": ["RFQ","supplier discovery","manufacturer verification","quotes","clarifications","sample/prototype","quality review","negotiation","terms summary","contract draft","approval/signature outside Buddy unless integrated","payment milestone setup","production","inspection","shipment","delivery","acceptance","support/dispute","rating/evidence"],
  "marketplace_features": ["search manufacturers","category browsing","verified profiles","post RFQ","invite manufacturers","quote comparison","side-by-side landed cost","message thread","document vault","NDA workflow","sample tracking","inspection reports","milestones","order status","dispute evidence","reviews with anti-fraud controls","saved suppliers","repeat RFQ","analytics","API","mobile-first PWA"],
  "payments": {"provider":"Buddy/DreamCo Stripe abstraction","test_mode_default":true,"live_payment_requires_live_revenue_gate":true,"marketplace_fee_supported":true,"escrow_claim":false,"note":"Do not describe Stripe payment flows as legal escrow unless a compliant escrow product/provider is actually used."},
  "sourcing_sources": ["DreamCo manufacturer profiles","authorized public supplier directories","user-imported supplier lists","authorized Alibaba-style sourcing data for comparison","trade associations","trade shows","government supplier databases","manufacturer websites"],
  "contract_guardrails": ["Buddy drafts/compares terms but does not practice law","surface jurisdiction/insurance/IP/regulatory issues for professional review","do not sign contracts without authorized party approval","do not represent unverified suppliers as verified","preserve quote/version/audit history"],
  "business_model": ["manufacturer subscriptions","verified profile upgrades","RFQ marketplace fee","lead/contact plans","transaction/service fee where permitted","inspection/logistics referrals","enterprise procurement workspace","data/benchmark subscriptions"],
  "truth_rule": "This program models an RFQ/manufacturer marketplace. A supplier, quote, contract, payment, certification or delivery is not verified merely because it exists in the app; verification requires evidence and approved integrations."
}
