{
  "schema": "dreamco.buddy.dataset_profile_builder_policy.v1",
  "version": "1.0.0",
  "purpose": "User-owned, reproducible dataset profiles for retrieval, skill learning, model customization and governed weight training.",
  "default_mode": "retrieval_and_skill_pack",
  "supported_training_methods": ["retrieval", "skill_pack", "prompt_policy", "sft", "lora", "qlora", "preference_optimization", "distillation", "continued_pretraining"],
  "default_source_mix": {"official_docs": 0.25, "courses": 0.20, "papers": 0.15, "datasets": 0.15, "code_examples": 0.15, "user_material": 0.10},
  "learning_not_browsing": {
    "required_content_pipeline": ["retrieve_permitted_content", "extract_concepts", "create_original_lessons", "create_practice_tasks", "create_sandbox_labs", "create_training_examples", "evaluate", "record_reusable_knowledge"],
    "metadata_only_is_not_learning": true,
    "url_visit_is_not_ingestion": true,
    "content_hash_required_for_deduplication": true
  },
  "rights_gate": {
    "unknown_or_restricted_rights_block_training": true,
    "publicly_accessible_does_not_mean_reusable_training_data": true,
    "retain_source_attribution_and_license": true,
    "user_upload_requires_explicit_opt_in": true
  },
  "privacy": {
    "personal_data_default": "exclude_or_redact",
    "external_provider_upload_default": false,
    "tenant_isolation_required": true,
    "secrets_and_credentials_never_become_training_examples": true
  },
  "quality": {
    "deduplicate_exact_and_near_duplicate": true,
    "quality_score_minimum": 0.70,
    "train_validation_holdout_split": [0.75, 0.10, 0.15],
    "holdout_never_used_for_training": true,
    "preserve_source_and_content_hash": true
  },
  "weight_controls": {
    "per_source_and_category_mix": true,
    "user_weights_are_normalized": true,
    "training_examples_have_provenance": true,
    "adapter_training_preferred_before_full_finetuning": true,
    "full_finetuning_requires_explicit_budget_and_approval": true,
    "no_automatic_weight_update_without_baseline_and_regression": true
  },
  "five_minute_scheduler": {
    "cadence_minutes": 5,
    "max_one_mutating_training_job_per_profile": true,
    "priority_formula": "expected_learning_gain * capability_gap * user_value * freshness / estimated_compute_cost",
    "each_tick": ["detect_changed_sources", "ingest_new_approved_content", "build_or_refresh_course_assets", "queue_one_best_bounded_job", "evaluate_due_jobs", "save_evidence_and_checkpoints"],
    "skip_unchanged_content": true,
    "respect_rate_limits_and_budget": true,
    "no_idle_gpu_spin": true,
    "requires_connected_worker": true
  },
  "evidence_required": ["source_manifest", "license_provenance", "dataset_card", "content_hashes", "split_manifest", "baseline_receipt", "training_job_receipt", "checkpoint_hash", "holdout_receipt", "transfer_receipt", "regression_receipt", "cost_receipt"]
}
