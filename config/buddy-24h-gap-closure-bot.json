{
  "$schema":"dreamco.buddy_gap_research_24h.v2",
  "bot_id":"buddy_gap_closure_24h",
  "display_name":"Buddy 24h Gap Research, Mastery & Sandbox Engine",
  "purpose":"Continuously research the first 1000 learning targets, sandbox every learning job, measure demonstrated mastery, remediate weak areas, and continue until all 1000 targets meet the mastery contract. Production changes require a separate governed promotion step.",
  "enabled":true,
  "mastery_campaign":{"target_count":1000,"campaign":"first_1000","completion_requires_all_targets_mastered":true,"mastery_is_demonstrated_not_assumed":true,"do_not_mark_mastered_from_source_reading":true,"retain_evidence_and_test_history":true,"allow_retraining_until_pass":true},
  "target_rate":{"sources_per_week":1000,"priority":"mastery_over_throughput"},
  "execution":{"continuous_schedule":true,"checkpoint_every_minutes":10,"max_parallel_learning_jobs":20,"sandbox_required_per_source":true,"resume_from_checkpoint":true,"do_not_drop_failed_jobs":true},
  "loop":["inventory_capabilities","load_first_1000_targets","detect_gaps","prioritize_gaps","discover_sources","rank_sources","create_learning_jobs","sandbox_each_job","baseline_test","learn","post_learning_test","cross_validate","adversarial_test","regression_test","score_mastery","record_evidence","remediate_failed_target","update_capability_gap_state","retest_dependents","repeat"],
  "stop_policy":{"stop_after_mastery":true,"mastery_stop_condition":"all_1000_targets_meet_mastery_contract","ordinary_gap_queue_empty_is_not_sufficient":true,"temporary_worker_failure_does_not_complete_campaign":true,"failed_source_does_not_complete_target":true,"governance_hold_pauses_promotion_but_preserves_campaign_state":true,"operator_pause_is_explicit":true},
  "mastery_contract":{"minimum_overall_score":0.90,"minimum_factual_accuracy":0.95,"minimum_reproducibility":0.90,"minimum_regression_pass_rate":0.95,"minimum_provenance_completeness":0.95,"requires_multiple_evidence_points":true,"requires_capability_specific_test":true,"requires_failure_analysis_when_below_threshold":true,"requires_retest_after_remediation":true},
  "source_policy":{"web_content_is_untrusted":true,"prefer_first_party_and_official_sources":true,"provenance_required":true,"cross_source_validation_required":true,"respect_access_controls":true,"respect_robots_and_terms":true,"no_paywall_bypass":true,"no_captcha_bypass":true,"no_credential_collection":true},
  "sandbox_policy":{"isolate_external_content":true,"no_production_credentials":true,"no_unapproved_side_effects":true,"baseline_before_learning":true,"post_learning_test":true,"adversarial_test":true,"regression_test":true},
  "promotion":{"requires_measurable_gain":true,"requires_evidence_lineage":true,"requires_regression_pass":true,"production_change_requires_governance":true},
  "telemetry":["targets_mastered","targets_remaining","mastery_scores","sources_discovered","sources_evaluated","sandbox_pass_rate","capability_gains","gaps_opened","gaps_closed","regressions","failed_sources","queue_depth","worker_utilization","latency","cost_estimate","last_checkpoint"],
  "ui":{"surface":"actions","card_id":"buddy-gap-closure-24h","controls":["start","pause","resume","run-now","view-gaps","view-learning-jobs","view-evidence","view-gains","view-mastery"]}
}
