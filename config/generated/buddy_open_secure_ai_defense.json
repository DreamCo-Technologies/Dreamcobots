  "threat_domains": [
    {
      "id": "prompt-injection",
      "label": "Prompt injection",
      "required_control": "Treat external content as untrusted data and constrain tool authority."
    },
    {
      "id": "model-data-poisoning",
      "label": "Model and data poisoning",
      "required_control": "Verify source, provenance, dataset rights, signatures, and behavior changes."
    },
    {
      "id": "secret-leakage",
      "label": "Secret leakage",
      "required_control": "Use vault references, redaction, least privilege, and isolated logs."
    },
    {
      "id": "privacy-leakage",
      "label": "Privacy leakage",
      "required_control": "Minimize data, preserve owner boundaries, and enforce retention and deletion policy."
    },
    {
      "id": "malicious-package",
      "label": "Malicious package",
      "required_control": "Pin dependencies, inspect package behavior, and build in quarantine."
    },
    {
      "id": "dependency-confusion",
      "label": "Dependency confusion and slopsquatting",
      "required_control": "Resolve exact package identity, registry, namespace, hash, and lockfile."
    },
    {
      "id": "unsafe-model-format",
      "label": "Unsafe model serialization",
      "required_control": "Prefer safe formats and disable remote model code."
    },
    {
      "id": "artifact-tampering",
      "label": "Artifact tampering",
      "required_control": "Verify checksums, signatures, attestations, and trusted update metadata."
    },
    {
      "id": "unauthorized-tools",
      "label": "Unauthorized tool use",
      "required_control": "Bind every agent to scoped identity, permissions, budgets, and approval gates."
    },
    {
      "id": "cross-tenant-access",
      "label": "Cross-tenant access",
      "required_control": "Enforce owner isolation in identity, storage, logs, queues, and credentials."
    },
    {
      "id": "output-integrity",
      "label": "Unsafe generated changes",
      "required_control": "Require tests, review branches, signed evidence, rollback, and owner review."
    },
    {
      "id": "license-risk",
      "label": "License and usage risk",
      "required_control": "Review the exact code, model, data, and transitive dependency terms."
    }
  ],
