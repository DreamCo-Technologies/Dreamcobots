    "review_note": "25.7M educational miniature, not released GLM-5.3-Flash weights or GPT-level performance; review exact source and license before reuse"
  },
  "model_ownership": "train_random_initialization_and_save_local_checkpoint",
  "training_tracks": ["from_scratch","supervised_finetune","lora","qlora","executable_reward_rl","retrieval","tool_routing"],
  "initial_track": "from_scratch",
  "data_policy": {
    "allowed": ["original_synthetic","owner_created","explicitly_licensed"],
