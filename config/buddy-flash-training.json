  "architecture_options": ["byte_level_small_transformer","hybrid_linear_sparse_attention","mixture_of_experts","optional_vision_encoder"],
  "division_coverage": {
    "source": "config/generated/bots.catalog.json",
    "benchmark_source": "config/buddy-benchmark-task-registry.json",
    "goal_source": "reports/goals_to_gates.json",
    "missing_domains": "report_uncovered_not_mastered"
  },
  "training_guardrails": {
    "paid_compute_allowed": false,
    "automatic_download": false,
    "production_promotion": false,
    "max_seconds_default": 300,
    "save_checkpoints": true,
    "require_baseline_comparison": true,
    "require_human_review_for_external_actions": true
  },
  "acceptance": [
    "dependency_and_license_audit",
    "CPU_or_MPS_smoke_train_with_checkpoint_hash",
    "unseen_holdout_test_with_reproducible_seed",
    "division_coverage_report",
    "regression_and_safety_gate",
    "local_inference_adapter_proof",
    "no_unverified_mastery_claims"
  ]
}
