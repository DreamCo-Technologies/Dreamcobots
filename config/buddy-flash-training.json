{
  "schema": "dreamco.buddy_flash_training.v1",
  "status": "scaffold_not_trained",
  "inspiration": {
    "tutorial": "https://www.youtube.com/watch?v=-gfgQfw2g_E",
    "upstream": "https://github.com/vukrosic/glm-5.3-flash-from-scratch",
