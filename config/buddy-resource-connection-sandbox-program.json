{
  "schema": "dreamco.buddy_resource_connection_sandbox.v1",
  "version": "1.0.0",
  "mission": "Ensure every canonical DreamCo resource category is discoverable through Buddy and has a sandbox verification path before any live integration is treated as working.",
  "source_of_truth": "shared/bot-category-resource-pack-contract.ts",
  "connection_policy": {
    "buddy_is_front_door": true,
    "catalog_entries_are_not_live_connections": true,
    "live_connection_requires": ["supported adapter", "current permission", "auth/secret reference when required", "sandbox verification", "runtime evidence"],
    "default_external_mode": "read_only_or_mock",
    "write_actions": "approval_gated"
  },
  "resource_types": [
    "official_agency",
    "association",
    "directory",
    "vendor",
    "supplier",
    "marketplace",
    "funding",
    "grant",
    "loan",
    "investor",
    "accelerator",
    "incubator",
    "standards_body",
    "education",
    "research",
    "licensing",
    "insurance",
    "legal_support",
    "accounting",
    "banking",
    "logistics",
    "import_export",
    "government_contracting",
    "community",
    "professional_network",
    "software",
    "api",
    "data_source",
    "other"
  ],
  "sandbox_test_template": [
    "catalog discovery",
    "category/type classification",
    "source/provenance presence",
    "official-source preference where applicable",
    "freshness/last-checked handling",
    "permission boundary",
    "read-only or mock first",
    "invalid/missing credential handling where applicable",
    "timeout/retry behavior where applicable",
    "rate-limit handling where applicable",
    "schema/response validation where applicable",
    "no invented contact details",
    "outbound-contact approval gate",
    "privacy/minimum-data check",
    "cost/spend gate",
    "failure-state visibility",
    "audit/evidence record"
  ],
  "category_overrides": {
    "official_agency": ["official-source URL validation", "jurisdiction", "eligibility disclaimer", "deadline/status freshness"],
    "association": ["membership/industry scope", "contact provenance", "public-directory terms"],
    "directory": ["directory terms", "no bulk personal harvesting", "contact minimum-necessary fields"],
    "vendor": ["business identity", "pricing/terms freshness", "supplier-vendor distinction"],
    "supplier": ["MOQ", "lead time", "shipping", "commercial terms", "quote sandbox"],
    "marketplace": ["listing normalization", "seller/buyer role", "fee disclosure", "transaction approval"],
    "funding": ["eligibility", "cost/terms", "no guaranteed funding", "application approval gate"],
    "grant": ["official source", "deadline", "eligibility", "no guaranteed award", "submission approval gate"],
    "loan": ["APR/fees/term fields", "eligibility distinction", "no guaranteed approval", "application approval gate"],
    "investor": ["investor-type classification", "public contact source", "no unsolicited mass outreach", "pitch draft-only by default"],
    "accelerator": ["cohort/deadline", "eligibility", "fees/equity terms", "application handoff"],
    "incubator": ["program scope", "location", "cost", "application handoff"],
    "standards_body": ["standard/version", "official publication", "license/access status"],
    "education": ["provider", "credential claims", "cost", "course freshness", "learning outcome evidence"],
    "research": ["citation/provenance", "publication date", "reproducibility/evidence strength"],
    "licensing": ["rights owner", "allowed uses", "commercial use", "redistribution", "expiration/revocation"],
    "insurance": ["coverage type", "premium/fee visibility", "regulated-advice boundary", "quote handoff"],
    "legal_support": ["jurisdiction", "attorney/service identity", "legal-advice boundary", "official source"],
    "accounting": ["data minimization", "calculation fixture", "tax/advice boundary", "export integrity"],
    "banking": ["read-only transaction sandbox", "fraud anomaly fixture", "no raw credentials", "money-action approval"],
    "logistics": ["route/shipping fixture", "cost estimate", "tracking state", "failure/retry"],
    "import_export": ["country/jurisdiction", "tariff/classification source", "customs/regulatory disclaimer", "current rules"],
    "government_contracting": ["official solicitation source", "deadline", "entity/eligibility requirements", "submission approval"],
    "community": ["location", "service scope", "eligibility", "contact freshness"],
    "professional_network": ["public professional profile", "consent/outreach gate", "no private-person dossiering"],
    "software": ["version", "license", "security status", "sandbox install/use fixture"],
    "api": ["contract/schema", "auth", "rate limit", "timeout/retry", "sandbox/test mode", "audit receipt"],
    "data_source": ["provenance", "license", "privacy", "schema", "quality", "freshness", "contamination/dedup where relevant"],
    "other": ["must be reclassified when possible", "manual risk/permission review"]
  },
  "repo_resource_sources": [
    "config/buddy-government-resources.json",
    "config/buddy-master-scout-opportunity-resource-library-program.json",
    "config/buddy-trusted-life-network-resource-marketplace-program.json",
    "config/mastery-data-pack-marketplace-program.json",
    "config/buddy-connector-registry.json",
    "website/data/buddy-connection-catalog.json",
    "shared/bot-category-resource-pack-contract.ts"
  ],
  "actions_integration": {
    "workflow": ".github/workflows/buddy-actions-test-lab.yml",
    "suite": "resources",
    "required_command": "node --import tsx --test tests/buddy-resource-sandbox.test.ts"
  },
  "truth_rule": "Passing the resource sandbox proves catalog/contract/guardrail coverage. It does not prove every external resource is live-connected; live status requires an adapter, permission, authentication when needed, and runtime evidence."
}
