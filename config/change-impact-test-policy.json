{
  "schema": "dreamco.change_impact_test_policy.v2",
  "version": "2.0.0",
  "mission": "Ensure changed executable code cannot be labeled release-ready solely because unrelated, deleted, or skipped tests exist.",
  "executable_extensions": [".py", ".ts", ".tsx", ".js", ".mjs", ".cjs"],
  "test_paths": ["tests/"],
  "high_risk_path_keywords": ["stripe", "payment", "billing", "auth", "security", "secret", "privacy", "webhook", "migration", "schema", "database", "deploy", "release", "permission", "tenant", "delete"],
  "high_risk_test_aliases": {
    "stripe": ["stripe", "payment", "revenue", "billing"],
    "payment": ["payment", "stripe", "billing", "revenue"],
    "billing": ["billing", "payment", "stripe", "revenue"],
    "auth": ["auth", "permission", "security", "session", "login"],
    "security": ["security", "auth", "permission", "secret"],
    "secret": ["secret", "security", "credential", "connection"],
    "privacy": ["privacy", "data", "permission"],
    "webhook": ["webhook", "stripe", "integration"],
    "migration": ["migration", "schema", "database"],
    "schema": ["schema", "database", "contract"],
    "database": ["database", "schema", "storage", "migration"],
    "deploy": ["deploy", "runtime", "build", "smoke"],
    "release": ["release", "deploy", "build", "trust"],
    "permission": ["permission", "auth", "security"],
    "tenant": ["tenant", "isolation", "auth", "security"],
    "delete": ["delete", "data", "storage", "permission"]
  },
  "skip_markers": [".skip(", "skipTest(", "@unittest.skip", "pytest.mark.skip", "test.skip(", "describe.skip(", "it.skip("],
  "shared_core_prefixes": ["server/", "shared/", "tools/", "script/"],
  "generic_source_tokens": ["index", "server", "shared", "client", "tools", "script", "build", "run", "generate", "main", "app"],
  "focused_test_mappings": [
    {
      "sources": [
        "client/src/components/AppShell.tsx",
        "client/src/components/ui/calendar.tsx",
        "client/src/components/ui/chart.tsx",
        "client/src/components/ui/resizable.tsx",
        "client/src/pages/BotActivityPage.tsx",
        "client/src/pages/BuddyPage.tsx",
        "client/src/pages/ConversationPage.tsx",
        "client/src/pages/SandboxPage.tsx"
      ],
      "tests": ["tests/ui-library-compatibility.test.mjs"]
    },
    {
      "sources": ["client/src/pages/ActionsPage.tsx", "website/nav.js"],
      "tests": ["tests/actions-page.test.mjs"]
    },
    {
      "sources": ["website/connections.js"],
      "tests": ["tests/connection-secret-intake-page.test.mjs", "tests/resource-onboarding-page.test.mjs"]
    },
    {
      "sources": ["client/src/main.tsx"],
      "tests": ["tests/test_buddy_benchmark_runner_main_postcss_vite_audit_actions_health_optional.py"]
    }
  ],
  "evidence_rules": {
    "normal": ["at least one relevant changed test file or focused verification mapping", "type/syntax check", "affected regression suite"],
    "high": ["normal evidence", "domain-relevant changed test", "negative/error-path test", "security/privacy/permission review", "integration/contract evidence", "rollback or safe-revert evidence when applicable"],
    "shared_core": ["dependent-system regression evidence", "broad repository verification"],
    "anti_bypass": ["changed test files cannot be deleted as the only evidence", "new skip markers are blockers when executable behavior changes", "unrelated changed tests do not satisfy high-risk evidence"]
  },
  "exemptions": {
    "file": "config/change-impact-test-exemptions.json",
    "required_fields": ["path", "reason", "owner", "expires"],
    "rule": "Exemptions are temporary, explicit, reviewable, and cannot be used for critical payment/auth/security/destructive behavior changes."
  },
  "release_blockers": [
    "changed executable file has no relevant verification evidence and no valid exemption",
    "high-risk change lacks domain-relevant stronger evidence",
    "shared-core change lacks dependent-system regression evidence",
    "test file deleted while executable behavior changes without replacement evidence",
    "new test skip marker added while executable behavior changes"
  ],
  "truth_rule": "Relevant test mapping and anti-bypass checks improve confidence but cannot prove absence of every defect."
}
