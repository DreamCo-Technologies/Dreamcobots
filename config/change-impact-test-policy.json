  "evidence_rules": {
    "normal": [
      "at least one relevant changed test file or focused verification mapping",
      "type/syntax check",
      "affected regression suite"
    ],
    "high": [
      "normal evidence",
      "domain-relevant changed test",
      "negative/error-path test",
      "security/privacy/permission review",
      "integration/contract evidence",
      "rollback or safe-revert evidence when applicable"
    ],
    "shared_core": [
      "dependent-system regression evidence",
      "broad repository verification"
    ],
    "anti_bypass": [
      "changed test files cannot be deleted as the only evidence",
      "new skip markers are blockers when executable behavior changes",
      "unrelated changed tests do not satisfy high-risk evidence"
    ]
  },
  "exemptions": {
    "file": "config/change-impact-test-exemptions.json",
    "required_fields": [
      "path",
      "reason",
      "owner",
      "expires"
    ],
    "rule": "Exemptions are temporary, explicit, reviewable, and cannot be used for critical payment/auth/security/destructive behavior changes."
  },
  "release_blockers": [
    "changed executable file has no relevant verification evidence and no valid exemption",
    "high-risk change lacks domain-relevant stronger evidence",
    "shared-core change lacks dependent-system regression evidence",
    "test file deleted while executable behavior changes without replacement evidence",
    "new test skip marker added while executable behavior changes"
  ],
  "truth_rule": "Relevant test mapping and anti-bypass checks improve confidence but cannot prove absence of every defect."
}
