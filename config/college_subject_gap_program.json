{
  "system": "Buddy College Subject Gap Program",
  "taxonomy": "NCES CIP 2020",
  "goal": "Map Buddy capabilities to every college field of study, identify missing subject competence, and build evidence-backed specialist teams without claiming licensed professional authority.",
  "coverage_rules": [
    "ingest_all_CIP_2_4_6_digit_fields",
    "map_each_field_to_existing_bots_tools_models_and_data_sources",
    "label_gaps_as_VERIFIED_PARTIAL_DISCONNECTED_OR_TARGET_ONLY",
    "create_task_scoped_specialists_for_real_gaps",
    "benchmark_against_coursework_textbooks_labs_and_professional_tasks",
    "require_professional_review_for_regulated_high_stakes_work"
  ],
  "benchmark_dimensions": [
    "concept_explanation", "problem_solving", "research", "data_analysis", "writing", "coding",
    "lab_simulation", "design", "case_analysis", "calculation", "teaching", "tutoring",
    "project_planning", "professional_workflow", "source_quality", "safety", "tool_use"
  ],
  "initial_subject_families": [
    "agriculture", "architecture", "area_ethnic_gender_studies", "communications", "computer_science",
    "education", "engineering", "engineering_technology", "foreign_languages", "family_consumer_sciences",
    "legal_studies", "english", "liberal_arts", "library_science", "biological_sciences", "mathematics",
    "military_science", "interdisciplinary_studies", "parks_recreation", "philosophy_religion", "theology",
    "physical_sciences", "psychology", "homeland_security", "public_administration", "social_sciences",
    "construction_trades", "mechanic_repair", "precision_production", "transportation", "visual_performing_arts",
    "health_professions", "business_management", "history"
  ]
}
