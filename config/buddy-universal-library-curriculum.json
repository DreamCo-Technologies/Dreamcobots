  "safety": {
    "public_metadata_does_not_grant_content_or_training_rights": true,
    "item_level_license_and_terms_review_required": true,
    "gated_access_requires_explicit_approval": true,
    "downloads_and_external_execution_require_explicit_approval": true,
    "untrusted_code_runs_in_quarantine": true,
    "dataset_scripts_disabled_by_default": true,
    "secrets_must_never_be_in_guides_or_logs": true,
    "model_weight_training_requires_separate_explicit_approval": true,
    "paid_compute_requires_separate_explicit_approval": true
  },
  "innovation_lab": {
    "enabled_as_research_queue": true,
    "require_hypothesis_and_baseline": true,
    "require_threat_model_and_legal_review": true,
    "require_reproducible_sandbox": true,
    "require_ablation_or_comparison": true,
    "require_holdout_and_regression": true,
    "novelty_is_a_hypothesis_not_a_claim": true,
    "never_promote_unverified_experiments_to_production": true
  },
  "freshness": {
    "recheck_official_docs_days": 30,
    "recheck_release_and_security_metadata_days": 7,
    "pin_every_guide_to_version_or_commit": true,
    "mark_stale_on_major_version_or_api_change": true
  },
  "mastery": {
    "reading_alone_is_not_mastery": true,
