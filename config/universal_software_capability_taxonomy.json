{
  "system": "Buddy Universal Software Capability Taxonomy",
  "version": 1,
  "purpose": "Classify the major families of software humans have built, map the productivity jobs each family performs, and continuously identify Buddy capability gaps without claiming literal enumeration of every software product ever released.",
  "evidence_states": ["VERIFIED", "PARTIAL", "DISCONNECTED", "MISSING", "TARGET_ONLY", "NOT_APPLICABLE"],
  "productivity_dimensions": [
    "create", "edit", "organize", "search", "calculate", "analyze", "visualize", "communicate", "collaborate",
    "automate", "schedule", "monitor", "predict", "simulate", "design", "build", "test", "deploy", "operate",
    "secure", "integrate", "transact", "measure", "optimize", "teach", "learn", "document", "decide",
    "control_physical_system", "manage_workflow", "manage_data", "manage_identity", "manage_money", "manage_assets"
  ],
