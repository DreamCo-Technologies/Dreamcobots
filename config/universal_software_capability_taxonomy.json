      "test_each_productivity_job",
      "record_evidence_state",
      "calculate_missing_capabilities",
      "rank_gaps_by_user_value_revenue_frequency_risk_and_dependency_value",
      "reuse_or_merge_existing_bots_before_creating_new_ones",
