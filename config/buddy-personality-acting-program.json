      "wardrobe_designer", "sound_designer", "composer", "music_supervisor", "voice_director", "editor", "VFX_supervisor",
      "continuity_supervisor", "colorist", "caption_editor", "rights_coordinator", "marketing_producer", "distribution_manager",
      "analytics_manager", "community_manager"
