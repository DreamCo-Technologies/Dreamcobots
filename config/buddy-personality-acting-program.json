      "emotional_triggers", "conflict_style", "decision_style", "visual_references_owned_or_licensed", "rights_metadata"
    ],
    "supports": [
      "original actors", "original animated characters", "cartoon avatars", "game NPCs", "virtual hosts", "streaming personas",
      "music-video characters", "series ensembles", "biographical narrator characters", "training-simulation characters"
    ],
    "continuity": [
