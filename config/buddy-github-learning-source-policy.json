{
  "$schema":"dreamco.buddy_github_learning_source.v1",
  "purpose":"Use GitHub as a high-value software engineering, agent, tooling, benchmark and open-source learning source while preserving provenance, licensing and security boundaries.",
  "priority":"critical_for_software_and_agent_capabilities",
  "uses":["official_project_documentation","source_code_study","issue_and_failure_analysis","pull_request_patterns","test_suite_learning","workflow_learning","open_source_architecture_patterns","benchmark_and_evaluation_discovery","release_and_change_tracking","tool_and_api_discovery"],
  "source_hierarchy":["official_repository","official_organization_repository","maintainer_documentation","verified_release","community_repository_with_strong_evidence","unverified_repository_requires_review"],
  "learning_pipeline":["discover","verify_repository_identity","capture_version_commit","inspect_docs_code_tests_issues_releases","extract_capabilities","map_to_capability_graph","create_sandbox_task","evaluate","record_provenance","regression_test","refresh_on_relevant_release"],
  "security":{"treat_external_code_as_untrusted":true,"never_execute_unknown_code_on_production_systems":true,"sandbox_execution_required":true,"secrets_never_ingested_as_training_data":true,"malware_and_credential_scanning_required":true},
  "provenance":{"repository_url_required":true,"commit_or_release_required":true,"license_required":true,"author_or_organization_recorded":true,"transformation_history_required":true,"third_party_code_never_relabelled_as_dreamco_owned":true},
  "capability_targets":["software_engineering","debugging","testing","git","github_actions","ci_cd","repository_architecture","agent_frameworks","api_integration","security","documentation","open_source_maintenance","code_review","issue_triage","release_engineering"],
  "benchmark_use":{"issues_can_generate_realistic_tasks":true,"tests_can_generate_evaluation_cases":true,"failed_ci_can_generate_recovery_cases":true,"pull_request_history_can_generate_review_cases":true,"holdout_tasks_must_be_separated_from_training_examples":true},
  "commercial_data_policy":{"github_content_is_not_automatically_dreamco_owned":true,"license_and_terms_must_be_checked_before_redistribution":true,"derived_training_assets_require_provenance":true},
  "continuous_learning":{"watch_releases":true,"watch_security_advisories":true,"watch_major_api_changes":true,"revalidate_affected_capabilities":true}
}
