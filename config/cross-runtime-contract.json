{
  "schema": "dreamco.cross_runtime_contract.v1",
  "status": "THREE_RUNTIME_CONTRACT_DEFINED_IMPLEMENTATION_AND_PARITY_PENDING",
  "source_of_truth": {
    "repository": "DreamCo-Technologies/Dreamcobots",
    "branch": "main",
    "owns": [
      "division_registry",
      "task_contracts",
      "dataset_manifests",
      "tokenizer_specs",
      "model_lineage",
      "benchmark_definitions",
      "governance_policy",
      "release_evidence",
      "runtime_conformance_fixtures"
    ]
  },
  "implementations": [
    {
      "id": "python-reference",
      "repository": "DreamCo-Technologies/Dreamcobots",
      "language": "python",
      "role": "canonical_reference_orchestration_training_and_evaluation",
      "required": true,
      "tracked_paths": [
        "buddy/",
        "bots/",
        "tests/",
        "config/"
      ]
    },
    {
      "id": "apple-c",
      "repository": "ireanjordan24/dreamcobots",
      "language": "c",
      "role": "portable_native_runtime_and_competing_execution_backend",
      "required": true,
      "tracked_paths": [
        "core-c/CMakeLists.txt",
        "core-c/include/dreamco_runtime.h",
        "core-c/src/dreamco_runtime.c",
        "core-c/tests/"
      ]
    },
    {
      "id": "apple-swift",
      "repository": "ireanjordan24/dreamcobots",
      "language": "swift",
      "role": "native_macos_app_provider_and_orchestration_runtime_candidate",
      "required": true,
      "tracked_paths": [
        "dreamco/ContentView.swift",
        "dreamco/OpenRouterService.swift",
        "dreamco/dreamcoApp.swift",
        "dreamcoTests/",
        "dreamcoUITests/"
      ]
    }
  ],
  "shared_contracts": [
    "division_identity_and_version",
    "task_request_and_response",
    "model_provider_capability_manifest",
    "tokenizer_identity_and_revision",
    "dataset_provenance_rights_and_split_hashes",
    "training_job_and_compute_approval",
    "checkpoint_manifest_and_sha256",
    "benchmark_case_and_scorecard",
    "run_event_and_failure_taxonomy",
    "release_gate_and_rollback",
    "runtime_capability_and_environment_manifest",
    "cross_runtime_conformance_fixture"
  ],
  "competition": {
    "selection": "best_eligible_model_per_task",
    "runtime_candidates": [
      "python-reference",
      "apple-c",
      "apple-swift"
    ],
    "hard_gates": [
      "task_capability_match",
      "license_and_data_rights",
      "privacy_and_security",
      "tool_and_modality_support",
      "minimum_quality_threshold",
      "reproducible_evidence",
      "shared_contract_conformance"
    ],
    "ranking_dimensions": [
      "quality",
      "reliability",
      "safety",
      "latency",
      "throughput",
      "memory",
      "cost"
    ],
    "policy": "quality_and_safety_gates_first_then_configured_multi_objective_ranking",
    "parity_requirements": [
      "same_task_packets",
      "same_model_and_tokenizer_revisions",
      "same_prompts_and_tool_permissions",
      "same_dataset_and_benchmark_versions",
      "same_quality_and_safety_gates",
      "hardware_and_environment_recorded_and_comparable"
    ],
    "fallback_required": true,
    "benchmark_suite_version_required": true,
    "no_unverified_claims": true
  },
  "training": {
    "tokenizer_training": "approved_dataset_and_rights_review_required",
    "weight_training": "pinned_base_model_tokenizer_dataset_recipe_and_compute_approval_required",
    "checkpoint": "content_addressed_and_hash_verified",
    "promotion": "private_holdout_benchmark_and_release_review_required",
    "scheduled_planning_is_not_training": true,
    "training_authority": "canonical_python_training_pipeline; runtimes consume only approved, versioned artifacts unless separately certified"
  },
  "integration": {
    "sync_direction": "main_repository_contract_to_all_three_implementations",
    "apple_repository_role": "preserve_existing_swift_app_and_c_runtime_as_separate_candidates; do_not_treat_stale_branch_age_as_permission_to_delete_or_overwrite",
    "mac_repository_must_not_become_an_independent_source_of_truth": true,
    "chat_context": "only_explicitly_approved_exported_decisions_and_requirements_are_committed",
    "no_credentials_or_private_chat_transcripts_in_git": true,
    "submodule_policy": "pin_reviewed_main_repository_commit_and_test_compatibility",
    "no_history_rewrite_or_blind_bulk_merge": true
  },
  "completion_order": [
    "inventory_python_and_apple_repositories_all_relevant_branches_pull_requests_workflows_submodules_and_unique_features",
    "reconcile_all_existing_python_pull_request_work",
    "close_unresolved_mappings_and_dependency_gaps_with_owner_review",
    "connect_real_database_storage_queue_and_runner_services_with_evidence",
    "execute_tokenizer_training_and_weight_training_only_on_approved_compute",
    "run_private_holdout_safety_and_regression_benchmarks",
    "complete_release_gates_and_recovery_tests",
    "freeze_versioned_shared_contracts",
    "implement_and_test_apple_c_runtime_after_python_completion",
    "preserve_and_adapt_apple_swift_runtime_to_shared_contract_after_python_completion",
    "run_python_vs_c_vs_swift_competition_on_parity_controlled_tasks",
    "select_best_eligible_runtime_and_model_per_task_and_publish_evidence"
  ],
  "truth_rules": {
    "planned_is_not_running": true,
    "workflow_success_is_not_model_training": true,
    "specification_is_not_a_trained_model": true,
    "benchmark_pass_is_scoped_to_exact_revisions_and_environment": true,
    "production_promotion_requires_explicit_release_gate": true,
    "native_language_does_not_imply_better_performance": true,
    "incomparable_hardware_results_must_not_be_ranked_as_direct_wins": true
  }
}
