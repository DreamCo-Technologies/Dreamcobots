      "worked_examples_beginner_intermediate_advanced",
      "simulation_and_sandbox_exercises",
      "portfolio_capstone_and_independent_assessment",
      "source_citations_version_and_rights_evidence"
    ],
    "software_discovery_policy": "Discover category leaders, open-source alternatives, local/offline tools and current releases. Named products are examples, not endorsements; verify pricing, licensing, security and availability.",
    "competence_policy": "A written playbook is not a credential, license, proof of competence, or permission to perform regulated work."
  },
  "source_families": [
    {
      "id": "hugging-face",
      "scope": "models,datasets,spaces,tasks,benchmarks,technical papers and Hub metadata",
      "refresh": "weekly",
      "boundary": "bounded discovery and individual rights review"
    },
    {
      "id": "freecodecamp",
      "scope": "interactive certifications, curriculum chapters, modules, blocks, challenges, projects, articles, videos and open-source platform code",
      "refresh": "weekly",
      "boundary": "curriculum metadata is not permission to copy transcripts or redistribute course content"
    },
    {
      "id": "onet",
      "scope": "occupations, tasks, skills, knowledge, abilities, work activities, tools and technology",
      "refresh": "release-based",
      "boundary": "preserve official data license and version"
    },
    {
      "id": "official-documentation",
      "scope": "language, framework, cloud, security, database, standards and vendor documentation",
      "refresh": "weekly",
      "boundary": "retain source links and documentation reuse terms"
    },
    {
      "id": "open-source-repositories",
      "scope": "source code, examples, tests, issue histories, architecture and releases",
      "refresh": "weekly",
      "boundary": "review code, dependency, dataset and model licenses separately"
    },
    {
      "id": "open-academic-research",
      "scope": "papers, books, theses, preprints, replication packages and scholarly data",
