{
  "schema": "dreamco.buddy_university_curriculum.v1",
  "version": "1.0.0",
  "title": "DreamCo Buddy University",
  "purpose": "A versioned, source-grounded, cross-disciplinary learning system for Buddy. Hugging Face and freeCodeCamp are important inputs, not the boundaries of the curriculum.",
  "scope_policy": {
    "coverage_model": "living_taxonomy_not_a_claim_to_contain_all_human_knowledge",
    "outside_platforms": true,
    "unknown_subjects": "create_an_unclassified_subject_record_route_to_DreamEducation_and_CommandCore_for_review_then_map_to_domain_divisions",
    "no_source_is_a_course_until_verified_guide_exists": true,
    "no_course_is_mastered_until_independent_assessment_and_transfer_capstone_pass": true
  },
