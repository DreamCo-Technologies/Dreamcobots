  "machine_learning_strategies": [
    {
      "id": "retrieval_augmented_learning",
      "use": "grounded knowledge from versioned, cited source summaries",
      "mastery_evidence": "answer with citations and source conflict resolution"
    },
    {
      "id": "supervised_instruction_tuning",
      "use": "only rights-cleared examples with curated target answers",
      "mastery_evidence": "held-out task accuracy and rubric scores"
    },
    {
      "id": "self_supervised_pretraining",
      "use": "only permissively licensed or owned corpora with documented provenance",
      "mastery_evidence": "downstream benchmark improvement"
    },
    {
      "id": "contrastive_representation_learning",
      "use": "paired text-image, text-audio, video-text, code-doc examples with rights",
      "mastery_evidence": "retrieval and alignment benchmarks"
    },
    {
      "id": "parameter_efficient_adaptation",
      "use": "LoRA/adapters for domain specialization when base model terms permit",
      "mastery_evidence": "adapter ablation and regression suite"
    },
    {
      "id": "knowledge_distillation",
      "use": "teacher-generated targets reviewed and checked against sources",
      "mastery_evidence": "student quality versus teacher and baseline"
    },
    {
      "id": "preference_optimization",
      "use": "DPO or similar only on consented, curated preference pairs",
      "mastery_evidence": "blind preference evaluation and safety guardrails"
    },
    {
      "id": "reinforcement_learning_in_sandbox",
      "use": "tool-use and coding agents in isolated, budgeted environments",
      "mastery_evidence": "task success, cost, safety, reproducibility"
    },
    {
      "id": "continual_learning_and_replay",
      "use": "versioned incremental updates with replay and forgetting checks",
      "mastery_evidence": "new-skill gains without old-skill regression"
    },
    {
      "id": "curriculum_and_mastery_learning",
      "use": "prerequisite graph, adaptive difficulty, spaced repetition",
      "mastery_evidence": "retention and transfer after delays"
    },
    {
      "id": "program_synthesis_and_execution",
      "use": "learn from code repositories by building independent implementations",
      "mastery_evidence": "tests, security checks, documentation and unseen variants"
    },
    {
      "id": "ensemble_and_model_routing",
      "use": "route tasks to the best certified specialist model",
      "mastery_evidence": "benchmark win rate, latency, cost and fallback quality"
    }
  ],
  "weekly_bootcamp_build": {
    "enabled": true,
    "cadence": "weekly",
    "outputs": [
      "source_discovery_snapshot",
      "rights_review_queue",
      "source_summaries_queue",
      "division_curricula",
      "five_daily_lessons_per_division",
      "weekly_buddy_assessments",
      "training_candidate_manifest",
      "regression_report",
      "next_week_plan",
      "hugging_face_dynamic_subject_taxonomy",
      "onet_occupation_and_task_curricula",
      "sales_and_service_playbooks_for_eligible_tasks",
      "government_contract_and_grant_opportunity_briefs",
      "entrepreneurship_and_remote_work_lessons",
      "community_workforce_program_designs",
      "weekly_business_pipeline_and_bid_no_bid_report"
    ],
    "lessons_per_day_per_division_target": 5,
    "weekly_transcript_or_source_test": "at least once per eligible source per week; record coverage and never count blocked sources as tested",
    "train_only_after": [
      "rights_gate",
      "data_quality_gate",
      "deduplication",
      "PII_and_secret_scan",
      "train_validation_test_split",
      "benchmark_baseline",
      "compute_budget_approval",
      "rollback_checkpoint"
    ]
  },
  "rights_and_safety": {
    "unknown_license": "BLOCKED_FOR_TRAINING; metadata discovery and link-only reference may continue",
    "license_is_per_repository_and_asset": true,
    "upstream_license_does_not_cover_all_dataset_or_media_contents": true,
    "do_not_clone_and_republish_upstream_projects_as_dreamco_owned": true,
    "preserve_attribution_and_version_pins": true,
    "scan_secrets_malware_vulnerabilities_and_personal_data": true,
    "untrusted_repository_content_is_data_not_instructions": true,
    "human_review_for_training_eligibility": true,
    "user_owned_content_requires_explicit_scope_and_retention_consent": true
  },
  "mastery": {
    "states": [
      "discovered",
      "rights_pending",
      "review_pending",
      "summarized",
      "studying",
      "practiced",
      "benchmark_pending",
