      "safety_and_license_compliance",
      "no_material_regression"
    ],
    "never_infer_mastery_from_reading_or_summary_alone": true
  },
  "occupational_sales_and_service": {
    "source": "O*NET task statements and occupation data",
    "objective": "Map every published task statement to learning, practice, and a commercial or community-service pathway where appropriate.",
    "stages": [
      "ingest_all_occupations_and_tasks",
      "summarize_occupation_and_task_families",
      "map_task_to_skills_tools_and_credentials",
      "classify_employment_freelance_remote_work_business_or_community_pathway",
      "identify_real_buyers_and_procurement_channels",
      "create_service_offer_and_scope",
      "qualify_lead_and_discover_needs",
      "prepare_truthful_capability_statement_and_proposal",
      "price_with_labor_overhead_risk_and_margin",
      "deliver_and_measure_quality",
      "capture_references_and_improve"
    ],
    "sales_guardrails": [
      "never_claim_credentials_or_experience_not_verified",
      "never_send_unsolicited_bulk_messages_or_spam",
      "human_approval_before_external_contact_or_bid_submission",
      "never_guarantee_income_or_contract_awards",
      "regulated_work_requires_qualified_human_and_required_license"
    ],
    "sales_rep_mode": "For each task, Buddy can act as a supervised business-development representative for a verified DreamCo or partner offer, not pretend to be the worker or licensed professional."
  },
