    {"path":"venture_capital","best_when":["large scalable market","high-growth strategy"],"check":["dilution","control","milestones","return expectations"]},
    {"path":"strategic_partner","best_when":["distribution or capability gap"],"check":["exclusivity","IP","commercial dependency"]},
