  "required_comparison_fields": ["capital_amount", "use_of_funds", "eligibility", "apr_or_effective_cost", "fees", "term", "payment_structure", "collateral", "personal_guarantee", "dilution", "control", "risk", "source_date", "source_url", "human_review"]
