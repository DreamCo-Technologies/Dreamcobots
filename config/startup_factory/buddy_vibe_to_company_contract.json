{
  "schema_version": "1.1.0",
  "name": "Buddy Vibe-to-Company Capability Contract",
  "purpose": "Machine-readable contract for Buddy to turn a natural-language idea, image, prototype, or existing business into a buildable, testable, deployable, operable, and scalable project while preserving the DreamCo fleet.",
  "preservation": {
    "preserve_existing_bots": true,
    "preserve_existing_divisions": true,
    "preserve_existing_registries": true,
    "compose_before_replacing": true
  },
  "pipeline": ["intake", "research", "plan", "design", "generate", "sandbox", "test", "verify", "deploy", "operate", "learn", "improve", "scale", "exit_or_reinvest"],
  "required_project_outputs": [
    "problem_definition", "customer_profiles", "competitive_analysis", "business_model", "prd", "architecture", "ux_plan", "implementation_plan", "source_code", "tests", "sandbox_demo", "security_review", "compliance_checklist", "deployment_plan", "documentation", "pricing", "go_to_market_plan", "sales_system", "customer_support_system", "kpi_plan", "funding_readiness", "operations_plan", "distribution_plan", "supplier_strategy", "franchise_relationship_model", "manufacturing_plan", "construction_plan", "city_development_plan", "state_development_plan", "country_development_plan", "intellectual_property_plan", "patent_workflow", "copyright_workflow", "camera_research_report", "expansion_plan", "exit_or_reinvestment_plan", "evidence_record"
  ],
  "capability_families": {
