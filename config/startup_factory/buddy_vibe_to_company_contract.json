{
  "schema_version": "1.0.0",
  "name": "Buddy Vibe-to-Company Capability Contract",
  "purpose": "Machine-readable contract for Buddy to turn a natural-language idea into a buildable, testable, deployable, and operable project across the complete DreamCo vibe-coding taxonomy.",
  "preservation": {
    "preserve_existing_bots": true,
    "preserve_existing_divisions": true,
    "preserve_existing_registries": true,
    "compose_before_replacing": true
  },
  "pipeline": [
    "intake",
    "research",
    "plan",
    "design",
    "generate",
    "sandbox",
    "test",
    "verify",
    "deploy",
    "operate",
    "learn",
    "improve",
    "scale",
    "exit_or_reinvest"
  ],
  "required_project_outputs": [
    "problem_definition",
    "customer_profiles",
    "competitive_analysis",
    "business_model",
    "prd",
    "architecture",
    "ux_plan",
    "implementation_plan",
    "source_code",
    "tests",
    "sandbox_demo",
    "security_review",
    "compliance_checklist",
    "deployment_plan",
    "documentation",
    "pricing",
    "go_to_market_plan",
    "sales_system",
    "customer_support_system",
    "kpi_plan",
    "funding_readiness",
    "operations_plan",
    "expansion_plan",
    "exit_or_reinvestment_plan",
    "evidence_record"
  ],
  "capability_families": {
    "software": ["web", "mobile", "desktop", "api", "database", "cloud", "devops", "security"],
    "ai": ["llm", "agents", "multi_agent", "rag", "memory", "tool_calling", "evaluation", "model_routing"],
    "voice_media": ["tts", "stt", "voice_agents", "audio", "video", "images", "avatars", "multimodal"],
    "business": ["research", "strategy", "marketing", "sales", "crm", "support", "analytics", "finance", "procurement", "hiring", "partnerships"],
    "physical_world": ["location_search", "facilities", "hardware", "electronics", "robotics", "manufacturing", "automotive", "supply_chain", "inventory"],
    "creative": ["games", "film", "music", "creator", "publishing", "education"],
    "growth": ["funding", "loans", "grants", "investors", "new_markets", "new_locations", "franchise", "acquisition", "internationalization"]
  },
  "employee_system": {
    "actions": ["define_role", "source_candidates", "screen", "rank", "schedule", "interview_support", "reference_check_workflow", "onboard", "measure"],
    "guardrails": ["human_approval_for_hiring", "privacy_minimization", "anti_discrimination_review", "audit_trail"]
  },
  "location_system": {
    "actions": ["discover", "geocode", "compare", "estimate_occupancy_cost", "check_zoning_questions", "score_market_fit", "create_site_shortlist"],
    "guardrails": ["fresh_data_required", "source_citations", "verify_local_rules", "human_approval_before_commitment"]
  },
  "sales_rep_fleet": {
    "actions": ["define_icp", "build_offer", "prospect", "qualify", "personalize", "contact", "follow_up", "book_meeting", "update_crm", "handoff", "coach", "evaluate"],
    "modes": ["dreamco_internal", "user_business", "multi_tenant"],
    "guardrails": ["consent_and_contact_rules", "no_spam", "human_handoff", "approved_claims_only", "audit_logs"]
  },
  "funding_and_loan_guidance": {
    "mode": "educational_decision_support",
    "compare": ["eligibility", "documentation", "apr_or_interest", "fees", "term", "estimated_payment", "collateral", "personal_guarantee", "prepayment", "default_risk"],
    "prohibited": ["guarantee_approval", "fabricate_eligibility", "hide_costs", "pretend_to_be_lender", "unreviewed_regulated_decisions"],
    "human_review_required": true,
    "fresh_data_required": true
  },
  "evidence_lifecycle": ["IDEA", "GENERATED", "EXECUTED", "TESTED", "VERIFIED", "DEPLOYED", "REAL_WORLD_VALIDATED"],
  "quality_gate": {
    "require_tests": true,
    "require_evidence": true,
    "require_rollback_path": true,
    "require_security_review": true,
    "require_human_approval_for_material_external_actions": true
  },
  "competitive_benchmark_targets": [
    "ElevenLabs_voice_and_agent_capabilities",
    "Flux_voice_multilocation_crm_workflows",
    "Flux_AI_hardware_engineering",
    "FluxHQ_durable_agent_workflows",
    "multi_agent_business_workspaces"
  ]
}
