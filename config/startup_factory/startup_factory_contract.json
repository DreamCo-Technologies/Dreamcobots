{
  "version": "1.0.0",
  "name": "Buddy Startup Factory",
  "purpose": "Turn an idea, prototype, existing product, or existing business into an evidence-driven startup build plan without promising funding approval.",
  "entry_points": ["idea", "sketch", "prototype", "codebase", "hardware_prototype", "existing_business", "existing_product"],
  "stages": [
    "DISCOVER", "DEFINE", "PROTOTYPE", "VALIDATE", "BUILD", "LAUNCH", "OPERATE", "SCALE", "FUND"
  ],
  "evidence_lifecycle": ["idea", "generated", "executed", "tested", "verified", "deployed", "real_world_validated"],
  "required_outputs": [
    "startup_profile", "category_map", "customer_profiles", "problem_statement", "competitive_landscape",
    "product_requirements", "architecture_or_prototype_plan", "validation_experiments", "test_plan",
    "business_model", "pricing_hypotheses", "go_to_market_plan", "operating_stack", "milestones",
    "risk_register", "budget", "unit_economics", "financial_projection", "funding_readiness",
    "pitch_deck_outline", "executive_summary", "business_plan_outline", "loan_readiness_checklist",
    "launch_checklist", "kpi_plan", "post_launch_learning_loop"
  ],
  "startup_archetypes": [
    "software_saas", "ai_agents", "voice_audio", "creator_business", "ecommerce", "local_business",
    "professional_services", "hardware_electronics", "robotics", "manufacturing", "automotive",
    "education", "media_film", "games", "health_technology", "fintech_interface", "real_estate_technology",
    "logistics", "industrial_automation", "climate_environment", "scientific_product", "developer_tools",
    "marketplace", "subscription", "hybrid"
  ],
  "financing_paths": [
    "bootstrap", "customer_funded", "grants", "loans", "line_of_credit", "equipment_financing",
    "crowdfunding", "accelerator", "angel", "venture_capital", "strategic_partner", "revenue_based_financing"
  ],
  "loan_guidance_policy": {
    "mode": "educational_decision_support",
    "must_include": ["eligibility_factors", "documentation", "lender_or_program_discovery", "apr_and_fees", "repayment_terms", "collateral_or_guarantees", "risks", "comparison_matrix"],
    "must_not": ["guarantee_approval", "fabricate_eligibility", "represent_estimates_as_offers", "hide_fees_or_risks"],
    "human_review_required_for": ["regulated_financial_decisions", "loan_application_submission", "legal_or_tax_advice"]
  },
  "gates": {
    "prototype_to_build": "prototype evidence plus testable acceptance criteria",
    "build_to_launch": "verification evidence, security/privacy checks, operating plan, rollback path",
    "launch_to_scale": "real-world validation, KPI baseline, unit economics review",
    "funding_ready": "complete evidence-backed package with assumptions clearly labeled"
  },
  "user_transparency": {
    "show_next_action": true,
    "show_blockers": true,
    "show_cost_assumptions": true,
    "show_evidence_status": true,
    "show_approvals": true,
    "show_launch_readiness": true,
    "never_claim_production_ready_from_source_code_alone": true
  }
}
