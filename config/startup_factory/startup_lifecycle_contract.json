{
  "schema_version": "1.0.0",
  "name": "Buddy Universal Startup Lifecycle",
  "purpose": "Help a user turn an idea, prototype, existing business, or acquired business into a validated, launchable, managed, and scalable operation.",
  "entry_points": ["idea", "problem", "sketch", "prototype", "codebase", "hardware_prototype", "existing_business", "acquisition", "expansion", "turnaround"],
  "stages": [
    {"id":"discover","name":"Discover","outputs":["problem_definition","customer_hypotheses","market_map","category_map","success_metrics"]},
    {"id":"design","name":"Design","outputs":["prd_or_business_spec","business_model","offer","brand_direction","risk_register","milestones"]},
    {"id":"prototype","name":"Prototype","outputs":["prototype","demo","architecture","bom_or_stack","initial_cost_model"]},
    {"id":"validate","name":"Validate","outputs":["tests","customer_feedback","market_evidence","unit_economics","go_no_go_decision"]},
    {"id":"fund","name":"Fund","outputs":["startup_budget","use_of_funds","forecast","financing_comparison","funding_package","loan_readiness"]},
    {"id":"launch","name":"Launch","outputs":["legal_setup_checklist","website_or_store","sales_system","support_system","analytics","deployment_and_operations"]},
    {"id":"operate","name":"Operate","outputs":["kpi_dashboard","cash_flow_monitor","sales_pipeline","customer_feedback_loop","task_automation","compliance_checklist"]},
    {"id":"improve","name":"Improve","outputs":["experiments","cost_reduction_plan","quality_improvements","product_iterations","rollback_plan"]},
    {"id":"expand","name":"Expand","outputs":["new_markets","new_channels","new_products","hiring_plan","capacity_plan","partnership_plan","capital_plan"]},
    {"id":"scale","name":"Scale","outputs":["repeatable_playbooks","automation_map","multi_location_or_multi_region_plan","governance","resilience_plan"]},
    {"id":"exit_or_reinvest","name":"Exit or Reinvest","outputs":["valuation_inputs","acquisition_readiness","succession_options","reinvestment_plan"]}
  ],
  "universal_capabilities": [
    "research", "planning", "vibe_coding", "software_building", "web_building", "mobile_building", "AI_agent_building", "voice_and_audio", "media_creation", "hardware_design", "robotics", "manufacturing", "ecommerce", "marketing", "sales", "crm", "customer_support", "analytics", "finance_modeling", "documentation", "testing", "deployment", "security", "compliance_workflows", "procurement", "hiring_workflows", "partnerships", "funding_readiness", "loan_readiness", "grant_discovery", "investor_readiness", "operations", "optimization", "expansion", "exit_planning"
  ],
  "financing_paths": ["bootstrapping", "customer_funded", "grants", "accelerators", "crowdfunding", "equipment_financing", "business_credit", "line_of_credit", "term_loan", "SBA_or_government_programs", "angel", "venture_capital", "strategic_investment", "revenue_based_financing"],
  "loan_guidance_policy": {
    "mode": "educational_decision_support",
    "must_compare": ["eligibility_factors", "documentation", "APR_or_interest", "fees", "term", "payment_estimate", "collateral", "personal_guarantee", "prepayment_terms", "default_risk"],
    "must_not": ["guarantee_approval", "fabricate_eligibility", "hide_costs", "pretend_to_be_a_lender", "make_unreviewed_regulated_financial_decisions"],
    "human_review_required": true,
    "fresh_data_required": true
  },
  "evidence_lifecycle": ["IDEA", "GENERATED", "EXECUTED", "TESTED", "VERIFIED", "DEPLOYED", "REAL_WORLD_VALIDATED"],
  "operating_rule": "Buddy must always identify the current stage, next best action, dependencies, owner, estimated cost, evidence, blockers, approvals, and rollback path before advancing a material stage."
}
