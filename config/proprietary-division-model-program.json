    "first_party_artifacts": [
      "DreamCo-authored training data",
      "DreamCo training recipes",
      "DreamCo-produced adapters and checkpoints where rights allow",
      "DreamCo model cards and release manifests",
      "DreamCo inference packaging"
    ],
    "upstream_rights_preserved": true,
    "prohibit_unlicensed_training_data": true,
    "prohibit_claiming_exclusive_ownership_of_upstream_weights": true,
    "counsel_review_required_before_external_license_release": true
  },
  "per_division_release_requirements": [
    "canonical_division_id",
    "independent_model_id_and_semver",
    "pinned_base_model_and_license",
    "tokenizer_and_config",
    "rights_cleared_dataset_manifest",
    "reproducible_training_recipe",
    "weights_or_adapter_checkpoint",
    "held_out_benchmarks",
    "safety_and_privacy_evaluations",
    "model_card",
    "license_and_notice_bundle",
    "inference_package",
    "rollback_metadata"
  ],
  "preferred_training_strategy": [
    "evaluate_compact_permissively_licensed_base",
    "LoRA_or_QLoRA_finetuning",
    "approved_distillation_when_teacher_terms_allow",
    "from_scratch_only_when_justified"
  ],
  "taxonomy": {
    "source": "live_Hugging_Face_Hub_taxonomy_and_metadata",
