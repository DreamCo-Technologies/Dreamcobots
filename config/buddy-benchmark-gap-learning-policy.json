  "benchmark_policy":{"baseline_required":true,"post_learning_test_required":true,"adversarial_test_required":true,"regression_test_required":true,"capability_specific_test_required":true,"benchmark_improvement_must_be_measurable":true,"do_not_declare_gap_closed_from_reading":true},
  "coverage":{"business_productivity":true,"personal_productivity":true,"software_engineering":true,"research":true,"reasoning":true,"data_analysis":true,"automation":true,"security_awareness":true,"domain_specialists":true},
