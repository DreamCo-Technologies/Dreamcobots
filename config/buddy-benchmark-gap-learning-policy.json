  "loop":["run_benchmark_suite","build_gap_vector","rank_gaps_by_impact_and_difficulty","map_gaps_to_required_capabilities","discover_best_source_candidates","rank_sources","build_target_specific_plan","sandbox_learning","run_benchmark_again","cross_validate","record_gain","diagnose_remaining_gap","replan_every_attempt","repeat_until_threshold_or_governance_hold"],
