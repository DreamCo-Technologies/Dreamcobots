  "property_acquisition_workflow": [
    {"id":"capture","name":"Capture a property seen on route","buddy_can":"save GPS, address, photos, notes, and listing-source evidence","gate":"owner initiates capture"},
    {"id":"listing","name":"Verify listing and seller authority","buddy_can":"query an authorized property provider and compare fields","gate":"licensed data source"},
    {"id":"screen","name":"Investor screening","buddy_can":"calculate owner-supplied ARV, rent, repair allowance, financing, cap rate, cash-on-cash return, and uncertainty","gate":"estimates only"},
    {"id":"inspection","name":"Inspection","buddy_can":"prepare a photo checklist, flag visible concerns, and request qualified inspector quotes","gate":"not a substitute for a licensed inspection"},
    {"id":"appraisal","name":"Appraisal","buddy_can":"assemble comparable-property evidence and request appraiser quotes","gate":"not an appraisal; licensed appraiser signs valuation"},
    {"id":"quotes","name":"Price quotes","buddy_can":"build standardized RFQs for repairs, insurance, title, survey, financing, utilities, and property management","gate":"providers return and own quotes"},
    {"id":"offer","name":"Offer and diligence","buddy_can":"prepare a review packet, deadlines, contingencies, and document checklist","gate":"buyer approves; licensed professionals review where required"},
    {"id":"close","name":"Contract, payment, and closing","buddy_can":"track approvals and evidence","gate":"never autonomous without explicit transaction approval"}
  ],
