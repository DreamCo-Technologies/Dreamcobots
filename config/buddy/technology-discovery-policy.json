{
  "schema": "dreamco.buddy.technology_discovery_policy.v1",
  "purpose": "Continuously discover, timestamp, compare, and preserve AI and broader technology changes, with priority attention to vibe coding, AI-assisted software creation, small/home businesses, remote work, freelancing, creator income, digital products, and human-AI work.",
  "catalog_policy": {
    "mode": "append_only_versioned_observations",
    "taxonomy_mode": "open_vocabulary",
    "source_registry_mode": "extensible_owner_reviewed",
    "category_counts": "computed_from_current_records",
    "item_counts": "computed_from_current_records",
    "fixed_category_ceiling": null,
    "fixed_item_ceiling": null,
    "fixed_provider_ranking": false,
    "never_delete_historical_observations": true,
    "mark_missing_records_stale_only_after_successful_source_refresh": true,
    "preserve_first_seen_last_seen_and_source_provenance": true,
    "new_categories_may_be_added_without_schema_rewrite": true,
    "new_sources_may_be_added_without_code_changes": true
  },
  "refresh_policy": {
    "cadence": "every_6_hours_and_manual_dispatch",
    "request_timeout_seconds": 25,
    "user_agent": "DreamCo-Buddy-Technology-Radar/1.0",
    "maximum_response_bytes": 12000000,
    "preserve_last_good_data_on_source_failure": true,
    "no_paid_api_calls": true,
    "no_account_creation_or_sign_in": true,
    "no_automated_purchases_or_outreach": true
  },
