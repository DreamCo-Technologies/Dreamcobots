{
  "system": "Buddy Vacancy + Growth Planner",
  "goal": "Monitor evidence-backed vacancy and underused-space signals, then propose lawful plans to attract residents, employers, visitors, investment, and tax base without fabricating market data.",
  "vacancy_types": ["residential", "retail", "office", "industrial", "hospitality", "mixed_use", "public_buildings", "land"],
  "inputs": [
    "vacancy_rate", "days_on_market", "asking_rent_or_price", "population_trend", "job_trend", "income",
    "traffic_and_travel_times", "nearby_amenities", "schools", "healthcare_access", "broadband", "crime_public_safety",
    "housing_cost", "taxes", "utilities", "tourism", "business_formation", "permits", "infrastructure_capacity"
  ],
  "plan_lanes": [
    "resident_attraction", "employer_recruitment", "small_business_activation", "downtown_storefront_activation",
    "adaptive_reuse", "housing_rehabilitation", "new_housing_supply", "tourism_events", "placemaking",
    "workforce_training", "university_partnerships", "incentives_and_grants", "infrastructure_upgrades",
    "broadband_and_remote_work", "marketing_and_branding", "developer_outreach", "public_private_partnerships"
  ],
  "ranking": ["estimated_impact", "cost", "time_to_value", "feasibility", "fiscal_return", "housing_affordability", "equity", "resilience"],
  "evidence_states": ["VERIFIED", "ESTIMATED", "STALE", "MISSING", "TARGET_ONLY"],
  "guardrails": [
    "do_not_equate_vacancy_with_blight_without_evidence",
    "do_not_use_protected_characteristics_for_housing_steering",
    "do_not_promise_jobs_population_or_tax_revenue",
    "require_human_approval_for_public_spending_contracts_and_incentives"
  ]
}
