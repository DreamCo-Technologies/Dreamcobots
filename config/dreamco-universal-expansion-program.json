{
  "schema": "dreamco.universal_expansion_program.v1",
  "version": "1.0.0",
  "mission": "Continuously discover, benchmark, build and improve safe ways Buddy and DreamCo bots can help humans be more productive, learn faster, use computers and apps better, build and run organizations, create valuable media and software, access government and nonprofit services, compete for eligible contracts, and identify permitted revenue opportunities.",
  "principles": {
    "human_first": true,
    "offline_capable_where_possible": true,
    "authoritative_sources_are_adapters_not_hard_dependencies": true,
    "sandbox_before_live": true,
    "evidence_before_capability_claim": true,
    "every_gap_gets_parallel_owner": true,
    "professional_or_regulated_work_requires_appropriate_human_review": true,
    "autonomous_revenue_must_be_legal_permitted_auditable_and_revocable": true
  },
  "continuous_loops": [
    "discover human productivity opportunities",
    "discover learning and intelligence improvements",
    "discover new AI use cases",
    "discover computer and app workflows",
    "discover software tools people and organizations will pay for",
    "discover business-owner pain points",
    "discover permitted autonomous revenue experiments",
    "discover new government service assistance opportunities",
    "discover eligible public procurement opportunities",
    "discover nonprofit service and fundraising opportunities",
    "discover creative media workflows and quality gaps",
    "discover repository capability gaps and integration gaps"
  ],
  "benchmark_families": {
    "human_ai_computer_app": {
      "sources": ["DreamCo universal benchmark", "O*NET database", "public app categories", "user-intent telemetry when consented", "repository capability inventory"],
      "targets": ["AI use", "computer use", "app downloads", "web use", "professional service use", "job tasks", "work activities", "accessibility", "personal productivity"]
    },
    "business": {
      "targets": ["idea", "validation", "planning", "formation", "licenses", "banking", "accounting", "finance", "insurance", "branding", "product", "pricing", "operations", "hiring", "training", "sales", "marketing", "advertising", "partnerships", "associations", "customer success", "support", "security", "compliance", "analytics", "procurement", "fundraising", "expansion", "franchising", "international", "M&A", "succession", "shutdown"],
      "billable_step_rule": "Every lifecycle stage should be representable as a separately priceable service, bundled service, or automated capability with explicit inputs, outputs, effort, risk, and evidence."
    },
    "creative_mastery": {
      "book": ["idea", "research", "outline", "draft", "editing", "fact-checking", "illustration", "layout", "cover", "metadata", "publishing", "distribution", "marketing", "rights tracking"],
      "film_video": ["concept", "script", "storyboard", "shot list", "budget", "casting support", "scheduling", "production planning", "editing", "VFX", "sound", "color", "captions", "trailers", "distribution", "marketing"],
      "music": ["concept", "songwriting", "composition", "arrangement", "recording", "editing", "mixing", "mastering", "artwork", "metadata", "distribution", "promotion", "rights and royalty tracking"]
    },
    "government": {
      "citizen_service": ["benefit discovery", "eligibility pre-screening", "forms", "appointments", "records", "permits", "licenses", "tax navigation", "public comments", "case status", "service routing", "language access", "accessibility"],
      "workforce": ["map government occupations and tasks", "administrative automation", "document support", "data analysis", "knowledge retrieval", "constituent service", "procurement", "grants", "inspection support", "planning", "reporting"],
      "contracts": ["SAM.gov opportunity discovery", "NAICS mapping", "PSC mapping", "set-aside awareness", "capability statement support", "bid/no-bid scoring", "requirements extraction", "proposal support", "compliance matrix", "subcontractor discovery", "past-performance library", "deadline tracking"],
      "rules": ["never fabricate eligibility", "never misrepresent certifications", "never submit without explicit authority", "retain source and deadline evidence", "human approval for binding representations"]
    },
    "organizations": {
      "for_profit": ["sole proprietorship", "partnership", "LLC", "corporation", "S corporation tax election context", "professional entity", "cooperative", "franchise", "holding company", "startup", "small business", "enterprise", "agency", "marketplace", "subscription business", "ecommerce", "manufacturer", "retailer", "professional services"],
      "nonprofit": ["public charity", "private foundation", "membership nonprofit", "religious organization", "education nonprofit", "arts nonprofit", "social service nonprofit", "advocacy organization", "trade association", "professional association", "social club", "fiscal sponsorship context"]
    }
  },
  "sales_and_marketing_system": {
    "universal_pipeline": ["market definition", "lead discovery", "lead enrichment", "qualification", "segmentation", "personalized value hypothesis", "outreach", "follow-up", "appointment", "discovery", "demo", "proposal", "objection handling", "close", "onboarding", "customer success", "upsell", "renewal", "referral", "win-back"],
    "parallel_bots": ["lead discovery bot", "lead enrichment bot", "qualification bot", "outreach bot", "appointment bot", "sales rep bot", "proposal bot", "closing assistant", "CRM bot", "customer success bot", "upsell bot", "renewal bot", "referral bot", "analytics bot"],
    "advertising_catalog_target": 500,
    "advertising_categories": ["SEO", "content", "email", "social", "video", "audio", "communities", "marketplaces", "directories", "associations", "events", "partnerships", "affiliates", "referrals", "PR", "local", "outbound", "retargeting", "sponsorship", "education", "product-led growth", "integrations", "developer ecosystem", "government-market outreach", "nonprofit partnerships"],
    "lead_gen_relationship": "Lead generation is one subsystem. It does not replace the full sales representative, proposal, close, onboarding, expansion, advertising, partnership, association, referral, renewal or customer-success systems."
  },
  "book_of_associations": {
    "purpose": "A reusable organization graph for prospecting, partnerships, sponsorships, member marketing, referrals, procurement, grants and market intelligence.",
    "types": ["trade association", "professional association", "chamber of commerce", "business league", "industry council", "standards body", "licensing board", "certification body", "cooperative", "economic development organization", "incubator", "accelerator", "university center", "investor network", "conference organizer", "vendor directory", "nonprofit network", "government partner network"],
    "fields": ["name", "type", "industry", "geography", "website", "membership", "contact routes", "events", "directories", "sponsorships", "advertising options", "partnership paths", "referral paths", "procurement paths", "grant paths", "APIs/data", "source", "last_verified", "terms", "notes"]
  },
  "parallel_gap_contract": {
    "required_for_every_benchmark": true,
    "owners": ["benchmark bot", "gap analyst bot", "builder bot", "integration bot", "sandbox QA bot", "security/compliance bot", "business-value bot", "human-review bot"],
    "gap_fields": ["benchmark_id", "domain", "severity", "evidence", "current_score", "target_score", "owner_bot", "builder_path", "integration_path", "sandbox_plan", "safety_constraints", "business_value", "retest_plan", "status"],
    "close_rule": "A gap closes only after evidence-backed retest meets the target and required safety/compliance checks pass."
  },
  "sandbox": {
    "goal": "Best-in-class evidence-driven sandbox for safe capability graduation.",
    "layers": ["unit", "contract", "integration", "simulated external API", "offline fallback", "adversarial", "permission boundary", "privacy", "security", "policy", "load", "latency", "cost", "reliability", "recovery", "human-review", "red-team", "regression", "canary"],
    "graduation": ["test fixture", "expected outcome", "source evidence", "risk classification", "pass thresholds", "failure injection", "audit log", "human approval when required", "rollback path", "post-deploy monitor"],
    "never": ["silently spend money", "silently sign contracts", "silently submit government forms or bids", "claim regulated professional status", "bypass permissions", "store secrets in fixtures", "graduate on self-reported success alone"]
  },
  "repository_integration": {
    "rule": "New systems must discover and map existing registries, divisions, bots, tools, APIs, benchmarks and workflows before creating duplicates.",
    "required_maps": ["bot registry", "division registry", "capability registry", "tool registry", "benchmark registry", "workflow registry", "integration registry", "revenue system", "sandbox system", "model routing", "memory/knowledge systems"],
    "connection_health": ["present", "importable", "registered", "routable", "sandbox-tested", "permissioned", "observable", "documented"]
  },
  "truth_rule": "This file defines targets and operating rules, not proof that every capability is already implemented. Capability status must come from repository evidence and sandbox results."
}
