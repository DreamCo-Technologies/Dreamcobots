{
  "schema": "dreamco.data_package_maximal_testing.v1",
  "version": "1.0.0",
  "mission": "Require sellable DreamCo data packages to undergo broad, reproducible testing across data quality, rights, privacy, security, usefulness, portability, robustness, and model-training impact before publication or sale.",
  "applies_to": ["dataset-pack", "evaluation-pack", "benchmark-pack", "book-curriculum-pack", "film-curriculum-pack", "multimedia-training-pack", "coding-data-pack", "domain-knowledge-pack", "synthetic-data-pack", "user-created sellable package"],
  "test_families": {
    "schema_and_structure": [
      "schema validation",
      "required-field completeness",
      "type consistency",
      "null/missing-value analysis",
      "range/domain validation",
      "referential-integrity checks",
      "primary/unique-key checks",
      "ordering/time-series consistency",
      "encoding/Unicode validation",
      "file-format parse tests",
      "archive integrity",
      "checksum verification"
    ],
    "quality_and_cleanliness": [
      "exact duplicate detection",
      "near-duplicate detection",
      "contradictory-record detection",
      "label consistency",
      "annotation agreement",
      "outlier analysis",
      "noise estimation",
      "corrupt/truncated record detection",
      "blank/boilerplate record detection",
      "language detection accuracy",
      "OCR/transcription quality where applicable",
      "image/audio/video quality checks where applicable"
    ],
    "provenance_and_rights": [
      "source traceability",
      "license validation",
      "commercial-use validation",
      "redistribution-right validation",
      "AI-training-use validation or explicit unknown status",
      "attribution completeness",
      "source-version/snapshot pinning",
      "transformation lineage",
      "third-party component inventory",
      "rights-expiration/change review"
    ],
    "privacy_and_security": [
      "PII scan",
      "sensitive-data scan",
      "credentials/secrets scan",
      "private-key/token scan",
      "malware/archive payload scan",
      "prompt-injection/untrusted-text markers for agent datasets",
      "unsafe executable-content review",
      "data exfiltration risk review",
      "redaction verification",
      "de-identification/re-identification risk assessment where applicable"
    ],
    "split_and_contamination": [
      "train/validation/test overlap",
      "near-duplicate cross-split leakage",
      "entity leakage",
      "time leakage",
      "source leakage",
      "benchmark contamination",
      "evaluation-answer leakage",
      "instruction-response template leakage",
      "memorization-risk sampling",
      "holdout integrity"
    ],
    "coverage_and_bias": [
      "class/category balance",
      "difficulty distribution",
      "language coverage",
      "geographic coverage",
      "time-period coverage",
      "platform/device coverage",
      "domain/topic coverage",
      "edge-case coverage",
      "minority/rare-case coverage where lawful and relevant",
      "sampling skew analysis",
      "source concentration analysis",
      "known-bias documentation"
    ],
    "training_usefulness": [
      "baseline model/bot evaluation before package",
      "same-model evaluation after package/training",
      "held-out task improvement",
      "generalization beyond training examples",
      "catastrophic-forgetting/regression checks",
      "instruction-following quality",
      "tool-use quality where applicable",
      "coding correctness where applicable",
      "reasoning/task-quality metrics where applicable",
      "hallucination/error-rate comparison",
      "calibration/confidence comparison",
      "human-review rubric where deterministic grading is insufficient"
    ],
    "robustness_and_adversarial": [
      "malformed-record handling",
      "extreme-value handling",
      "unexpected-language/input handling",
      "adversarial examples where appropriate",
      "prompt injection resistance for agent/RAG packs",
      "poisoning/anomaly detection",
      "ambiguous-label cases",
      "contradictory-source cases",
      "missing-context cases",
      "distribution-shift sampling",
      "failure/recovery behavior"
    ],
    "performance_and_efficiency": [
      "load time",
      "parse throughput",
      "index-build time",
      "storage size",
      "compression ratio",
      "memory footprint",
      "training throughput",
      "inference/RAG latency impact",
      "token efficiency",
      "GPU/CPU utilization where applicable",
      "cost per verified improvement",
      "incremental-update cost"
    ],
    "portability_and_interoperability": [
      "documented schema export",
      "common-format conversion",
      "cross-platform load tests",
      "Python compatibility",
      "JavaScript/TypeScript compatibility where relevant",
      "common ML/data framework compatibility",
      "streaming/chunked access",
      "random-access support where needed",
      "version migration",
      "backward compatibility",
      "package uninstall/removal",
      "offline/local-first usability"
    ],
    "documentation_and_user_experience": [
      "data card completeness",
      "license card completeness",
      "README/use instructions",
      "training recipe",
      "evaluation recipe",
      "sample records",
      "known limitations",
      "expected hardware/storage",
      "cost guidance",
      "upgrade/update instructions",
      "rollback/removal instructions",
      "error troubleshooting"
    ],
    "refresh_and_reproducibility": [
      "deterministic build where practical",
      "source snapshot/revision reproducibility",
      "build-script repeatability",
      "random-seed recording",
      "environment/runtime recording",
      "dependency lock/pinning",
      "refresh-diff report",
      "removed/changed-source handling",
      "security/license change detection",
      "staleness detection",
      "rebuild comparison to prior package"
    ]
  },
  "package_release_levels": [
    {"id":"discovered","gate":"Source and purpose identified; not sellable."},
    {"id":"rights_cleared","gate":"Rights/provenance suitable for intended use are documented."},
    {"id":"cleaned","gate":"Core schema, quality, duplicate, corruption, privacy and security tests pass."},
    {"id":"evaluated","gate":"Usefulness and held-out evaluation evidence exist."},
    {"id":"robust","gate":"Robustness, leakage, contamination, portability and regression tests pass."},
    {"id":"release_candidate","gate":"Documentation, reproducibility, upgrade/removal and commercial gates pass."},
    {"id":"sellable_verified","gate":"All required test families pass or have explicit documented non-applicable/approved exception status."}
  ],
  "parallel_test_fleet": {
    "enabled": true,
    "maximum_parallel_lanes": 20,
    "lanes": [
      "schema_structure",
      "quality_cleanliness",
      "rights_provenance",
      "privacy_security",
      "split_contamination",
      "coverage_bias",
      "training_usefulness",
      "robustness_adversarial",
      "performance_efficiency",
      "portability_interoperability",
      "documentation_ux",
      "refresh_reproducibility"
    ],
    "rule": "Independent test families run in parallel; failed or blocked families remain visible and prevent sellable_verified status unless explicitly not applicable or owner-approved exception is valid."
  },
  "failure_policy": [
    "do not hide failed, skipped, blocked or not-run tests",
    "do not lower a valid threshold just to ship",
    "do not mark unknown rights as approved",
    "do not sell a package with unresolved secret/private-data exposure",
    "do not call a package useful without held-out evaluation",
    "do not call a package uncontaminated without contamination checks appropriate to its use",
    "do not claim bias-free; measure and document coverage and known limitations",
    "do not claim reproducibility when build/source/version metadata is missing"
  ],
  "sellable_package_report": [
    "package identity/version",
    "category/subcategory",
    "rights and provenance summary",
    "test matrix with pass/fail/blocked/not-applicable",
    "quality metrics",
    "duplicate/contamination metrics",
    "privacy/security findings",
    "coverage/bias notes",
    "baseline versus post-training/usefulness results",
    "performance/storage/cost metrics",
    "supported formats/frameworks",
    "known limitations",
    "refresh/update policy",
    "reproducibility instructions",
    "commercial-use and redistribution status"
  ]
}
