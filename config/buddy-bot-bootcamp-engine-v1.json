{
  "schema":"dreamco.buddy.bootcamp_engine.v1",
  "mission":"Turn verified learning sources and benchmark evidence into reusable, cost-aware bot training curricula.",
  "pipeline":["goal_intake","capability_decomposition","gap_scan","source_rank","knowledge_distill","study_guide","micro_lessons","practice_generation","sandbox_generation","benchmark_selection","adaptive_remediation","novel_transfer","mastery_gate","regression_watch"],
  "source_policy":{"verified_only":true,"licensed_or_authorized_access_only":true,"source_is_not_runtime_authority":true,"preserve_provenance":true,"do_not_copy_protected_material_verbatim":true},
  "lesson_policy":{"generate_original_explanations":true,"generate_original_examples":true,"generate_original_exercises":true,"generate_failure_cases":true,"generate_transfer_tasks":true},
  "training_policy":{"reuse_cached_assets":true,"prefer_small_models_for_routine_generation":true,"parallelize_independent_tasks":true,"escalate_model_only_when_expected_learning_gain_justifies_cost":true,"never_train_on_locked_evaluation_answers":true},
  "mastery":{"require_independent_success":true,"require_novel_transfer":true,"require_regression_pass":true,"require_safety_validation":true,"min_score":0.90},
  "customer_controls":["capability_selection","benchmark_selection","source_allowlist","privacy_namespace","compute_budget","time_budget","model_allowlist","minimum_mastery_score"],
  "artifacts":["curriculum.json","study-guide.md","lesson-bank.json","practice-set.json","sandbox-suite.json","benchmark-plan.json","mastery-report.json","regression-plan.json"]
}
