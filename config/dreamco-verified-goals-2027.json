      "target": "Deliver 10 assessed original Bootcamp courses"
    },
    {
      "day": 120,
      "target": "Pass 25 independent coding evaluations"
    },
    {
      "day": 180,
      "target": "Operate 3 tested customer products"
    },
    {
      "day": 270,
      "target": "Certify 25 specialist capabilities"
    },
    {
      "day": 365,
      "target": "Verify 100 distinct capabilities and at least one paying product"
    }
  ],
  "verification_rules": [
    "A plan, bot profile, test stub, catalog, UI button or model routing fallback never counts as verified mastery.",
    "Each promotion requires exact revision, environment, executable task, independent test evidence, failure cases, and reviewer approval.",
    "No payment, deployment, model training, external publishing or sensitive write without applicable owner approval.",
    "Do not expose private source code, credentials, customer data or benchmark holdouts on GitHub Pages.",
    "Historical reports are snapshots; rerun checks before claiming a blocker remains current."
  ],
