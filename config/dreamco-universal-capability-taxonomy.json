        "evaluation_and_quality"
      ],
      "actor_modes": [
        "human_only",
        "ai_model_only",
        "robot_only",
        "human_ai_robot"
      ]
    },
    {
      "id": "M06",
      "title": "Benchmarking, learning, and targeted improvement",
      "category": "evaluation_and_adaptation",
      "capability_domains": [
        "evaluation_and_quality",
        "learning_and_adaptation"
      ],
      "actor_modes": [
        "human_only",
        "ai_model_only",
        "human_ai",
        "human_ai_robot"
      ]
    }
  ],
  "exercise_types": [
    {
      "id": "E01",
      "title": "Task decomposition exercise",
      "category": "task_understanding",
      "module_id": "M01",
      "actor_modes": [
        "human_only",
        "ai_model_only",
        "human_ai"
      ]
    },
    {
      "id": "E02",
      "title": "Workflow and tool-selection exercise",
      "category": "planning_and_orchestration",
      "module_id": "M02",
      "actor_modes": [
        "human_only",
        "ai_model_only",
        "human_ai"
      ]
    },
    {
      "id": "E03",
      "title": "Sandbox execution exercise",
      "category": "execution_and_integration",
      "module_id": "M03",
      "actor_modes": [
        "ai_model_only",
        "robot_only",
        "human_ai",
        "ai_robot"
      ]
    },
    {
      "id": "E04",
      "title": "Collaborative handoff exercise",
      "category": "communication_and_collaboration",
      "module_id": "M04",
      "actor_modes": [
        "human_ai",
        "human_robot",
        "ai_robot",
        "human_ai_robot"
      ]
    },
    {
      "id": "E05",
      "title": "Failure diagnosis and retraining exercise",
      "category": "evaluation_and_adaptation",
      "module_id": "M06",
      "actor_modes": [
        "human_only",
        "ai_model_only",
        "human_ai"
      ]
    }
  ],
  "project_types": [
    {
      "id": "P01",
      "title": "Division end-to-end capability project",
      "actor_modes": [
        "human_only",
        "ai_model_only",
        "robot_only",
        "human_ai",
        "human_robot",
        "ai_robot",
        "human_ai_robot"
      ]
    },
    {
      "id": "P02",
      "title": "Cross-division collaboration project",
      "actor_modes": [
        "human_ai",
        "human_robot",
        "ai_robot",
        "human_ai_robot"
      ]
    }
  ],
  "assessment_types": [
    {
      "id": "A01",
      "title": "Baseline capability diagnostic",
      "kind": "diagnostic",
      "pass_threshold": 0.7
    },
    {
      "id": "A02",
      "title": "Practical task execution benchmark",
      "kind": "performance",
      "pass_threshold": 0.8
    },
    {
      "id": "A03",
      "title": "Unseen transfer and holdout assessment",
      "kind": "holdout",
      "pass_threshold": 0.8
    },
    {
      "id": "A04",
      "title": "Safety, permissions, and governance assessment",
      "kind": "safety",
      "pass_threshold": 1
    }
  ],
  "mastery_policy": {
    "minimum_task_accuracy": 0.8,
    "minimum_holdout_accuracy": 0.8,
    "safety_gate_required": true,
    "safety_gate_score": 1,
    "consecutive_passes_required": 2,
    "mastery_awarded_by": "verified_evidence_gate_only",
    "training_weight_updates_authorized": false
  },
  "retraining_policy": {
    "trigger": "any_required_assessment_or_benchmark_failure",
    "steps": [
      "classify_failure_by_capability_domain",
      "select_the_weakest_related_lesson",
      "assign_a_targeted_exercise",
      "repeat_in_a_sandbox_with_new_inputs",
      "run_an_unseen_holdout_assessment",
      "record_before_and_after_evidence"
    ],
    "failure_routes": {
      "task_understanding": "M01",
      "planning_and_orchestration": "M02",
      "execution_and_integration": "M03",
      "communication_and_collaboration": "M04",
      "safety_and_quality": "M05",
      "evaluation_and_adaptation": "M06"
    },
    "mastery_awarded_on_failure": false
  }
}
