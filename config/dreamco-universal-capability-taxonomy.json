  "curriculum_modules": [
    {
      "id": "M01",
      "title": "Domain understanding and task intake",
      "category": "task_understanding",
      "capability_domains": [
        "discovery_and_research",
        "information_and_memory",
        "reasoning_and_decision"
      ],
      "actor_modes": [
        "human_only",
        "ai_model_only",
        "human_ai"
      ]
    },
    {
      "id": "M02",
      "title": "Planning, decomposition, and workflow design",
      "category": "planning_and_orchestration",
      "capability_domains": [
        "reasoning_and_decision",
        "planning_and_orchestration"
      ],
      "actor_modes": [
        "human_only",
        "ai_model_only",
        "human_ai",
        "human_ai_robot"
      ]
    },
    {
      "id": "M03",
      "title": "Tools, systems, and sandbox execution",
      "category": "execution_and_integration",
      "capability_domains": [
        "software_and_systems",
        "physical_action_and_manipulation",
        "operations_and_maintenance"
      ],
      "actor_modes": [
        "ai_model_only",
        "robot_only",
        "human_ai",
        "ai_robot"
      ]
    },
    {
      "id": "M04",
      "title": "Human, AI, and robotic collaboration",
      "category": "communication_and_collaboration",
      "capability_domains": [
        "communication_and_collaboration",
        "planning_and_orchestration"
      ],
      "actor_modes": [
        "human_ai",
        "human_robot",
        "ai_robot",
        "human_ai_robot"
      ]
    },
    {
      "id": "M05",
      "title": "Safety, governance, and quality control",
      "category": "safety_and_quality",
      "capability_domains": [
