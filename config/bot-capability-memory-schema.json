  "migration_rules": [
    "Never delete an old bot capability before its details are represented in the canonical registry.",
    "One bot may produce many capabilities.",
    "One capability may originate from many bots.",
    "Preserve relationships between bots and capabilities.",
    "Preserve historical evidence even after a bot is retired.",
    "Catalog metadata does not prove runtime capability; verification evidence is required.",
    "Generated records must identify their generator and schema version."
