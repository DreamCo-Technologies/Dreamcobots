{
  "schema": "dreamco.buddy_creator_showrunner.v1",
  "name": "Buddy Creator and Showrunner System",
  "status": "local_show_bible_episode_and_channel_planning_ready",
  "truth_boundary": "Buddy can create and test show bibles, character libraries, episode packets, learning checks, simulation-game plans, platform variants, and approval-ready publishing packages. A channel is not connected, media is not rendered, and content is not published until an authenticated adapter completes the action with the owner's exact approval.",
  "formats": [
    {
      "id": "youtube_channel",
      "label": "YouTube channel or video show",
      "routes": ["creative-brief-gen", "video-script", "video-editor-ai", "content-calendar", "seo-optimizer", "content-analytics"],
      "deliverables": ["channel promise", "show bible", "episode slate", "scripts", "thumbnail briefs", "titles and descriptions", "long-form master plan", "short-form cutdowns", "caption package", "analytics experiment"]
    },
    {
      "id": "social_content_series",
      "label": "Social content series",
      "routes": ["social-content", "video-script", "visual-planner", "social-scheduler", "content-calendar", "content-analytics"],
      "deliverables": ["series bible", "content pillars", "hook library", "platform variants", "caption package", "moderation plan", "content calendar", "measurement plan"]
    },
    {
      "id": "learning_series",
      "label": "Learning video series",
      "routes": ["curriculum-mapper", "adaptive-learning", "video-script", "video-editor-ai", "accessibility-auditor", "games-app-bot"],
      "deliverables": ["learning map", "episode lessons", "worked examples", "knowledge checks", "practice activities", "captions", "teacher or family guide", "learning evidence"]
    },
    {
      "id": "simulation_series",
      "label": "Simulation and practice-game series",
      "routes": ["dr-simulation", "games-app-bot", "game-ai-player", "game-analytics", "curriculum-mapper", "immersive-xr"],
      "deliverables": ["scenario bible", "state machines", "legal actions", "levels", "safe failure and reset", "feedback", "bot playtests", "instructor controls", "known-limits report"]
    },
    {
      "id": "music_performance_series",
      "label": "Music and performance series",
      "routes": ["music-production", "music-app-bot", "video-script", "video-editor-ai", "social-content", "content-calendar"],
      "deliverables": ["original repertoire plan", "lyrics and composition rights ledger", "performance direction", "music-video treatments", "episode slate", "social cutdowns", "release calendar", "audience tests"]
    },
    {
      "id": "fiction_or_variety_show",
      "label": "Fiction, cartoon, or variety show",
      "routes": ["creative-writer", "video-script", "3d-asset-mgr", "video-editor-ai", "music-production", "content-calendar"],
      "deliverables": ["series bible", "world bible", "character library", "season arc", "episode slate", "continuity ledger", "picture and sound plan", "delivery masters plan"]
    }
  ],
  "character_library": {
    "application_character_limit": null,
    "active_characters_per_production_unit": 100,
    "scale_strategy": "Keep reusable character metadata in the show library and schedule subsets into episodes, scenes, or production units. Paginate large libraries and export archives when device storage approaches its quota.",
    "required_fields": ["stable character id", "unique production name", "role", "original description", "personality traits", "voice direction", "visual direction", "continuity facts", "rights mode", "status"],
    "rights_modes": ["original synthetic", "company-owned mascot", "adult owner digital double", "licensed adult performer"],
    "continuity_checks": ["name and stable id", "silhouette and visual anchors", "voice and speech direction", "personality range", "relationships", "knowledge boundaries", "wardrobe and props", "episode state", "rights and consent state", "synthetic-media label"]
  },
  "show_lifecycle": [
    {"id": "position", "outputs": ["audience", "channel promise", "content pillars", "success measures"]},
    {"id": "bible", "outputs": ["format rules", "world", "cast", "tone", "visual and sound language", "rights"]},
    {"id": "season", "outputs": ["season objective", "arc", "episode slate", "release cadence", "production units"]},
    {"id": "episode", "outputs": ["brief", "research", "script", "storyboard", "asset manifest", "learning or entertainment rubric"]},
    {"id": "produce", "outputs": ["recording or render plan", "timeline", "captions", "platform variants", "provenance"]},
    {"id": "review", "outputs": ["continuity", "rights", "safety", "accessibility", "quality control", "owner approval"]},
    {"id": "publish", "outputs": ["authenticated destination", "final preview", "exact owner approval", "platform receipt"]},
    {"id": "learn", "outputs": ["owner-authorized metrics", "retention and completion", "learning outcomes", "comments and moderation summary", "next experiment"]}
  ],
  "platform_profiles": [
    {"id": "youtube_long", "label": "YouTube long-form", "outputs": ["16:9 master", "thumbnail", "title", "description", "chapters", "captions", "end-screen plan"]},
    {"id": "youtube_short", "label": "YouTube Short", "outputs": ["9:16 cut", "opening hook", "captions", "safe text", "loop or close"]},
    {"id": "social_vertical", "label": "Vertical social video", "outputs": ["9:16 variants", "platform-safe captions", "cover frame", "moderation notes"]},
    {"id": "social_square", "label": "Square social video", "outputs": ["1:1 variant", "safe text", "caption", "cover frame"]},
    {"id": "podcast_video", "label": "Video podcast", "outputs": ["multicamera or scene plan", "clean audio", "chapters", "transcript", "clips"]},
    {"id": "classroom", "label": "Classroom and learning portal", "outputs": ["accessible master", "transcript", "knowledge checks", "teacher guide", "downloadable activity"]},
    {"id": "practice_game", "label": "Practice game", "outputs": ["deterministic build", "learning objective", "levels", "feedback", "safe reset", "progress evidence"]}
  ],
  "content_calendar": {
    "cadences": ["one-time", "daily", "twice-weekly", "weekly", "biweekly", "monthly", "seasonal"],
    "states": ["idea", "researched", "scripted", "assets_ready", "in_production", "review", "approved", "scheduled", "published", "measured", "archived"],
    "automation_default": "draft_and_prepare_only",
    "publish_requires_exact_owner_approval": true
  },
  "quality_and_safety_gates": [
    "originality, source, copyright, music, trademark, and performer-rights review",
    "character identity, voice, visual, relationship, and episode-state continuity",
    "fact, claim, sponsor, affiliate, and endorsement substantiation",
    "age-appropriate design, privacy, moderation, accessibility, and flashing-light review",
    "learning objective, misconception, feedback, assessment, and instructor-review evidence",
    "game determinism, safe failure, reset, recovery, difficulty, and bot playtest evidence",
    "picture, sound, captions, aspect ratio, platform policy, and master quality control",
    "authenticated destination preview and exact owner approval before publishing"
  ],
  "hard_blocks": [
    "unconsented real-person voice or likeness imitation",
    "minor voice or likeness cloning",
    "deceptive impersonation or fake endorsement",
    "unlicensed music, scripts, footage, characters, or brand assets",
    "hidden sponsorship, fabricated metrics, fake engagement, or spam",
    "autonomous account signup, credential capture, publishing, or spending without exact owner approval",
    "high-risk instruction presented as real-world qualification or proof"
  ]
}
