{
  "schema": "dreamco.buddy_master_scout_opportunity_resource_library.v1",
  "version": "1.0.0",
  "mission": "Create a coordinated Master Scout Team that continuously discovers, verifies, compares and teaches legitimate opportunities that can help users earn more, save more, land deals, find work/contracts/resources, build businesses and avoid scams, while training specialist bots against measured results.",
  "north_star": "Help users make measurable progress toward their financial and business goals; millionaire status is an aspiration, never a promised outcome.",
  "extends": [
    "config/buddy-trusted-life-network-resource-marketplace-program.json",
    "config/buddy-capability-growth-business-memory-games-program.json",
    "config/buddy-24x7-system-runtime-program.json",
    "config/bot-benchmark-competition-league.json",
    "config/buddy-bootcamp-program.json"
  ],
  "master_scout_team": [
    {"id":"income-scout","searches":["jobs","gigs","freelance work","remote work","local work","commission opportunities","legitimate paid tasks","skills-to-income matches"]},
    {"id":"deal-scout","searches":["business deals","vendor deals","customer opportunities","partnerships","bulk buying","resale opportunities","asset deals","negotiation opportunities"]},
    {"id":"contract-scout","searches":["government procurement","corporate procurement","RFPs","RFQs","subcontracts","vendor registrations","local contracts","institutional purchasing"]},
    {"id":"grant-scout","searches":["government grants","foundation grants","business grants","education grants","community grants","research grants","nonprofit grants","local programs"]},
    {"id":"loan-financing-scout","searches":["business loans","personal loans","microloans","SBA-style programs","CDFIs","credit unions","equipment financing","invoice financing","seller financing","approved low-cost financing alternatives"]},
    {"id":"credit-card-scout","searches":["credit cards","secured cards","business cards","rewards","fees","APR","intro offers","eligibility indicators","credit-building products"]},
    {"id":"savings-scout","searches":["subscription savings","insurance comparisons","utility savings","merchant fee savings","software alternatives","supplier savings","refinance education","tax-credit/resource discovery","price comparisons"]},
    {"id":"housing-scout","searches":["low-cost rentals","assistance","down-payment programs","low-cash-entry ownership","community land trusts","shared equity","eligible zero-down programs","seller financing","housing grants/resources"]},
    {"id":"real-estate-deal-scout","searches":["public listings","foreclosures where lawful","tax-sale education","distressed-property listings","land","commercial property","owner-listed opportunities","rehab opportunities"]},
    {"id":"supplier-scout","searches":["manufacturers","wholesalers","distributors","OEM/ODM partners","dropship suppliers","local suppliers","international suppliers","private-label opportunities"]},
    {"id":"customer-scout","searches":["public business demand","RFP/RFQ demand","market gaps","buyer-intent signals","authorized lead sources","local customer segments"]},
    {"id":"business-for-sale-scout","searches":["businesses for sale","owner-financed businesses","franchises","microbusinesses","digital businesses","asset purchases","succession opportunities"]},
    {"id":"startup-scout","searches":["unmet needs","new technologies","regulatory changes","new APIs","new marketplaces","automation opportunities","AI-native businesses"]},
    {"id":"resale-flip-scout","searches":["lawful arbitrage","used goods","surplus","liquidation from reputable sources","repair/resale","collectibles","equipment","vehicle parts"]},
    {"id":"education-training-scout","searches":["free training","paid-to-learn programs","apprenticeships","certifications","scholarships","bootcamps","employer training","public workforce programs"]},
    {"id":"benefits-resource-scout","searches":["government benefits","nonprofit aid","utility aid","food resources","transportation","childcare","veteran resources","senior resources","disability resources"]},
    {"id":"association-network-scout","searches":["trade associations","professional associations","chambers","business networks","industry groups","incubators","accelerators","makerspaces","libraries"]},
    {"id":"technology-scout","searches":["open-source tools","AI models","APIs","automation tools","free tiers","new platforms","productivity software","developer resources"]},
    {"id":"data-scout","searches":["open data","licensed datasets","public records","business datasets","market datasets","training-data candidates","sellable data-package opportunities"]},
    {"id":"manufacturer-scout","searches":["contract manufacturers","robotics manufacturers","electronics OEM/ODM","component suppliers","packaging manufacturers","prototype shops","domestic manufacturing","international manufacturing"]},
    {"id":"creator-income-scout","searches":["creator programs","content monetization","licensing","sponsorship marketplaces","affiliate programs","music/media opportunities","platform revenue programs"]},
    {"id":"intellectual-property-scout","searches":["public patent information","licensing opportunities","technology transfer offices","public-domain works","open licenses","trademark/name research resources"]},
    {"id":"government-opportunity-scout","searches":["official assistance programs","procurement","public surplus","economic development","workforce programs","housing programs","small-business programs","tax incentives/credits where applicable"]},
    {"id":"scam-reality-scout","searches":["get-rich-quick claims","business opportunities","investment pitches","grant claims","work-from-home schemes","MLM/network-marketing offers","crypto/token pitches","real-estate seminar claims","credit repair claims","debt relief claims","AI passive-income claims"]},
    {"id":"local-opportunity-scout","searches":["nearby businesses","local jobs","local contracts","local grants","local suppliers","local customers","local associations","local property opportunities","community resources"]}
  ],
  "get_rich_quick_reality_lab": {
    "goal": "Teach users and bots to distinguish plausible opportunities from exaggerated, deceptive, illegal or mathematically unsustainable schemes.",
    "categories": ["MLM/network marketing","pyramid-style structures","dropshipping claims","Amazon/e-commerce automation claims","real-estate no-money-down claims","house flipping","foreclosure/tax-sale claims","day trading","options trading","forex","crypto","memecoins","sports-betting systems","lottery systems","AI passive-income offers","affiliate marketing","print-on-demand","vending/ATM routes","franchises","business-opportunity kits","credit repair","grant-finding services","mystery shopping","reshipping","task/job scams","investment clubs"],
    "evaluation": ["upfront cost","ongoing cost","time required","skill required","capital risk","legal/regulatory risk","platform risk","market demand","competition","typical versus advertised outcome","independent evidence","refund/contract terms","income disclosure where available","recruitment dependence","mathematical sustainability","scam complaints/warnings","best-case/base-case/worst-case model"],
    "verdicts": ["legitimate_with_real_work","legitimate_but_high_risk","possible_but_marketing_exaggerated","insufficient_evidence","major_red_flags","likely_scam_or_prohibited","illegal_or_pyramid_structure_if_facts_match"],
    "truth_rule": "Never guarantee wealth or imply an opportunity is safe merely because some people profit. Show evidence, assumptions, failure rates when available, costs and risks."
  },
  "opportunity_card": {
    "fields": ["title","scout","category","official/source links","location","eligibility","skills needed","cash needed","credit needed","estimated time","possible upside","recurring cost","fees","deadline","competition","risk level","evidence strength","scam/red-flag score","application/deal steps","documents needed","permission needed","last verified","user-fit score","next action"],
    "financial_projection_rule": "Projections must be labeled estimates/scenarios, include assumptions and never be presented as guaranteed earnings."
  },
  "user_progress_engine": {
    "goal": "Turn discovery into a prioritized progression plan rather than overwhelming users with links.",
    "lanes": ["earn more","save money","reduce debt","build credit","find funding","land a job","land a contract","find customers","find suppliers","buy/build a business","housing/homeownership","learn a valuable skill","build assets"],
    "ranking": ["user eligibility","expected value","speed to benefit","cash required","risk","effort","skill fit","location","deadline","evidence","user preference"],
    "milestones": ["first verified opportunity","first application","first interview/meeting","first quote","first customer","first contract","first dollar saved","first dollar earned","first recurring revenue","first business launch","business graduation"],
    "millionaire_goal": "Users may set $1M net-worth/revenue goals. Buddy should build scenario-based plans and track progress, not promise millionaire outcomes."
  },
  "train_a_bot_for_every_scout": {
    "enabled": true,
    "pipeline": ["define scout skill","collect lawful training/reference sources","build Mastery Data Pack","train/configure specialist in Buddy Bootcamp","run held-out tests","compare against manual/public baselines","deploy in research/proposal mode","measure real user outcomes","retrain/repair gaps"],
    "scorecard": ["precision","recall/coverage","freshness","eligibility accuracy","source quality","false-positive rate","scam detection","time saved","money saved","opportunities converted","user satisfaction","cost per useful opportunity"]
  },
  "massive_business_resource_library": {
    "goal": "Create a structured resource graph for humans and bots that is broader than a traditional association directory.",
    "resource_types": ["government agencies","programs","grants","lenders","CDFIs","banks/credit unions","credit products","procurement portals","RFP/RFQ sources","job boards","gig platforms","training providers","schools","associations","chambers","incubators","accelerators","SBDCs/SCORE-style resources","libraries","makerspaces","manufacturers","suppliers","wholesalers","distributors","logistics providers","professional services","insurance resources","real-estate resources","housing programs","public data","open-source projects","APIs","software","marketplaces","customer/buyer directories","export/import resources","certification bodies","standards organizations","research institutions","technology-transfer offices","nonprofits","community organizations"],
    "resource_record": ["name","type","official source","geography","industries","services","eligibility","cost","contact method","API/export availability","terms/licensing","privacy classification","freshness","verification status","scam/quality signals","related resources"],
    "bot_usage": ["retrieval","eligibility matching","comparison","workflow planning","source citation","freshness monitoring","gap discovery","training-package construction"],
    "user_usage": ["search","filter","compare","save","track deadlines","build action plan","export","request Buddy assistance"]
  },
  "directory_connectors": {
    "business_directories": {
      "examples": ["Yellow Pages-style licensed/public business directories","official business registries","chambers","industry directories","maps/local-business providers","supplier/manufacturer directories"],
      "allowed": ["business discovery","public business contact information where terms permit","supplier/customer research","market mapping","user-requested outreach preparation"],
      "rules": ["use official APIs/licensed datasets or permitted public access","respect terms, rate limits and robots/access controls","preserve source/freshness","no unsolicited mass messaging"]
    },
    "people_directories": {
      "examples": ["White Pages-style directory services only where lawful and licensed","user's authorized contacts","public professional directories"],
      "allowed": ["user-requested contact lookup where lawful","contact deduplication","authorized CRM enrichment","identity disambiguation"],
      "prohibited": ["bulk harvesting personal phone/address data","doxxing","tracking private individuals","sensitive-trait profiling","spam","bypassing paywalls/access controls","building unauthorized dossiers"],
      "permission_rule": "Personal-directory data requires a legitimate user purpose, minimum necessary fields, lawful/permitted source access and applicable consent/notice requirements."
    }
  },
  "guardrails": [
    "no guaranteed income, wealth, approval, grants, loans, credit scores, contracts or jobs",
    "do not apply for credit/loans or submit binding applications without explicit user approval",
    "do not fabricate eligibility or application information",
    "do not recommend illegal pyramid schemes or deceptive business practices",
    "do not facilitate gambling as a wealth plan",
    "do not make personalized high-stakes investment trades autonomously",
    "separate research/education from regulated financial/legal advice",
    "use current official sources for government programs and material eligibility rules",
    "respect privacy, directory terms, anti-spam rules and user permissions",
    "record whether an opportunity produced a real result instead of counting discovery as success"
  ],
  "24x7_behavior": {
    "idle_mode": "Scouts rotate through freshness checks, new resource discovery, benchmark gaps, scam-pattern updates and user-fit opportunity queues within configured budgets.",
    "priority": "User-requested work preempts background scouting.",
    "default_external_spend_usd": 0,
    "outreach": "draft-only until authorized",
    "applications": "prepare-only until authorized",
    "continuous_learning": "Verified successes/failures become fixtures and Mastery Data Pack updates for the relevant scout."
  },
  "truth_boundary": "This configuration defines the Master Scout architecture and resource taxonomy. It does not mean every listed directory, lender, government system, job board, supplier source or marketplace is currently connected. Each live connector requires supported access, current terms, permission and runtime evidence."
}
