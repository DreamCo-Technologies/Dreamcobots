{
  "schema": "dreamco.master_capability_plan.v1",
  "version": "1.0.0",
  "purpose": "Unify repository ideas, capabilities, benchmarks, Studio controls, and user-facing evidence without claiming unverified mastery.",
  "truth_boundary": {
    "implemented_is_not_mastered": true,
    "cataloged_is_not_connected": true,
    "planned_is_not_available": true,
    "frontier_routed_is_not_buddy_native_mastery": true,
    "benchmark_plan_is_not_benchmark_pass": true,
    "only_current_passing_evidence_can_close_a_benchmark_gap": true
  },
  "capability_states": ["planned","cataloged","implemented","tested","sandboxed","connected","partially_connected","blocked","deprecated","duplicate","mastered"],
  "master_map_domains": [
    "buddy","models","tools","apis","bots","divisions","benchmarks","datasets","sandboxes","actions","backend","github_pages","forecasts","leads","safety_consent_provenance","studio_film","studio_television","studio_animation","studio_games","studio_music","education","business","humanity_productivity"
  ],
  "benchmark_gap_closure": {
    "required_sequence": [
      "measure_current_evidence",
      "diagnose_root_cause",
      "select_smallest_shared_safe_repair",
      "define_rollback_and_fallback",
      "apply_only_on_review_branch_or_sandbox",
      "run_targeted_tests",
      "rerun_original_benchmark",
      "compare_before_after_evidence",
      "retest_dependent_suites_for_shared_fixes",
      "iterate_until_mastered_or_visibly_blocked"
    ],
    "closure_rule": "A gap closes only when the benchmark acceptance criteria pass on current evidence.",
    "owner_action_required_for": ["secrets","credentials","paid_calls","provider_account_creation","identity_verification","production_deployment","external_contact","rights_or_consent_ambiguity"]
  },
  "pages_contract": {
    "goal": "Make every canonical repository capability discoverable from GitHub Pages while keeping backend execution separate and truthful.",
    "required_views": ["Buddy","Capabilities","Bots","Divisions","Tools","APIs","Models","Model Progress","Benchmarks","Benchmark Evidence","Actions","Repository Inventory","Runtime Bindings","Backend Health","Sandboxes","Forecasts","Leads","Studio","Personality Controls","Voice Studio","Image Studio","Avatar Library","Film Studio","Music Studio","Safety and Consent","Connections","Datasets","Settings"],
    "evidence_fields": ["source_file","capability_id","state","owner_system","runtime_binding","tests","benchmarks","last_verified","dependencies","fallback","rollback","blocker"]
  },
  "personality_controls": ["warmth","formality","humor","sarcasm","energy","calmness","confidence","assertiveness","empathy","patience","curiosity","creativity","imagination","optimism","realism","seriousness","playfulness","professionalism","directness","verbosity","conciseness","teaching_style","coaching_style","storytelling","negotiation_style","sales_style","leadership_style","collaboration","skepticism","risk_tolerance","detail_orientation","analytical_style","emotional_expressiveness","friendliness","independence","initiative","persistence","adaptability","formal_vocabulary","casual_vocabulary","technical_depth","cultural_sensitivity","motivational_style","conflict_style","decision_style","questioning_style","response_pacing","focus","character_intensity","persona_consistency","overall_persona"],
  "voice_controls": ["pitch","pitch_range","speaking_rate","pauses","breathiness","resonance","brightness","warmth","rasp","clarity","articulation","pronunciation","emphasis","loudness","dynamic_range","cadence","rhythm","emotional_intensity","excitement","calmness","seriousness","friendliness","confidence","age_style","narration_style","conversation_style","character_style","dramatic_intensity","comedic_timing","whisper_level","projection","vocal_texture","accent_style","language","phonemes","pause_length","sentence_emphasis","word_emphasis","question_inflection","statement_inflection","breath_timing","vocal_variation","consistency","expressiveness","naturalness","studio_polish","room_reverb","microphone_character","compression","noise_profile","mastering_level"],
  "image_controls": ["body_type","height","proportions","age_style","facial_structure","eyes","eyebrows","nose","mouth","jaw","skin_appearance","hair","hairstyle","facial_hair","clothing","accessories","footwear","pose","gesture","expression","emotion","lighting","shadows","camera_angle","focal_length","depth_of_field","composition","environment","weather","time_of_day","color_palette","material","texture","realism","stylization","cartoon_level","anime_level","three_d_level","cinematic_level","illustration_level","render_quality","anatomy_fidelity","motion_style","background","foreground","props","visual_effects","art_direction","character_consistency","identity_reference_consistency"],
  "rights_policy": {
    "identity_linked_voice_or_image_requires_permission": true,
    "required_provenance": ["owner","consent","source","license","permitted_use","expiration_or_revocation"],
    "recognition_does_not_imply_permission": true,
    "revocation_must_stop_future_generation": true
  },
  "studio_task_benchmarks": {
    "film_and_hollywood": 100,
    "music_industry": 100,
    "rule": "Each task must have an executable acceptance test before it can be marked implemented or mastered."
  },
  "lazy_activation": {
    "default_network": "off",
    "default_paid_budget_usd": 0,
    "sandbox_first": true,
    "user_approval_for_external_write": true,
    "user_approval_for_paid_provider_use": true,
    "no_automatic_account_creation": true,
    "no_automatic_external_contact": true
  },
  "repository_audit_outputs": ["master-capability-map.json","master-capability-map.html","runtime-binding-report.json","duplicate-system-report.json","benchmark-gap-board.json","studio-capability-board.json","actions-capability-index.json"]
}
