{
  "schema": "dreamco.greenkeeper_system_registry.v1",
  "generation_policy": {
    "max_generation_depth": 1,
    "require_verification_before_activation": true,
    "unknown_is_never_green": true,
    "duplicate_ids_rejected": true
  },
  "systems": [],
  "failure_classes": [
    "workflow",
    "dependency",
    "test",
    "security",
    "benchmark",
    "runtime",
    "review",
    "documentation",
    "unknown"
  ],
  "lifecycle": [
    "DETECTED",
    "TRIAGED",
    "PLANNED",
    "GENERATED",
    "TESTING",
    "VERIFIED",
    "ACTIVE",
    "MONITORED",
    "RETIRED"
  ]
}
