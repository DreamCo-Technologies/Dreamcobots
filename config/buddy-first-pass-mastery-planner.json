{
  "$schema":"dreamco.buddy_first_pass_mastery_planner.v1",
  "purpose":"Maximize the probability that each of Buddy's first 1000 learning targets is mastered on the first serious learning/evaluation pass, without pretending mastery is guaranteed.",
  "campaign":"first_1000",
  "planning_principles":["understand_target_before_learning","decompose_capability_into_testable_subskills","select_best_available_sources_before_execution","prefer_primary_authoritative_sources","use_multiple independent evidence paths","identify dependencies before training","build a target-specific experiment","define success criteria before learning","prepare adversarial and regression tests before promotion","reuse validated knowledge without bypassing target-specific testing"],
  "preflight":["load_target_definition","inspect_existing_buddy_knowledge","inspect_historical_bot_failures","identify_dependencies","identify_conflicting_claims","discover_source_candidates","rank_source_candidates","build_source_diversity_plan","define_expected_gain","define_baseline_test","define_mastery_tests","define_failure_diagnostics","reserve_sandbox_resources"],
  "source_selection":{"minimum_candidate_pool":5,"minimum_independent_evidence_paths":2,"prefer_primary_sources":true,"freshness_weighted":true,"authority_weighted":true,"relevance_weighted":true,"reproducibility_weighted":true,"accessibility_checked":true,"provenance_required":true},
  "first_pass_strategy":{"baseline_before_learning":true,"target_specific_curriculum":true,"dependency_first":true,"retrieval_plus_reasoning_tests":true,"practical_capability_test":true,"adversarial_test":true,"regression_test":true,"cross_source_validation":true,"record_every_assumption":true},
  "mastery":{"overall_score":0.90,"factual_accuracy":0.95,"reproducibility":0.90,"regression_pass_rate":0.95,"provenance_completeness":0.95,"must_pass_capability_specific_test":true},
  "adaptive_reattempt":{"never_repeat_failed_strategy_unchanged":true,"diagnose_failure_before_retry":true,"choose_new_evidence_or_strategy":true,"track_attempt_history":true,"learn_from_failure_memory":true,"escalate_to_specialist_superbot":true,"escalate_to_governance_when_evidence_conflicts":true},
  "success_definition":"A target is mastered only after measured performance meets all required thresholds and the evidence, tests and provenance are retained.",
  "telemetry":["first_pass_score","final_mastery_score","source_quality_score","evidence_diversity","dependency_coverage","test_coverage","failure_reason","attempt_count","strategy_changes","time_to_mastery","cost_to_mastery"]
}
