{
  "schema": "dreamco.studio_benchmark_contract.v1",
  "purpose": "Turn Buddy into a continuously evaluated creative production studio for music, film, video, and multimodal projects.",
  "projects": ["song", "album", "score", "music_video", "short_film", "feature_workflow", "trailer", "commercial", "animation", "game_cinematic"],
  "pipeline": [
    "brief",
    "research",
    "script_or_song_plan",
    "storyboard_or_arrangement",
    "asset_generation",
    "performance_generation",
    "editing",
    "mix_or_sound_design",
    "master_or_color_grade",
    "quality_control",
    "blind_evaluation",
    "benchmark_comparison",
    "gap_analysis",
    "improvement",
    "regression",
    "final_export"
  ],
  "score_dimensions": {
    "creative_intent": 0,
    "craft_quality": 0,
    "technical_quality": 0,
    "consistency": 0,
    "controllability": 0,
    "emotional_impact": 0,
    "professional_readiness": 0,
    "originality": 0,
    "efficiency": 0,
    "reliability": 0
  },
  "required_percentages": [
    "overall_percentage",
    "dimension_percentages",
    "benchmark_percentage",
    "human_evaluation_percentage",
    "automated_evaluation_percentage",
    "confidence_percentage",
    "baseline_delta_points",
    "target_gap_points"
  ],
  "film_requirements": [
    "single_shot_quality",
    "multi_shot_quality",
    "long_form_coherence",
    "character_continuity",
    "cinematic_language",
    "story_continuity",
    "audio_visual_sync",
    "editing_quality"
  ],
  "music_requirements": [
    "composition",
    "songwriting",
    "arrangement",
    "performance",
    "vocal_quality",
    "mixing",
    "mastering",
    "stem_editability",
    "prompt_alignment",
    "human_preference"
  ],
  "comparison_policy": {
    "record_reference_system": true,
    "record_version_and_date": true,
    "use_same_or_equivalent_brief": true,
    "preserve_outputs": true,
    "preserve_failures": true,
    "blind_review_when_possible": true,
    "do_not_cherry_pick": true,
    "separate_benchmark_results_from_marketing_claims": true
  },
  "mastery": {
    "requires_external_benchmark_when_available": true,
    "requires_dreamco_holdout": true,
    "requires_regression": true,
    "requires_reproducible_evidence": true,
    "requires_revalidation": true
  }
}
