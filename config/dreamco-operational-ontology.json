  "governance": {"dynamic_security":true,"minimum_necessary_access":true,"actions_permission_checked":true,"high_impact_actions_approval_gated":true,"all_changes_audited":true,"lineage_required":true,"generated_objects_not_runtime_verified_by_default":true,"government_facts_require_authoritative_source":true,"fiscal_values_require_source_date_and_definition":true},
  "self_modeling": {"enabled":true,"rule":"Buddy may inspect its ontology, propose new object/link/action/function types, and generate migrations when recurring real-world concepts are not represented, but ontology schema changes require tests, compatibility review, and canonical-owner approval.","gap_detection":["untyped recurring entity","orphan resource","capability without tests","task without worker","worker without owner","connection without evidence","gap without builder","business without fulfillment path","data without provenance","government service without authoritative source","department without benchmark","public fiscal value without source date","government job without task map"]},
  "truth_rule": "The ontology is DreamCo's independent operational model inspired by modern object/link/action architectures; it does not copy proprietary Palantir implementation details. Government structures, services, fees, jobs and fiscal records require jurisdiction-specific authoritative sources and generated ontology entries require runtime evidence."
