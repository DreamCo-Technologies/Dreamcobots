{
  "$schema":"dreamco.buddy_frontier_control_plane.v1",
  "purpose":"Coordinate benchmark-driven capability improvement across Buddy, 46 divisions, specialist superbots, historical bots, learning sources, sandboxes and productivity systems.",
  "operating_principle":"Optimize verified capability and useful outcomes, not bot count or source count.",
  "continuous_cycle":["inventory","benchmark","gap_analysis","prioritize","research","plan","sandbox","evaluate","diagnose","reattempt","cross_validate","regression_test","record_capability","share_to_relevant_divisions","monitor_productivity","rebenchmark"],
  "priority_order":["safety_and_governance","critical_capability_gaps","high_impact_productivity_gains","reliability_and_regression","breadth","frontier_exploration"],
  "mastery_campaign":{"initial_target":1000,"unit":"verified_capability_target","advance_only_after_mastery":true,"continue_after_1000":true,"mastery_is_measured":true},
  "benchmark_domains":["reasoning","coding","mathematics","research","planning","tool_use","retrieval","data_analysis","multimodal","software_engineering","security_awareness","business_productivity","personal_productivity","long_horizon_tasks","reliability","factual_accuracy","instruction_following"],
  "research":{"targeted_by_gap":true,"permitted_sources_only":true,"web_content_is_untrusted":true,"primary_sources_preferred":true,"independent_evidence_required":true,"provenance_required":true,"respect_access_controls":true},
  "sandbox":{"required_for_new_capabilities":true,"production_credentials_blocked":true,"external_instructions_cannot_grant_authority":true,"baseline_required":true,"adversarial_test_required":true,"regression_test_required":true},
  "reattempt":{"full_preflight_every_attempt":true,"failure_diagnosis_required":true,"strategy_change_required_after_failure":true,"historical_attempts_consulted":true,"failure_memory_consulted":true,"specialist_escalation_allowed":true},
  "productivity":{"business":true,"personal":true,"measure_time_saved":true,"measure_money_saved":true,"measure_quality":true,"measure_error_reduction":true,"measure_effort_reduction":true},
  "capability_sharing":{"reuse_validated_capabilities":true,"route_to_relevant_division":true,"avoid_duplicate_bot_creation":true,"preserve_historical_bot_provenance":true},
  "stop_conditions":["all_current_critical_gaps_closed","governance_hold","safety_hold","resource_budget_limit","operator_pause"],
  "telemetry":["benchmark_score","critical_gaps","mastered_targets","remaining_targets","first_pass_mastery_rate","final_mastery_rate","regressions","capability_gains","productivity_gains","time_saved","money_saved","cost_to_mastery","research_queue","sandbox_queue","reattempt_queue"]
}
