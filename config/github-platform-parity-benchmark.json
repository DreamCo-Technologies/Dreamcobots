{
  "schema": "dreamco.github_platform_parity_benchmark.v1",
  "version": "1.0.0",
  "mission": "Benchmark DreamCo/Buddy against major GitHub platform capabilities while building simpler local/open-source equivalents. GitHub integrations may remain available, but core DreamCo development must not depend on GitHub.",
  "benchmark_policy": [
    "Use current GitHub documentation and executable repository evidence.",
    "Mark a feature implemented only when required evidence exists and its tests/runtime proof are available.",
    "Hosted GitHub-scale infrastructure is benchmarked by user capability, not falsely claimed identical architecture.",
    "Every partial/gap feature receives a builder plan and sandbox tests.",
    "Prefer a simpler owner experience than GitHub while keeping power-user/API access."
  ],
