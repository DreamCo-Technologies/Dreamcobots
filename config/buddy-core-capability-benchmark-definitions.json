  "benchmarks": [
    {
      "benchmark_id": "BUDDY-REASONING-001",
      "capability_id": "reasoning",
      "objective": "Solve multi-step problems with explicit assumptions, valid intermediate steps, and calibrated uncertainty.",
      "dimensions": [
        "problem_framing",
        "logical_validity",
        "assumption_tracking",
        "uncertainty_calibration",
        "transfer"
      ],
      "task_design": {
        "levels": [
          "single_constraint",
          "multi_constraint",
          "ambiguous_evidence"
        ],
        "holdout": "Use unseen problem instances and changed surface details; do not reuse worked examples as test items.",
        "failure_cases": [
          "contradictory premises",
          "missing information",
          "invalid inference"
        ]
      },
      "rubric": [
        {
          "dimension": "problem_framing",
          "weight": 20
        },
        {
          "dimension": "logical_validity",
          "weight": 30
        },
        {
          "dimension": "assumption_tracking",
          "weight": 20
        },
        {
          "dimension": "uncertainty_calibration",
          "weight": 15
        },
        {
          "dimension": "transfer",
          "weight": 15
        }
      ],
      "pass_threshold": 80,
      "critical_gates": [
        "No fabricated premises",
        "Explicitly flag underdetermined conclusions"
      ],
      "execution_status": "definition_ready_adapter_pending"
    },
