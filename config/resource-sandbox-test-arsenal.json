{
  "schema": "dreamco.resource_sandbox_test_arsenal.v1",
  "version": "1.0.0",
  "mission": "Provide a large reusable sandbox test library for every canonical DreamCo resource category before Buddy treats any catalog, connector, source, provider, directory, financial resource, marketplace, API, dataset, or external service as verified.",
  "shared_test_families": {
    "identity_and_classification": ["resource id present","name present","canonical resource type","category tags present","purpose present","jurisdiction normalized","duplicate id detection","duplicate resource detection","ambiguous type flagged","deprecated resource state handled"],
    "source_and_provenance": ["source reference present","official source preferred","source host recorded","source retrieval date recorded","source version recorded where applicable","secondary source labeled","conflicting sources flagged","dead link handling","redirect handling","source ownership identified"],
    "freshness": ["last checked timestamp","staleness threshold","expired deadline detection","changed terms detection","changed pricing detection","changed eligibility detection","changed contact detection","changed API version detection","removed resource detection","refresh failure visible"],
    "permissions_and_access": ["read-only first","missing permission denied safely","insufficient scope denied safely","revoked permission handled","expired token handled","wrong account context handled","cross-user isolation","cross-tenant isolation","write action approval gate","destructive action blocked by default"],
    "credentials_and_secrets": ["no raw secret in catalog","secret reference format","missing secret reference","invalid secret reference","expired credential","revoked credential","credential redaction in logs","credential not placed in URL","secret rotation compatibility","production credential blocked in sandbox"],
    "network_and_resilience": ["DNS failure","TLS failure","HTTPS requirement","timeout","connection reset","temporary 500","502","503","504","bounded retry","exponential backoff","jitter","cancellation","circuit breaker","offline behavior","rate limit","Retry-After handling","provider outage status","partial response","oversized response"],
    "schema_and_data_quality": ["response parse","required fields","wrong type","missing field","null field","unknown field","invalid enum","invalid date","Unicode handling","empty response","duplicate records","near duplicate records","contradictory records","outlier flagging","normalization","stable identifier mapping","round-trip serialization","export integrity","corrupt record handling","truncated record handling"],
    "privacy": ["minimum necessary data","PII classification","sensitive data classification","no unnecessary retention","redaction","user delete request","user export request","retention policy","private data not placed in public logs","contact data purpose limitation","location precision minimization","living-person privacy where relevant"],
    "security": ["malicious URL input","unsafe redirect","path traversal-like input","header injection-like input","prompt injection in resource text","malware/archive marker handling","unexpected executable content","secret leakage scan","excessive data exposure","authorization bypass attempt","mass assignment-like fields","audit trail tamper resistance"],
    "contact_and_outreach": ["contact provenance","contact channel type","contact freshness","unverified contact label","opt-out respected","do-not-contact respected","draft-only default","single-message approval","bulk outreach blocked","spam-pattern detection","wrong recipient prevention","outreach audit receipt"],
    "cost_and_money": ["cost field normalized","fee disclosure","hidden-fee flag","currency handling","zero cost handling","estimated versus actual cost distinction","budget cap","paid action approval","duplicate charge prevention","refund/cancellation terms captured","recurring cost identified","free trial expiration surfaced"],
    "eligibility_and_requirements": ["requirements present","unknown eligibility surfaced","eligibility screening not determination","missing requirement handled","conflicting requirement handled","geographic eligibility","age/business status where relevant","income threshold where relevant","credential/license requirement","deadline requirement","document checklist","no guaranteed acceptance"],
    "search_and_matching": ["exact search","partial search","synonym search","category filter","location filter","cost filter","eligibility filter","deadline filter","no-result behavior","ranking stability","user-fit score explanation","duplicate result suppression","freshness weighting","official-source weighting"],
    "comparison": ["normalized fields","apples-to-apples comparison","missing values visible","different currencies normalized","different time periods normalized","fee-inclusive comparison","risk comparison","evidence strength comparison","freshness comparison","user-fit comparison","exportable comparison","winner not declared when evidence insufficient"],
    "audit_and_observability": ["request id","resource id","source id","timestamp","test id","status","failure class","latency","retry count","permission scope","cost estimate","evidence reference","no secret in logs","blocked action recorded","manual approval recorded","last verified surfaced"],
    "failure_and_recovery": ["resource unavailable","resource moved","resource deprecated","adapter unavailable","schema drift","permission revoked","rate limit exhaustion","stale cache","bad cache entry","partial index failure","duplicate ingestion","recovery after retry","fallback source","manual handoff","failure remains visible"],
    "user_experience": ["plain-language description","next step present","requirements understandable","cost understandable","deadline understandable","risk understandable","source link available","save resource","compare resource","export resource","remove saved resource","accessibility label","mobile-friendly result","no misleading urgency"],
    "sandbox_boundaries": ["no production write","no real application submission","no real purchase","no real transfer","no live outreach","no destructive account change","synthetic fixtures preferred","provider sandbox preferred","read-only public endpoint permitted when approved","test credentials only","side effects recorded","sandbox data removable"]
  },
  "category_scenarios": {
    "official_agency": ["official domain match","jurisdiction mismatch","program closed","program renamed","deadline changed","eligibility changed","official contact changed","unofficial mirror rejected"],
    "association": ["membership eligibility","dues freshness","chapter location","industry mismatch","public member directory rules","sponsorship claim","contact opt-out","inactive association"],
    "directory": ["business directory lookup","personal directory minimum fields","bulk scraping blocked","private person lookup rejected when purpose invalid","duplicate listing","stale phone","stale address","directory terms captured"],
    "vendor": ["vendor identity","product/service match","pricing freshness","minimum order","lead time","returns","business verification","duplicate vendor record"],
    "supplier": ["MOQ","unit price tiers","lead time","shipping region","inventory uncertainty","sample request draft","quote comparison","supplier fraud indicator"],
    "marketplace": ["listing active","seller role","buyer role","platform fee","shipping fee","return terms","transaction blocked in sandbox","duplicate listing"],
    "funding": ["funding type","eligibility","amount range","fees","repayment or nonrepayment distinction","deadline","no guaranteed funding","application draft only"],
    "grant": ["official opportunity id","deadline","eligible applicant type","award range","matching funds","required documents","no guaranteed award","submission blocked in sandbox"],
    "loan": ["APR","fees","term","payment estimate","secured versus unsecured","eligibility uncertainty","no guaranteed approval","application blocked in sandbox"],
    "investor": ["investor type","stage fit","check-size range","industry fit","public contact provenance","pitch draft only","mass outreach blocked","investment outcome not guaranteed"],
    "accelerator": ["cohort deadline","program length","location","equity terms","fees","stage eligibility","application draft","closed cohort"],
    "incubator": ["program scope","workspace availability","mentorship availability","cost","location","eligibility","application handoff","inactive program"],
    "standards_body": ["standard id","version","superseded standard","official publication","access/license","effective date","jurisdiction relevance","draft versus final"],
    "education": ["provider identity","course active","cost","duration","credential claim","prerequisite","learning outcome","refund policy"],
    "research": ["citation","publication date","author/source","study type","reproducibility","conflicting study","retraction flag","evidence strength"],
    "licensing": ["rights holder","allowed use","commercial use","redistribution","training use","attribution","expiration","revocation"],
    "insurance": ["coverage type","premium estimate","deductible","exclusion","coverage limit","jurisdiction","quote is not binding","purchase blocked in sandbox"],
    "legal_support": ["jurisdiction","provider identity","service scope","fee model","conflict disclaimer","legal advice boundary","official license source where relevant","contact draft only"],
    "accounting": ["calculation fixture","currency precision","negative amount","rounding","duplicate transaction","missing category","export integrity","tax advice boundary"],
    "banking": ["read-only balance fixture","transaction normalization","duplicate charge","unusual amount","recurring charge","fraud flag is not determination","money transfer blocked","raw credential blocked"],
    "logistics": ["origin/destination","route unavailable","shipping estimate","tracking update","delayed shipment","lost shipment state","carrier comparison","purchase blocked"],
    "import_export": ["origin country","destination country","classification source","tariff freshness","restricted item flag","documentation checklist","regulatory disclaimer","rule change detection"],
    "government_contracting": ["solicitation id","official source","deadline","NAICS/category match","entity requirement","set-aside eligibility uncertainty","proposal draft","submission blocked"],
    "community": ["service area","hours","eligibility","capacity/waitlist","contact freshness","accessibility","closed service","alternative resource fallback"],
    "professional_network": ["professional identity","public profile source","industry fit","location fit","consent before outreach","private-person dossier blocked","duplicate profile","stale profile"],
    "software": ["version","license","dependency health","security advisory","install sandbox","upgrade sandbox","rollback sandbox","unsupported runtime"],
    "api": ["health","schema","auth","invalid auth","rate limit","timeout","retry","idempotency","pagination","webhook signature","stream cancellation","version drift"],
    "data_source": ["provenance","license","schema","missing values","duplicates","near duplicates","PII","secrets","contamination","train-test leakage","freshness","reproducible download/build"],
    "other": ["classification attempt","manual risk review","permission review","source review","privacy review","cost review","sandbox-only status","promotion blocked until categorized"]
  },
  "execution_policy": {
    "run_shared_tests_for_every_resource": true,
    "run_category_scenarios_for_matching_type": true,
    "parallelize_independent_tests": true,
    "max_parallel_lanes": 20,
    "provider_rate_limits_override_parallelism": true,
    "writes_serialized": true,
    "failures_remain_visible": true,
    "not_applicable_requires_reason": true,
    "live_verified_requires_runtime_evidence": true
  },
  "promotion_levels": ["declared","catalog_verified","sandbox_verified","adapter_verified","runtime_verified","production_observed"],
  "truth_rule": "This arsenal defines test coverage. A test counts as executed only when an approved runner records evidence against a local fixture, mock, sandbox, staging environment, authorized read-only source, or approved live adapter."
}
