{
  "schema": "dreamco.buddy_engineering_capabilities.v1",
  "version": "1.1.0",
  "objective": "Define evidence-backed Buddy capabilities for software engineering, authorized reverse engineering, model distillation and weight training, physical product invention, hardware/software prototyping, 3D design, and end-to-end startup creation across all canonical MasterBot lanes.",
  "capabilities": {
