        "implementation_plan",
        "changed_files_and_diff",
        "test_results",
        "security_findings",
        "traceability_manifest",
        "rollback_plan"
      ],
      "autonomy": "may_prepare_changes_and_pull_requests; merge_and_production_release_require_explicit_approval"
