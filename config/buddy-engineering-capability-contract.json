      "concept_tradeoffs_and_bom_reviewed",
      "prototype_test_plan_defined",
      "measured_tests_and_failure_analysis_recorded",
      "safety_and_compliance_risks_reviewed"
    ],
    "hardware_software_prototyping": [
      "hardware_firmware_software_interfaces_documented",
      "component_datasheets_and_limits_verified",
      "prototype_build_is_reproducible",
      "bench_and_interoperability_tests_recorded",
      "electrical_mechanical_and_operational_safety_review_passes"
    ],
    "three_dimensional_invention": [
      "editable_source_and_exports_versioned",
      "dimensions_tolerances_and_materials_documented",
      "geometry_and_fabrication_checks_pass",
      "physical_prototype_measured_when_required",
      "structural_safety_claims_independently_reviewed"
    ],
    "startup_creation": [
      "customer_problem_and_segment_evidence_recorded",
      "market_claims_cited_and_assumptions_visible",
      "unit_economics_and_cash_scenarios_reviewed",
      "funding_and_resource_leads_verified",
      "legal_tax_and_regulatory_questions_identified",
      "launch_plan_and_success_metrics_defined"
    ]
  },
  "non_goals": [
    "no claim that these contracts alone implement execution backends",
    "no automatic merge or deployment",
    "no unrestricted reverse engineering",
    "no training on private conversations without separate purpose-specific opt-in",
    "no automatic production weight replacement",
    "no claim that CAD, simulation, or generated designs are physically validated until tested",
    "no claim of patentability, regulatory approval, grant eligibility, or guaranteed business success",
    "no purchase, contract, funding application, company formation, or external commitment without explicit approval"
  ]
