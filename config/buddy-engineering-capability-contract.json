        "natural_language_goal",
        "repository_context",
        "acceptance_criteria",
        "constraints"
      ],
      "stages": [
        "clarify_and_scope",
        "inspect_repository_and_dependencies",
        "create_implementation_plan",
        "map_requirements_to_files_tests_routes_benchmarks",
