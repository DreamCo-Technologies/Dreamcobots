        "funding_and_grants",
        "loans_and_microfinance",
        "incubators_and_accelerators",
        "mentors_and_professional_services",
        "workspace_and_makerspaces",
        "equipment_and_software",
        "materials_and_suppliers",
        "contract_manufacturers",
        "testing_and_certification_labs",
        "talent_and_contractors",
        "distribution_and_marketplaces",
        "insurance_and_compliance",
        "government_and_local_business_resources"
