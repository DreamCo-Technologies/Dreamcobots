      "cell_id",
      "grade_band_id",
      "grade",
      "subject_id",
      "strand_id",
      "title",
      "learning_outcomes",
      "standard_refs",
      "bootcamp_lesson_ids",
      "lp_pack_ids",
      "oer_policy",
      "provenance"
    ],
    "id_pattern": "K12-{SUBJECT}-{GRADE}-{STRAND}-{NNN} (e. and K12-MATH-03-number-001)",
    "oer_policy_enum": [
      "public_domain",
      "cc_by",
      "cc_by_sa",
      "us_government_work",
      "dreamco_original",
      "blocked_no_rights"
    ]
  },
  "bootcamp_bridge": {
    "inherits": "config/buddy-bootcamp-curriculum-v1.json",
    "pipeline": [
      "discover",
      "classify",
      "rights_check",
      "extract_concepts",
      "synthesize",
      "lesson",
      "practice",
      "sandbox",
      "transfer",
      "score",
      "remediate",
      "regression",
      "evidence"
    ],
    "training_unit_required": [
      "capability_id",
      "objective",
      "lesson",
      "practice",
      "sandbox_task",
      "transfer_task",
      "rubric",
      "benchmark",
      "provenance"
    ],
    "source_policy": {
      "permitted_only": true,
      "provenance_required": true,
      "redistribution_rights_required": true,
      "copyright_reproduction_prohibited": true
    },
    "map_rule": "Each cell may spawn \u22651 training_unit; rights_check must pass before lesson synthesis"
  },
  "lp_bridge": {
    "pack_id_pattern": "LP-K12-{SUBJECT}-{BAND}-{slug}",
    "graduation_gates": [
      "repeat_pass",
      "held_out_transfer",
      "no_active_regression",
      "fresh_evidence"
    ],
    "export_requires": [
      "provenance",
      "license_or_usage_basis",
      "cell_ids",
      "bootcamp_lesson_ids",
      "rubric",
      "benchmark_ids"
    ],
    "ci_hint": ".github/workflows/buddy-hub-learning-packages.yml"
  },
  "standard_refs_policy": {
    "allowed": "Public standards identifiers + official free URLs only (e.g. CCSS/NGSS public pages)",
    "forbidden": "Pasting proprietary curriculum text, paid textbooks, or closed item banks",
    "fields": [
      "framework",
      "code",
      "url",
      "license_note"
    ]
  },
