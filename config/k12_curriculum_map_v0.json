{
  "schema": "dreamco.k12_curriculum_map.v0",
  "owner": "Grok-Edu-K12-Curriculum",
  "status": "draft_spine",
  "mission": "Own the K-12 full curriculum map (all grades \u00d7 subjects) \u2192 Buddy Bootcamp lessons + LP packs. Provenance-safe / OER-or-original only. Does not claim state adoption or accredited school programs.",
  "sources_of_truth": {
    "education_engine": "config/buddy_education_universal_engine.json",
    "bootcamp_curriculum": "config/buddy-bootcamp-curriculum-v1.json",
    "bootcamp_program": "config/buddy-bootcamp-program.json",
    "bootcamp_yaml": "buddy/bootcamp/buddy_bootcamp.yaml",
    "provenance": "config/evidence_provenance_schema.json",
    "college_sibling_pattern": "workspace:/workspace/college-catalog/college_course_universe_v0.json (mirror structure; do not mix levels)",
    "learning_packages_ci": ".github/workflows/buddy-hub-learning-packages.yml"
  },
  "truth_rules": [
    "OER / public-domain / US-gov / DreamCo-original only; no copyrighted textbook or course dumps",
    "provenance_required on every cell, lesson, and LP export (inherit bootcamp source_policy)",
    "Standards alignment (e.g. CCSS/NGSS) is reference metadata \u2014 not a license to reproduce proprietary materials",
    "Mastery never from reading-only (inherit bootcamp mastery gates)",
    "Catalog coverage \u2260 mastery; LP graduation needs repeat pass + holdout + no regression + fresh evidence",
    "K-12 map is separate from college_course_universe; do not collapse grade bands into college domains"
  ],
  "layers": {
    "grade_bands": "Learner bands mapped from education_universal_engine.learner_stages",
    "subjects": "Core K-12 subject families (DreamCo IDs; not a single state's course codes)",
    "cells": "Atomic map units: grade_band \u00d7 subject (+ optional strand)",
    "standard_clusters": "Optional OER-safe standards references (ids + URLs only; no proprietary text)",
    "lessons": "Bootcamp training_units produced from cells",
    "lp_packs": "Exportable learning packages (LP-*) graduated from Bootcamp evidence"
  },
