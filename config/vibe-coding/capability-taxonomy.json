{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "name": "DreamCo Massive Vibe-Coding Capability Taxonomy",
  "purpose": "Canonical taxonomy for Buddy to classify, plan, generate, test, ship, operate, learn, and cross-combine projects across software, media, AI, hardware, engineering, business, and physical-world domains.",
  "evidence_lifecycle": ["idea", "generated", "executed", "tested", "verified", "deployed", "real_world_validated"],
  "top_level_categories": [
    "Games", "Software", "Websites", "Mobile Apps", "AI & Agents", "Education", "Video", "Movies & Film", "Advertising", "Social Media",
    "Writing & Publishing", "Design", "Hardware", "Electrical Engineering", "Manufacturing", "Robotics", "Smart Home / IoT", "Automotive",
    "Engineering", "Business", "Finance / FinTech", "E-Commerce", "Real Estate", "Healthcare Technology", "Science", "Environment",
    "Maps / Geography", "Travel", "Music", "Audio", "VR / AR / XR", "Simulation", "Aerospace / Space", "Cybersecurity", "Cloud / Infrastructure",
    "Developer Tools", "APIs / Platforms", "Data", "Analytics", "Productivity", "Government / Civic Tech", "Legal Technology", "Career / Workforce",
    "Local Business Systems", "Logistics", "Industrial Automation", "Virtual Worlds", "Creator Economy", "News / Media", "Physical Products"
  ],
  "category_families": {
    "CREATE": ["Software", "Websites", "Mobile Apps", "Games", "AI & Agents", "Hardware", "Robotics", "Video", "Movies & Film", "Music", "Audio", "Writing & Publishing", "Design", "Education", "Business", "Science", "Engineering", "Simulation", "VR / AR / XR", "Physical Products"],
    "OPERATE": ["Cloud / Infrastructure", "Developer Tools", "APIs / Platforms", "Data", "Analytics", "Productivity", "Business", "Local Business Systems", "Logistics", "Industrial Automation", "Smart Home / IoT", "Automotive"],
    "LEARN": ["AI & Agents", "Education", "Science", "Analytics", "Developer Tools", "Simulation", "Cybersecurity", "Engineering"],
    "SHIP": ["Manufacturing", "E-Commerce", "Advertising", "Social Media", "Creator Economy", "News / Media", "Business", "Physical Products", "Cloud / Infrastructure"]
  },
  "required_project_contract": {
    "inputs": ["user_intent", "target_category", "constraints", "budget", "platform", "audience", "success_criteria"],
    "planning": ["requirements", "architecture", "dependencies", "skills", "tools", "models", "workflow", "risk_register", "test_plan"],
    "outputs": ["source", "assets", "documentation", "tests", "deployment_artifacts", "analytics", "support_plan"],
    "gates": ["static_validation", "unit_tests", "integration_tests", "sandbox_verification", "benchmark_verification", "regression_verification", "production_verification", "real_world_validation"]
  },
  "cross_combine_engine": {
    "enabled": true,
    "mode": "vibe_to_company",
    "description": "Buddy decomposes an idea into coordinated products and operations, then links them into one executable portfolio instead of generating an isolated artifact.",
    "composable_outputs": ["core_product", "website", "mobile_app", "desktop_app", "AI_agents", "voice_agent", "community", "analytics", "content", "trailers", "advertising", "ecommerce", "payments", "customer_support", "documentation", "deployment", "monitoring", "updates", "manufacturing", "education", "simulation", "hardware", "firmware", "cloud_backend"],
    "example_blueprints": {
      "game_company": ["game", "website", "mobile_companion", "AI_NPCs", "multiplayer", "trailer", "short_form_content", "ads", "community", "merchandise", "marketplace", "analytics", "support", "updates"],
      "hardware_startup": ["requirements", "system_architecture", "schematic", "PCB", "firmware", "simulation", "BOM", "manufacturing_files", "prototype_plan", "test_plan", "mobile_app", "cloud_backend", "website", "packaging", "manual", "commercial", "ads", "ecommerce"],
      "movie_studio": ["story", "screenplay", "characters", "storyboard", "concept_art", "sets", "animation", "VFX", "soundtrack", "trailer", "poster", "website", "social_campaign", "ads", "streaming_interface", "merchandise"],
      "education_company": ["curriculum", "lessons", "videos", "interactive_textbook", "AI_tutor", "games", "quizzes", "student_dashboard", "teacher_dashboard", "assessments", "certificates", "mobile_app", "website", "marketing", "subscription_system"]
    }
  },
  "implementation_rule": "The taxonomy is a routing and verification contract, not a claim that every capability is already production-complete. Buddy must attach evidence to every capability and surface blockers instead of fabricating completion."
}
