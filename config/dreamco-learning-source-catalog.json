{
  "schema": "dreamco.learning_source_catalog.v1",
  "version": "1.0.0",
  "purpose": "Canonical cross-platform and repository-native source catalog for task-routed learning and original DreamCo synthesis.",
  "policy": {
    "discovery_is_not_access": true,
    "repository_presence_is_not_ownership": true,
    "unknown_rights_are_reference_only": true,
    "copy_source_course_content": false,
    "synthesize_original_lessons": true,
    "require_provenance_for_every_derived_asset": true,
    "require_owner_approval_for_paid_compute": true,
    "never_train_on_holdouts": true
  },
  "repository_collections": [
    {
      "id": "buddy_learning",
      "name": "Buddy learning policies and study evidence",
      "paths": [
        "buddy/learning/",
        "buddy/bootcamp/"
      ],
      "domains": [
        "learning",
        "model_training",
        "capability_acquisition"
      ]
    },
    {
      "id": "study_packs",
      "name": "Study packs and authored curricula",
      "paths": [
        "study_packs/"
      ],
      "domains": [
        "courseware",
        "practice",
        "occupational_learning"
      ]
    },
    {
      "id": "benchmarks",
      "name": "Benchmarks, tasks, and source registries",
      "paths": [
        "benchmarks/",
        "evidence/"
      ],
      "domains": [
        "evaluation",
        "holdouts",
        "source_quality"
      ]
    },
    {
      "id": "dreamco_knowledge",
      "name": "DreamCo knowledge assets and package manifests",
      "paths": [
        "data/dreamco_knowledge/"
      ],
      "domains": [
        "synthesized_knowledge",
        "dataset_packages",
        "provenance"
      ]
    },
    {
      "id": "training_methodology",
      "name": "DreamCo training methodology",
      "paths": [
        "docs/training-methodology/",
        "docs/BUDDY_SANDBOX_BOOTCAMP_DATA_PACKAGE.md"
      ],
      "domains": [
        "knowledge_synthesis",
        "bootcamp",
        "learning_science"
      ]
    },
    {
      "id": "capability_library",
      "name": "Capability packages and competency maps",
      "paths": [
        "capabilities/",
        "config/buddy-bootcamp-program.json",
        "config/buddy-college-curriculum.json",
        "config/onet-priority-curriculum.json"
      ],
      "domains": [
        "skills",
        "occupations",
        "capabilities"
      ]
    },
    {
      "id": "data_governance",
      "name": "Dataset discovery, provenance, and rights policies",
      "paths": [
        "config/data-discovery-bot-program.json",
        "config/dataset_product_standard.json",
        "config/buddy-training-data-provenance-policy.json",
        "config/license_provenance_gate.json",
        "schemas/data_package_"
      ],
      "domains": [
        "data_governance",
        "privacy",
        "licensing"
      ]
    }
  ],
