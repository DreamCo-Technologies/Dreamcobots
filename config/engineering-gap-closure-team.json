{
  "schema": "dreamco.engineering_gap_closure_team.v1",
  "version": "1.0.0",
  "mission": "Continuously close DreamCo engineering gaps with specialist builders working in parallel, shared-infrastructure-first design, evidence-driven repair, security review, rollback, and measurable completion gates.",
  "team": [
    {"id":"chief_architect","owns":["architecture","canonical ownership","cross-system boundaries","shared infrastructure"]},
    {"id":"ci_reliability_builder","owns":["GitHub Actions","local runners","build failures","test orchestration","artifacts","failure detection"]},
    {"id":"platform_builder","owns":["repositories","APIs","webhooks","packages","releases","deployment adapters","self-hosted platform"]},
    {"id":"developer_experience_builder","owns":["plain-language updates","mobile-first workflows","CLI","local-first UX","documentation","onboarding"]},
    {"id":"security_builder","owns":["CodeQL/static analysis","dependency security","secret safety","permissions","supply chain","sandbox isolation"]},
    {"id":"sandbox_qa_builder","owns":["universal sandbox","negative tests","regressions","cross-device tests","API/task compatibility","quality gates"]},
    {"id":"performance_builder","owns":["latency","throughput","memory","CPU","network","cost","parallelism","caching"]},
    {"id":"data_model_builder","owns":["data packages","open-source model evaluation","training recipes","model routing","provenance","licenses"]},
    {"id":"agent_runtime_builder","owns":["agents","bot tools","function calling","multi-agent handoffs","memory","offline workers"]},
    {"id":"deployment_builder","owns":["prototype-to-live","Pages","static hosts","containers","serverless","mobile/desktop packaging","rollback"]},
    {"id":"business_system_builder","owns":["bot business-owner workflows","Stripe test flows","marketing simulations","sales/fulfillment/support systems"]},
    {"id":"open_source_builder","owns":["GitHub parity","fork/import/sync","open-source discovery","community tooling","licenses"]},
    {"id":"observability_builder","owns":["logs","metrics","failure reports","health checks","debug evidence","audit trails"]},
    {"id":"migration_compatibility_builder","owns":["dependency upgrades","schema compatibility","version drift","backward compatibility","rollback migrations"]},
    {"id":"red_team_reviewer","owns":["adversarial review","unsafe assumptions","security/privacy failures","failure injection"]},
    {"id":"release_reviewer","owns":["acceptance evidence","regression results","known risks","release/merge recommendation"]}
  ],
  "parallel_policy": {
    "maximum_parallel_lanes": 32,
    "maximum_parallel_candidates_per_gap": 5,
    "same_canonical_owner_serialized": true,
    "independent_owners_parallel": true,
    "shared_infrastructure_first": true,
    "fail_fast_on_release_blockers": true
  },
  "gap_sources": [
    "GitHub parity benchmark gaps",
    "failed Actions/local runs",
    "sandbox failures",
    "bot capability gaps",
    "division benchmark gaps",
    "dependency/version drift",
    "deployment failures",
    "security/privacy findings",
    "performance regressions",
    "open-source competitor advances",
    "notes-to-code backlog",
    "user-reported defects"
  ],
  "gap_lifecycle": [
    "discover",
    "deduplicate",
    "classify",
    "assign canonical owner",
    "assign specialist lane",
    "write acceptance criteria",
    "write sandbox/regression tests",
    "capture baseline",
    "spawn parallel repair/build candidates when owners do not conflict",
    "security/red-team review",
    "run focused tests",
    "run affected-suite tests",
    "compare before/after quality and efficiency",
    "verify rollback",
    "promote shared improvements",
    "update benchmark/Council status",
    "close only with executable evidence"
  ],
  "completion_gate": [
    "canonical owner identified",
    "root cause or capability gap recorded",
    "acceptance tests exist",
    "sandbox/negative tests exist",
    "security/privacy/permission boundaries reviewed",
    "focused tests pass",
    "affected regression suite passes",
    "no meaningful regression introduced",
    "rollback or safe revert path exists",
    "before/after benchmark evidence exists",
    "shared-fleet dependents retested when applicable",
    "runtime evidence recorded"
  ],
  "priority_order": [
    "security/privacy/permission release blocker",
    "broken build/test/deploy",
    "data-loss or destructive-risk defect",
    "widely shared infrastructure gap",
    "high-frequency user task gap",
    "GitHub/platform parity gap",
    "major competitor/open-source gap",
    "business/revenue workflow gap",
    "performance/cost gap",
    "long-horizon research improvement"
  ],
  "truth_rule": "Parallel builders may accelerate independent work, but source-code gaps are not closed until executable evidence passes. The team must not weaken tests, hide failures, or merge conflicting changes merely to increase throughput."
}
