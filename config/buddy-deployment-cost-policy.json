{
  "version": "1.0.0",
  "default_mode": "static_prototype",
  "monthly_hosting_target_usd": 0,
  "deployment": {
    "public_directory": "website",
    "automatic_provider_deployments": false,
    "manual_release_required": true,
    "serverless_functions": false,
    "scheduled_host_jobs": false,
    "provider_managed_database": false,
    "provider_image_transforms": false
  },
  "runtime": {
    "local_first": true,
    "external_compute_requires_owner_approval": true,
    "paid_provider_action_requires_exact_cost_and_owner_approval": true,
    "monthly_paid_budget_usd": 0
  },
  "cost_controls": {
    "github_artifact_retention_days": 1,
    "maximum_public_site_mib": 50,
    "cache_static_assets": true,
    "deploy_only_after_local_preflight": true
  },
  "boundaries": [
    "The static site is a public prototype and does not run the private Buddy backend.",
    "Authentication, payments, private data, rendering, and model calls require separately approved services.",
    "A free provider plan may restrict commercial use; the owner must verify plan terms before selling access."
  ]
}
