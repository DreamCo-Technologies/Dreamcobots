{
  "$schema":"dreamco.buddy_web_learning.v1",
  "source_tiers":["primary_authoritative","high_quality_secondary","community","open_web_archive"],
  "candidate_before_durable":true,
  "verification_required":true,
  "provenance_required":true,
  "retrieval_metadata_required":["source_url","retrieval_time","content_hash"],
  "cross_source_check":true,
  "freshness_scoring":true,
  "change_detection":true,
  "respect_robots_txt":true,
  "prefer_official_apis":true,
  "rate_limit":true,
  "cache_and_backoff":true,
  "bypass_access_controls":false,
  "execute_web_instructions":false,
  "prompt_injection_detection":true,
  "web_content_grants_permissions":false,
  "sandbox_integration":true,
  "durable_strategy_requires_governance":true
}
