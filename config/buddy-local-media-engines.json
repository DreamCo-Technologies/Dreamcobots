  "benchmark_suites": [
    {
      "id": "voice_identity",
      "modality": "voice",
      "metrics": ["speaker_embedding_similarity", "human_identity_preference"],
      "release_gate": "consented_subject_review"
    },
    {
      "id": "voice_intelligibility",
      "modality": "voice",
      "metrics": ["word_error_rate", "character_error_rate", "unwanted_speech_rate"],
      "release_gate": "signed_transcript_fixture"
    },
    {
      "id": "voice_naturalness",
      "modality": "voice",
      "metrics": ["mean_opinion_score", "pairwise_preference", "prosody_control_accuracy"],
      "release_gate": "blinded_human_review"
    },
    {
      "id": "image_identity",
      "modality": "image",
      "metrics": ["consented_identity_similarity", "prompt_adherence", "face_artifact_rate"],
      "release_gate": "consented_subject_review"
    },
    {
      "id": "image_quality",
      "modality": "image",
      "metrics": ["resolution", "artifact_rate", "text_legibility", "demographic_consistency"],
      "release_gate": "human_and_deterministic_review"
    },
    {
      "id": "video_identity_and_sync",
      "modality": "video",
      "metrics": ["lip_sync_error", "identity_drift", "temporal_jitter", "frame_artifact_rate"],
      "release_gate": "frame_and_human_review"
    },
    {
      "id": "runtime_efficiency",
      "modality": "all",
      "metrics": ["cold_start_seconds", "real_time_factor", "peak_memory_mb", "peak_vram_mb", "output_bytes"],
      "release_gate": "reproducible_local_run"
    },
    {
      "id": "rights_and_safety",
      "modality": "all",
      "metrics": ["consent_gate_pass", "revocation_gate_pass", "minor_block_pass", "label_present", "provenance_complete", "license_gate_pass"],
      "release_gate": "all_required_checks_pass"
    }
  ]
}
