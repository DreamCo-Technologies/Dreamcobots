  "benchmark_suites": [
    {
      "id": "voice_identity",
      "modality": "voice",
      "metrics": ["speaker_embedding_similarity", "human_identity_preference"],
      "release_gate": "consented_subject_review"
    },
    {
      "id": "voice_intelligibility",
      "modality": "voice",
      "metrics": ["word_error_rate", "character_error_rate", "unwanted_speech_rate"],
      "release_gate": "signed_transcript_fixture"
    },
    {
      "id": "voice_naturalness",
      "modality": "voice",
      "metrics": ["mean_opinion_score", "pairwise_preference", "prosody_control_accuracy"],
      "release_gate": "blinded_human_review"
    },
    {
      "id": "voice_music_performance",
      "modality": "voice",
      "metrics": ["rhythmic_alignment", "pitch_contour_accuracy", "sustained_vowel_stability", "breath_artifact_rate", "style_control_accuracy"],
      "release_gate": "original_fixture_and_consented_performer_review"
