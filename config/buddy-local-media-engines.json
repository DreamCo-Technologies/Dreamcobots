{
  "schema": "dreamco.buddy_local_media_engines.v2",
  "reviewed_on": "2026-07-31",
  "policy": {
    "default_mode": "local_first",
    "paid_provider_required": false,
    "raw_biometrics_leave_device_by_default": false,
    "commercial_release_requires_full_dependency_license_review": true,
    "real_person_media_requires_active_scoped_consent": true,
    "minor_voice_or_likeness_replication": false,
    "synthetic_media_label_required": true,
    "watermark_or_provenance_manifest_required": true,
    "quality_claims_require_measured_evidence": true,
    "external_services_are_optional_benchmark_targets": true,
    "dreamco_owns_consent_personality_orchestration_and_evaluation": true
  },
  "owned_stack": {
    "identity": "Buddy Media Core",
    "required_external_provider": null,
    "components": [
      "local media intake and SHA-256 references",
      "owner and licensed-performer consent receipts",
      "commercial-use scope and revocation records",
      "personality and performance direction",
      "replaceable render-adapter contract",
      "multi-engine and multi-seed candidate orchestration",
      "weighted voice, image, and video quality scorecards",
      "blind pairwise baseline comparison with statistical evidence",
      "best-candidate selection and regression prevention",
      "provenance and synthetic-media labeling",
      "quality, identity, latency, cost, and safety evaluation",
      "owner review and release evidence"
    ]
  },
  "performance_modes": [
    {
      "id": "spoken_conversation",
      "label": "Natural conversation",
      "targets": ["turn-taking", "clarity", "natural pacing", "breath control"]
    },
    {
      "id": "narration",
      "label": "Narration and biography",
      "targets": ["long-form stability", "pronunciation", "warmth", "chapter continuity"]
    },
    {
      "id": "rap",
      "label": "Rap performance",
      "targets": ["rhythmic timing", "diction", "breath placement", "energy control"]
    },
    {
      "id": "melodic_rap",
      "label": "Melodic rap",
      "targets": ["rhythm-to-pitch transitions", "timing", "vowel continuity", "expressive control"]
    },
    {
      "id": "singing",
      "label": "Singing performance",
      "targets": ["pitch contour", "note transitions", "sustained vowels", "timing", "breath control"]
    },
    {
      "id": "character_acting",
      "label": "Character acting",
      "targets": ["emotion range", "character consistency", "dialogue timing", "safe vocal effort"]
    },
    {
      "id": "commercial_delivery",
      "label": "Commercial delivery",
      "targets": ["claim clarity", "brand tone", "timing", "call-to-action intelligibility"]
    },
    {
      "id": "multilingual_delivery",
      "label": "Multilingual delivery",
      "targets": ["pronunciation", "identity stability", "language-specific rhythm", "review by a fluent speaker"]
    }
  ],
  "performance_fixtures": [
    {
      "id": "speech-clarity",
      "mode": "spoken_conversation",
      "label": "Speech clarity",
      "prompt": "Introduce yourself, describe one goal, and explain why it matters in three clear sentences.",
      "recommended_seconds": 20
    },
    {
      "id": "narration-stability",
      "mode": "narration",
      "label": "Narration stability",
      "prompt": "Read an original paragraph with names, dates, numbers, quiet detail, and one emotional change.",
      "recommended_seconds": 35
    },
    {
      "id": "rap-pocket",
      "mode": "rap",
      "label": "Rap timing and diction",
      "prompt": "Perform eight original bars at a comfortable tempo. Do not use copyrighted lyrics or a protected beat.",
      "recommended_seconds": 30
    },
    {
      "id": "melodic-transition",
      "mode": "melodic_rap",
      "label": "Melodic transition",
      "prompt": "Perform an original four-bar rhythmic phrase and transition into a short original melody.",
      "recommended_seconds": 25
    },
    {
      "id": "singing-range",
      "mode": "singing",
      "label": "Singing range and control",
      "prompt": "Sing an original short melody using comfortable low, middle, and high notes plus one sustained vowel.",
      "recommended_seconds": 30
    },
    {
      "id": "emotion-range",
      "mode": "character_acting",
      "label": "Character emotion range",
      "prompt": "Say the same original line with calm, excitement, concern, and relief while keeping one character identity.",
      "recommended_seconds": 30
    },
    {
      "id": "commercial-read",
      "mode": "commercial_delivery",
      "label": "Commercial timing",
      "prompt": "Read a truthful original fifteen-second product message with a clear benefit and call to action.",
      "recommended_seconds": 15
    },
    {
      "id": "multilingual-review",
      "mode": "multilingual_delivery",
      "label": "Multilingual review",
      "prompt": "Record an approved original sentence in each chosen language and keep a fluent-review transcript.",
      "recommended_seconds": 30
    }
  ],
  "benchmark_targets": [
    {
      "id": "buddy-media-core",
      "label": "Buddy Media Core",
      "kind": "owned_system",
      "execution": "local",
      "required": true,
      "paid": false,
      "raw_media_upload_default": false,
      "purpose": "Measure DreamCo-owned orchestration, rights, personality, provenance, and local render quality."
    },
    {
      "id": "openvoice-reference",
      "label": "OpenVoice V2",
      "kind": "optional_local_reference",
      "execution": "local_adapter_when_installed",
      "required": false,
      "paid": false,
      "raw_media_upload_default": false,
      "purpose": "Compare local voice identity, multilingual delivery, style control, latency, and resource use."
    },
    {
      "id": "chatterbox-reference",
      "label": "Chatterbox",
      "kind": "optional_local_reference",
      "execution": "local_adapter_when_installed",
      "required": false,
      "paid": false,
      "raw_media_upload_default": false,
      "purpose": "Compare local naturalness, expressiveness, multilingual delivery, latency, and watermark evidence."
    },
    {
      "id": "elevenlabs-reference",
      "label": "ElevenLabs",
      "kind": "optional_external_reference",
      "execution": "authenticated_external_adapter_only",
      "required": false,
      "paid": true,
      "raw_media_upload_default": false,
      "purpose": "Compare voice identity, naturalness, expressiveness, stability, similarity, multilingual quality, latency, and cost with exact owner approval."
    }
  ],
