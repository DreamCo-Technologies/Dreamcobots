{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorized tokenizer corpus manifest",
  "type": "object",
  "required": [
    "schema",
    "corpora"
  ],
  "properties": {
    "schema": {
      "const": "dreamco.authorized_tokenizer_corpus_manifest.v1"
    },
    "corpora": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "path",
          "sha256",
          "source_type",
          "rights_verified",
          "model_training_permission",
          "privacy_reviewed",
          "holdout",
          "sensitive",
          "license_evidence_ref"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^data/buddy-authorized-corpora/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_type": {
            "enum": [
              "synthetic",
              "first_party",
              "public_domain",
              "licensed"
            ]
          },
          "rights_verified": {
            "const": true
          },
          "model_training_permission": {
            "const": true
          },
          "privacy_reviewed": {
            "const": true
          },
          "holdout": {
            "const": false
          },
          "sensitive": {
            "const": false
          },
          "license_evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
