{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamco.ai/schemas/training-example-1.0.0.json",
  "title": "DreamCo Training Example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "example_id",
    "module_id",
    "split",
    "prompt",
    "response",
    "rubric",
    "tags",
    "source",
    "authoring",
    "target_scope"
  ],
  "properties": {
    "example_id": {
      "type": "string",
      "minLength": 1
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 20
    },
    "response": {
      "type": "string",
      "minLength": 40
    },
    "rubric": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "source_id",
        "source_version",
        "external_text_included"
      ],
      "properties": {
        "kind": {
          "const": "dreamco_original_authored_draft"
        },
        "source_id": {
          "type": "string"
        },
        "source_version": {
          "type": "string"
        },
        "external_text_included": {
          "const": false
        }
      }
    },
    "authoring": {
      "type": "object",
      "required": [
        "status",
        "owner_claim",
        "training_permission"
      ],
      "properties": {
        "status": {
          "const": "DRAFT_REQUIRES_HUMAN_REVIEW"
        },
        "owner_claim": {
          "const": "PENDING_ASSIGNMENT_REVIEW"
        },
        "training_permission": {
          "const": "NOT_GRANTED"
        }
      }
    },
    "target_scope": {
      "const": "shared_foundation_candidate"
    }
  }
}
