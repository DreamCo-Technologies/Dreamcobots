{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dreamco.buddy.f0_evidence_packet.v1",
  "title": "Buddy F0 Baseline Evidence Packet",
  "description": "Signed evidence packet for F0 Baseline only. F0 = pinned suite run with cost/latency/external-assist logged; artifacts under evidence/frontier/. Does NOT authorize frontier, production_ready, or F1+ claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_id",
    "floor",
    "suite_id",
    "suite_hash",
    "subject",
    "run",
    "metrics",
    "artifacts",
    "provenance",
    "signature",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "dreamco.buddy.f0_evidence_packet.v1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^f0-[a-z0-9][a-z0-9._-]{3,63}$"
    },
    "floor": {
      "const": "F0"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "suite_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lane_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Subset of config/frontier-evidence-suite.json lanes covered by this packet."
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "buddy_native",
            "buddy_student_adapter",
            "teacher_assisted_buddy",
            "catalog_model"
          ]
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Path A/B/C or allowlist ref when applicable"
        },
        "checkpoint_or_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_assist_models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Exact teacher/API model IDs used; empty only if truly unaided."
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "started_at",
        "finished_at",
        "fixture_hash",
        "grader_version",
        "sandbox_image_digest",
        "repetition_index",
        "repetitions_total"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "fixture_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "grader_version": {
          "type": "string"
        },
        "sandbox_image_digest": {
          "type": "string"
        },
        "dependency_lock_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "repetition_index": {
          "type": "integer",
          "minimum": 1
        },
        "repetitions_total": {
          "type": "integer",
          "minimum": 1,
          "description": "frontier-evidence-suite minimum_repetitions is 3 for claimable suites; F0 may log a single pinned run as baseline stub if claim_boundary.f0_pass=false until reps met."
        },
        "task_split": {
          "enum": [
            "training",
            "holdout",
            "mixed_logged"
          ]
        },
        "environment_notes": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass_count",
        "fail_count",
        "timeout_count",
        "refusal_count",
        "latency_ms",
        "cost_usd",
        "external_assistance",
        "safety_passed",
        "regression_passed"
      ],
      "properties": {
        "pass_count": {
          "type": "integer",
          "minimum": 0
        },
        "fail_count": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_count": {
          "type": "integer",
          "minimum": 0
        },
        "refusal_count": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "peak_ram_mb": {
          "type": [
            "number",
            "null"
          ]
        },
        "peak_vram_mb": {
          "type": [
            "number",
            "null"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "external_assistance": {
          "type": "object",
          "required": [
            "assisted",
            "assist_share",
            "labels"
          ],
          "properties": {
            "assisted": {
              "type": "boolean"
            },
            "assist_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Must remain visibly labeled; assisted \u2260 independent mastery."
            }
          }
        },
        "safety_passed": {
          "type": "boolean"
        },
        "regression_passed": {
          "type": "boolean"
        },
        "score_vector": {
          "type": "object",
          "description": "Per-dimension scores from buddy-benchmark-scorecard / eval policy; no single intelligence score.",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "peer_context": {
      "type": "object",
      "description": "F0 logs designated peers for future F1 comparison; F0 does not require beating peers.",
      "properties": {
        "designated_peer_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "peer_runs_present": {
          "type": "boolean",
          "const": false,
          "description": "Must be false for pure F0; peer scorecards belong to F1+."
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "trace_uri",
        "raw_results_uri",
        "methodology_uri"
      ],
      "properties": {
        "trace_uri": {
          "type": "string"
        },
        "raw_results_uri": {
          "type": "string"
        },
        "methodology_uri": {
          "type": "string"
        },
        "logs_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "integrity_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Aligns with config/evidence_provenance_schema.json required_fields.",
      "required": [
        "evidence_id",
        "source_type",
        "source_reference",
        "retrieved_at",
        "content_version",
        "license_or_usage_basis",
        "transformation",
        "evaluator_version",
        "integrity_hash"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "capability_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "type": "string"
        },
        "source_reference": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_version": {
          "type": "string"
        },
        "license_or_usage_basis": {
          "type": "string"
        },
        "transformation": {
          "type": "string"
        },
        "evaluator_version": {
          "type": "string"
        },
        "integrity_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "signed",
        "signed_by",
        "signed_at",
        "method"
      ],
      "properties": {
        "signed": {
          "type": "boolean"
        },
        "signed_by": {
          "type": "string",
          "description": "Agent or human role id, e.g. Grok-Buddy-F0-Scorecard"
        },
        "signed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "method": {
          "enum": [
            "unsigned_draft",
            "agent_attestation",
            "human_countersign",
            "ci_attestation"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "f0_pass",
        "frontier_claim_allowed",
        "production_ready_allowed",
        "live_benchmark_ok_allowed",
        "notes"
      ],
      "properties": {
        "f0_pass": {
          "type": "boolean",
          "description": "True only when required F0 fields complete and artifacts exist under evidence/frontier/."
        },
        "frontier_claim_allowed": {
          "const": false
        },
        "production_ready_allowed": {
          "const": false
        },
        "live_benchmark_ok_allowed": {
          "const": false
        },
        "max_floor_this_packet": {
          "const": "F0"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
