{
  "schema": "dreamco.easy_github.glossary.v1",
  "version": "1.0.0",
  "terms": [
    {"easy": ["project", "home", "code home"], "github": ["repository", "repo"], "plain": "The folder of all your work on GitHub."},
    {"easy": ["save my work", "save"], "github": ["commit"], "plain": "Take a snapshot of the files you changed."},
    {"easy": ["send up", "send my work up", "upload"], "github": ["push"], "plain": "Put that snapshot on GitHub."},
    {"easy": ["get the latest", "download newest"], "github": ["pull", "fetch"], "plain": "Bring GitHub's newest copy to your computer."},
    {"easy": ["ticket", "problem", "thing to fix"], "github": ["issue"], "plain": "A tracked request or bug note."},
    {"easy": ["change request", "review this"], "github": ["pull request", "PR"], "plain": "A proposed update waiting for a yes."},
    {"easy": ["robot check", "team check"], "github": ["GitHub Action", "CI", "workflow"], "plain": "Automatic test that runs after you send work."},
    {"easy": ["copy of the work", "side copy"], "github": ["branch"], "plain": "A named line of work that does not touch main until approved."},
    {"easy": ["main copy", "official copy"], "github": ["main", "default branch"], "plain": "The official line everyone trusts."},
    {"easy": ["approve", "accept the change"], "github": ["merge"], "plain": "Fold the change request into the official copy."},
    {"easy": ["undo"], "github": ["revert"], "plain": "Make a new save that reverses a previous save."},
    {"easy": ["secret key"], "github": ["secret", "token"], "plain": "A password-like value. Never paste it in chat."},
    {"easy": ["website"], "github": ["GitHub Pages"], "plain": "Public pages built from this project."},
    {"easy": ["release", "finished version"], "github": ["release", "tag"], "plain": "A named version you can point people to."}
  ]
}
