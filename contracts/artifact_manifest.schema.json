{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://dreamco.local/contracts/artifact_manifest.schema.json","title":"DreamCo Artifact Manifest","type":"object","additionalProperties":false,"required":["schema_version","job_id","status","artifact_type","sha256","sanitized_text","policy"],"properties":{"schema_version":{"const":"dreamco.artifact_manifest.v1"},"job_id":{"type":"string","minLength":1},"status":{"enum":["ACCEPTED","REJECTED"]},"artifact_type":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sanitized_text":{"type":"string"},"policy":{"type":"object","required":["decision","audit_code","findings"],"properties":{"decision":{"enum":["PASS","BLOCK"]},"audit_code":{"type":"string"},"findings":{"type":"array","items":{"type":"string"}}}}}}