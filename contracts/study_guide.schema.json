{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamco.local/contracts/study_guide.schema.json",
  "title": "DreamCo Original Study Guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guide_id",
    "title",
    "learning_objectives",
    "lesson",
    "practice_lab",
    "assessment",
    "safety_notes"
  ],
  "properties": {
    "guide_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lesson": {
      "type": "string",
      "minLength": 1
    },
    "practice_lab": {
      "type": "string",
      "minLength": 1
    },
    "assessment": {
      "type": "string",
      "minLength": 1
    },
    "safety_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "division_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65
    },
    "onet_task_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_review_status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "rejected"
      ]
    }
  }
}
