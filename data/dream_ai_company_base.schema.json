{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamco.example/schemas/dream-ai-company-base.schema.json",
  "title": "Dream AI Company Record",
  "type": "object",
  "required": ["name", "category", "products", "services", "sources"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "category": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "founded": {"type": ["integer", "null"]},
    "founders": {"type": "array", "items": {"type": "string"}},
    "origin_story": {"type": "string"},
    "current_goals": {"type": "array", "items": {"type": "string"}},
    "products": {"type": "array", "items": {"type": "string"}},
    "services": {"type": "array", "items": {"type": "string"}},
    "programs": {"type": "array", "items": {"type": "string"}},
    "developer_tools": {"type": "array", "items": {"type": "string"}},
    "ai_products": {"type": "array", "items": {"type": "string"}},
    "models": {"type": "array", "items": {"type": "string"}},
    "apis": {"type": "array", "items": {"type": "string"}},
    "cloud_services": {"type": "array", "items": {"type": "string"}},
    "hardware": {"type": "array", "items": {"type": "string"}},
    "tech_stack_evidence": {"type": "array", "items": {"type": "string"}},
    "target_markets": {"type": "array", "items": {"type": "string"}},
    "niche_markets": {"type": "array", "items": {"type": "string"}},
    "business_models": {"type": "array", "items": {"type": "string"}},
    "strengths": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "dreamco_opportunities": {"type": "array", "items": {"type": "string"}},
    "replication_requirements": {"type": "array", "items": {"type": "string"}},
    "replication_difficulty": {"enum": ["unknown", "low", "medium", "high", "impractical"]},
    "bot_blueprints": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "string"}},
    "verified_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
