NODE_ENV=development
PORT=5000
HOST=127.0.0.1
DREAMCO_DISABLE_AUTO_SYNC=1
DREAMCO_ENABLE_LOCAL_TEST_ACCOUNT=1
DREAMCO_LOCAL_TEST_OWNER=irean jordan
DREAMCO_LOCAL_TEST_TIER=elite

# Set this to a real local Postgres database for full database-backed API testing.
# The laptop launcher uses a placeholder when this is missing so frontend and local entitlement checks can boot.
# DATABASE_URL=postgres://dreamco_local:local@127.0.0.1:5432/dreamco_local

# Optional real provider keys for local testing only. Do not commit real secrets.
# The laptop launcher uses an invalid placeholder when OPENAI_API_KEY is missing so the UI can boot.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# OPENAI_API_KEY=
