{
  "entrepreneur_workflow": [
    "capture skill or product idea",
    "validate customer need",
    "find domestic suppliers",
    "prepare RFQ",
    "compare landed cost and evidence",
    "prototype and inspect",
    "form a user-approved business plan",
    "connect SBA/SCORE/DCEO help",
    "find SAM.gov opportunities where applicable",
    "require approval before outreach, contracts, orders, or payments"
  ],
  "government_service_workflow": [
    "understand need and jurisdiction",
    "show official sources",
    "screen without deciding eligibility",
    "prepare document checklist",
    "open official application",
    "user reviews and submits",
    "track deadlines locally",
    "connect job and training options",
    "preserve benefits-transition questions for a qualified counselor"
  ],
  "property_acquisition_workflow": [
    {
      "buddy_can": "save GPS, address, photos, notes, and listing-source evidence",
      "gate": "owner initiates capture",
      "id": "capture",
      "name": "Capture a property seen on route"
    },
    {
      "buddy_can": "query an authorized property provider and compare fields",
      "gate": "licensed data source",
      "id": "listing",
      "name": "Verify listing and seller authority"
    },
    {
      "buddy_can": "calculate owner-supplied ARV, rent, repair allowance, financing, cap rate, cash-on-cash return, and uncertainty",
      "gate": "estimates only",
      "id": "screen",
      "name": "Investor screening"
    },
    {
      "buddy_can": "prepare a photo checklist, flag visible concerns, and request qualified inspector quotes",
      "gate": "not a substitute for a licensed inspection",
      "id": "inspection",
      "name": "Inspection"
    },
    {
      "buddy_can": "assemble comparable-property evidence and request appraiser quotes",
      "gate": "not an appraisal; licensed appraiser signs valuation",
      "id": "appraisal",
      "name": "Appraisal"
    },
    {
      "buddy_can": "build standardized RFQs for repairs, insurance, title, survey, financing, utilities, and property management",
      "gate": "providers return and own quotes",
      "id": "quotes",
      "name": "Price quotes"
    },
    {
      "buddy_can": "prepare a review packet, deadlines, contingencies, and document checklist",
      "gate": "buyer approves; licensed professionals review where required",
      "id": "offer",
      "name": "Offer and diligence"
    },
    {
      "buddy_can": "track approvals and evidence",
      "gate": "never autonomous without explicit transaction approval",
      "id": "close",
      "name": "Contract, payment, and closing"
    }
  ],
