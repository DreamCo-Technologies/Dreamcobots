  "days": [
    {
      "day": 1,
      "week": 1,
      "title": "Hub, cards, licenses",
      "hours": "90 min",
      "study": "Read how a model card is supposed to look. Pin three Apache-2.0 models. Skip anything gated you have not accepted.",
      "href": "${DOCS}/hub/model-cards",
      "evidence": "Three card URLs + license names written down."
    },
    {
      "day": 2,
      "week": 1,
      "title": "LLM Course unit 0\u20131",
      "hours": "2 hr",
      "study": "Official LLM Course intro. pipeline() on a tiny model. No paid provider.",
      "href": "${LEARN}/llm-course",
      "evidence": "One local pipeline call logged (task + model id)."
    },
    {
      "day": 3,
      "week": 1,
      "title": "Tokenizers",
      "hours": "90 min",
      "study": "Encode/decode the same sentence with two tokenizers. Count tokens. That number is the bill later.",
      "href": "${DOCS}/tokenizers",
      "evidence": "Token counts for the same text on two models."
    },
    {
      "day": 4,
      "week": 1,
      "title": "Datasets, licensed only",
      "hours": "90 min",
      "study": "Load one dataset after reading its card. If the license is missing, stop.",
      "href": "${DOCS}/datasets",
      "evidence": "Dataset id + license + split sizes."
    },
    {
      "day": 5,
      "week": 1,
      "title": "Classification and NER",
      "hours": "2 hr",
      "study": "Run text-classification and token-classification pipelines. Note failures, not just demos.",
      "href": "${L}/tasks/text-classification",
      "evidence": "Five labeled examples, including one miss."
    },
    {
      "day": 6,
      "week": 1,
      "title": "QA, summary, translate",
      "hours": "2 hr",
      "study": "Same document through three tasks. Compare hallucination vs extractive span.",
      "href": "${L}/tasks/question-answering",
      "evidence": "One extractive span you can point to in the source."
    },
    {
      "day": 7,
      "week": 1,
      "title": "Week 1 holdout",
      "hours": "60 min",
      "study": "Write a one-page Buddy evidence card: what you can run, what you cannot, licenses.",
      "href": "${DOCS}/evaluate",
      "evidence": "Evidence card with at least one fail."
    },
    {
      "day": 8,
      "week": 2,
      "title": "Trainer fine-tune",
      "hours": "2 hr",
      "study": "Fine-tune a tiny classifier on a licensed toy set. CPU is allowed. GPU is optional.",
      "href": "${DOCS}/transformers/training",
      "evidence": "Train loss + eval metric, not a screenshot of '100%'."
    },
    {
      "day": 9,
      "week": 2,
      "title": "Accelerate",
      "hours": "90 min",
      "study": "Read the launch configs. You do not need eight GPUs to understand one process.",
      "href": "${DOCS}/accelerate",
      "evidence": "A config yaml you could actually run."
    },
    {
      "day": 10,
      "week": 2,
      "title": "LoRA / PEFT",
      "hours": "2 hr",
      "study": "What an adapter file is. Why it is smaller than a full checkpoint. Do not download a 70B.",
      "href": "${DOCS}/peft",
      "evidence": "Adapter vs full-weight size comparison."
    },
    {
      "day": 11,
      "week": 2,
      "title": "QLoRA and 4-bit",
      "hours": "90 min",
      "study": "4-bit load vs GGUF. Pick the path that fits this machine. Missing VRAM is not a fail of the plan.",
      "href": "${DOCS}/transformers/quantization",
      "evidence": "Chosen quant method + why the other one is blocked."
    },
    {
      "day": 12,
      "week": 2,
      "title": "Evaluate for real",
      "hours": "90 min",
      "study": "Accuracy, F1, exact match. Native score separate from Grok-assisted.",
      "href": "${DOCS}/evaluate",
      "evidence": "A metric table with a holdout column."
    },
    {
      "day": 13,
      "week": 2,
      "title": "safetensors and cards",
      "hours": "60 min",
