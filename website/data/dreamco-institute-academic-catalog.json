          "level": 400,
          "practicum": "Defend a system claim against adversarial evidence and document unresolved risks.",
          "outcomes": [
            "Challenge unsupported claims",
            "Run adversarial scenarios",
            "Issue evidence-backed findings"
          ]
        },
        {
          "code": "GOV-490",
          "title": "Capstone Thesis: Verifiable Trust & Governance Architecture",
          "credits": 4,
          "level": 400,
          "practicum": "Defend a governance architecture using provenance records, rights decisions, adversarial testing and independent assurance.",
          "outcomes": [
            "Demonstrate end-to-end evidence lineage",
            "Defend rights and safety decisions",
            "Present unresolved risk and remediation"
          ]
        }
      ]
