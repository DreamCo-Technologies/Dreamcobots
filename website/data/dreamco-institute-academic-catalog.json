        "dreamstreaming"
      ],
      "courses": [
        {
          "code": "GOV-102",
          "title": "Fail-Closed Evidence Gates & Cryptographic Provenance",
          "credits": 3,
          "level": 100,
          "practicum": "Build a fail-closed evidence decision with immutable source hashes and explicit rights status.",
          "outcomes": [
            "Distinguish integrity from authorship",
            "Validate provenance records",
            "Block missing authorization"
          ]
        },
        {
          "code": "GOV-305",
          "title": "Preference Optimization, Alignment & Safety Evaluation",
          "credits": 4,
          "level": 300,
          "practicum": "Evaluate an alignment candidate using permitted preference records and independent safety tests.",
          "outcomes": [
            "Describe preference optimization limits",
            "Protect evaluation holdouts",
            "Analyze safety regressions"
          ]
        },
        {
          "code": "GOV-410",
          "title": "Frontier Claim Trust & Adversarial Red-Team Defense",
