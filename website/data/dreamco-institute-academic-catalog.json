  "colleges": [
    {
      "id": "cognitive",
      "code": "CS",
      "name": "College of Cognitive & Algorithmic Sciences",
      "dean": "Office of the Dean of Cognitive & Algorithmic Sciences",
      "mission": "Computation, data architecture, algorithmic reasoning, language systems and model engineering.",
      "divisions": [
        "commandcore",
        "dreamaiinfra",
        "dreamcodelab",
        "dreamdata",
        "dreamscience",
        "dreamautomation",
        "dreamdecision"
      ],
      "courses": [
        {
          "code": "CS-101",
          "title": "Deterministic Data Contracts & Schema Architecture",
          "credits": 3,
          "level": 100,
          "practicum": "Design and validate a versioned data contract with adversarial fixtures.",
          "outcomes": [
            "Specify deterministic input and output contracts",
            "Validate schema and invariants",
            "Document failure semantics"
          ]
        },
        {
          "code": "CS-204",
          "title": "Custom Vocabulary & Subword Morphology",
          "credits": 4,
          "level": 200,
          "practicum": "Build a tokenizer experiment with vocabulary, coverage and reversibility reports.",
          "outcomes": [
            "Explain tokenization trade-offs",
            "Measure vocabulary coverage",
            "Version tokenizer artifacts"
          ]
        },
        {
          "code": "CS-310",
          "title": "Compact Transformer Systems & Reproducible Training",
          "credits": 4,
          "level": 300,
          "practicum": "Produce a reproducible training manifest for the canonical 45,038,208-parameter architecture.",
          "outcomes": [
            "Inspect model configuration",
            "Preserve tokenizer identity",
            "Evaluate reproducibility evidence"
          ]
        },
        {
          "code": "CS-490",
          "title": "Capstone Thesis: Reproducible Autonomous Intelligence Systems",
          "credits": 4,
          "level": 400,
          "practicum": "Submit a reproducible model-system thesis with versioned configuration, data-rights evidence, independent evaluation and oral defense.",
          "outcomes": [
            "Defend a systems research question",
            "Reproduce an evaluated model artifact",
            "Document limitations and release controls"
          ]
        }
      ]
    },
    {
      "id": "robotics",
      "code": "ROBO",
      "name": "College of Autonomous Robotics & Physical Systems",
      "dean": "Office of the Dean of Autonomous Robotics & Physical Systems",
      "mission": "Physical-world task reasoning, sensing, actuation, fleet operations and edge deployment.",
      "divisions": [
        "dreamagriculture",
        "dreamconstruction",
        "dreammaintenance",
        "dreamproduction",
        "dreamprotection",
        "dreamplanetary",
        "dreammilitary",
        "dreamtransport",
        "dreamfood",
        "dreamrobotics",
        "dreamtravel"
      ],
      "courses": [
        {
          "code": "ROBO-101",
          "title": "Physical & Cognitive Task Decomposition",
          "credits": 3,
          "level": 100,
          "practicum": "Decompose work into human, human-plus-AI, robot and full-AI execution candidates.",
          "outcomes": [
            "Separate physical and cognitive work",
            "Identify authority and safety constraints",
            "Escalate uncertain task assignments"
          ]
        },
        {
          "code": "ROBO-215",
          "title": "Sensor-to-Actuator Telemetry & Fleet Runtime Audits",
          "credits": 4,
          "level": 200,
          "practicum": "Audit a simulated telemetry-to-actuation trace and identify unsafe state transitions.",
          "outcomes": [
            "Trace sensor and actuator state",
            "Define safety bounds",
            "Produce fleet runtime evidence"
          ]
        },
        {
          "code": "ROBO-401",
          "title": "Edge Quantization & Low-Latency Deployment",
          "credits": 4,
          "level": 400,
          "practicum": "Compare an edge deployment candidate against latency, memory and safety budgets.",
          "outcomes": [
            "Measure quantization impact",
            "Set deployment constraints",
            "Demonstrate rollback readiness"
          ]
        },
        {
          "code": "ROBO-490",
          "title": "Capstone Thesis: Safe Autonomous Field Systems",
          "credits": 4,
          "level": 400,
          "practicum": "Defend a field-system design with hardware constraints, actuation safety cases, fault recovery and independent simulation evidence.",
          "outcomes": [
            "Produce a physical-systems safety case",
            "Validate simulation and telemetry evidence",
            "Defend deployment boundaries"
          ]
        }
      ]
    },
    {
      "id": "trust",
      "code": "GOV",
      "name": "College of Systems Security & Trust Governance",
      "dean": "Office of the Dean of Systems Security & Trust Governance",
      "mission": "Evidence integrity, rights governance, alignment, safety engineering and adversarial assurance.",
